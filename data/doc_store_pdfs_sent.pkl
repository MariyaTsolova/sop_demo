23, -0.016455283388495445, 0.0207254309207201, 2.100279633843182e-34, 0.006503426004201174, 0.01598876155912876, 0.003106391057372093, -0.047928258776664734, 0.015088229440152645, -0.004528979305177927, -0.01172413770109415, -0.00023494279594160616, 0.0020943433046340942, 0.0010695308446884155, -0.013490824960172176], "sparse_embedding": null}, {"id": "c6ffba4ba01b6d6951f488c6ce9866d97c987c7023b639b69caae6cc517c6214", "content": "This chunk is part of the \"Enabling Environments\" section within the AET Post-16 Standards Framework. It discusses the implementation of buddy systems and peer mentoring schemes designed to promote social inclusion and support for both autistic and non-autistic learners, highlighting the focus on collaborative learning environments.For example, we set up buddy systems and peer mentoring schemes, with both autistic and non-autistic peers. ROOM FOR IMPROVEMENT\nDEVELOPING WE DO THIS REALLY WELL\fPost-16 Standards Framework\n34 Enabling environments\nWhat has been the impact of implementing this standard?\nOn autistic learners:\nOn parents/carers:\nOn staff:\nHow do we document evidence of working on this standard? We document evidence of working on this standard through assessment results, the production of resources, case studies, learner profiles, and the goals we co-\ncreate with autistic learners and parents/carers (where appropriate/possible), and by documenting our reasonable adjustments and the impact of those.\nEvidence to show how we meet this standard:\fPost-16 Standards Framework\n35 Enabling environments\nWe pay attention to the mental and emotional wellbeing of autistic learners and involve autistic learners in communicating how they view their ideal learning environment. ", "dataframe": null, "blob": null, "meta": {"file_path": "Post-16-Standards-Framework_T-HUB-Sc-Mt (1).pdf", "url": "https://drive.google.com/file/d/1J2sZ87itIDhKcF_wmZN2TcBeZRLjlMJP", "source_id": "8c4c774884107306cf77966fe0ff24690d0139f6223da0babe2c1bcd4b2a95b5", "page_number": 34, "split_id": 70, "split_idx_start": 43482, "_split_overlap": [{"doc_id": "c28173bbf151543337141dd311af568cce0f6b542b61bca54c27eaba03388691", "range": [802, 910]}, {"doc_id": "cac0fc3d25aee9dc3a69c2bd312faefefc4dc383f3b2c2e780b535a0c49e0574", "range": [0, 268]}]}, "score": null, "embedding": [0.04495855048298836, -0.09082725644111633, -0.01652641035616398, 0.013874935917556286, -0.009387640282511711, 0.028661007061600685, 0.057816293090581894, -0.025435123592615128, -0.04847400262951851, 0.005276362877339125, 0.02201145701110363, -0.052703797817230225, 0.021600032225251198, 0.01961718499660492, 0.015191873535513878, -0.06724251806735992, 0.049790091812610626, 0.036143865436315536, -0.03047175705432892, -0.000564378744456917, 0.009563405066728592, 0.02720155566930771, -0.02689187414944172, 0.03670584037899971, 0.025506649166345596, -0.02683049626648426, 0.012092881835997105, 0.025144848972558975, -0.002498761983588338, -0.032230786979198456, 0.021295789629220963, -0.012577610090374947, 0.0014114390360191464, 0.004333125427365303, 2.2960416572459508e-06, 0.01922275312244892, -0.0006217484478838742, -0.006555323023349047, -0.01533966138958931, -0.007039356045424938, -0.07097458839416504, 0.05577573552727699, 0.033991727977991104, 0.062469180673360825, -0.015085354447364807, -0.04836263135075569, -0.001742684282362461, 0.00736379437148571, -0.009440095163881779, -0.016911935061216354, -0.0016502337530255318, 0.05180225893855095, -0.0011988956248387694, -0.04226421192288399, -0.024056142196059227, -0.014908121898770332, -0.0023577907122671604, -0.06964094936847687, 0.059704750776290894, 0.042450740933418274, -0.002263415837660432, 0.024945689365267754, 0.005636179819703102, -0.03690900281071663, 0.0704316571354866, -0.023711038753390312, 0.01907685026526451, -0.061956603080034256, 0.028555365279316902, -0.005535246804356575, 0.1442611813545227, 0.036751676350831985, 0.00835080910474062, 0.04946442320942879, -0.0008618042338639498, 0.063553035259246