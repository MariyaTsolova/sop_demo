ough. ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 46, "split_id": 197, "split_idx_start": 101932, "_split_overlap": [{"doc_id": "e1e63b1357a157600f05322adc5544dd86365ca55ab8beec795f6214612b73be", "range": [486, 620]}, {"doc_id": "5be416db37f8e6070f9e187f23cfb761a6bc74f4f4887c3dbb8201479e02da9f", "range": [0, 65]}]}, "score": null, "embedding": [0.045168958604335785, -0.057597607374191284, -0.027785498648881912, 0.0013974413741379976, -0.03199704363942146, 0.008804847486317158, 0.03395834565162659, -0.042606599628925323, -0.05031196027994156, -0.020092088729143143, 0.041351716965436935, -0.05824826657772064, 0.05195915326476097, 0.025988861918449402, -0.004954331088811159, -0.051962751895189285, 0.023206157609820366, 0.0046728309243917465, -0.08782870322465897, 0.005513331387192011, -0.02610226348042488, 0.03793981671333313, -0.04047572985291481, 0.03862577676773071, 0.04747329652309418, -0.018978221341967583, 0.0043424884788692, 0.03649786114692688, 0.0007079946808516979, -0.043174657970666885, 0.04527050629258156, -0.006884768605232239, -0.01949467882514, -0.030524585396051407, 2.3695145046076505e-06, 0.025333942845463753, 0.012450136244297028, -0.009651916101574898, -0.035021353513002396, 0.027932515367865562, -0.07390040159225464, 0.009105454199016094, -0.0007147486321628094, 0.05236776918172836, -0.008400502614676952, -0.055531095713377, 0.01586911641061306, 0.024666383862495422, -0.01051069051027298, -0.009961020201444626, -0.01343623735010624, 0.006124134175479412, -0.002459021285176277, -0.0437178835272789, 0.020206192508339882, -0.0472877062857151, 0.006185577716678381, -0.06972717493772507, 0.06601779162883759, -0.01231277547776699, -0.03496316447854042, 0.022819504141807556, -0.01692480407655239, -0.05284038186073303, 0.013423695228993893,