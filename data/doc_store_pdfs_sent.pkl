s really well: This standard is well developed. ", "dataframe": null, "blob": null, "meta": {"file_path": "Post-16-Standards-Framework_T-HUB-Sc-Mt (1).pdf", "url": "https://drive.google.com/file/d/1J2sZ87itIDhKcF_wmZN2TcBeZRLjlMJP", "source_id": "8c4c774884107306cf77966fe0ff24690d0139f6223da0babe2c1bcd4b2a95b5", "page_number": 7, "split_id": 13, "split_idx_start": 8776, "_split_overlap": [{"doc_id": "f356289bfb3c16207406feae54c05d03df558ac0177374b3e48e87b5aafce5b9", "range": [519, 594]}, {"doc_id": "271ee6bb9bec082c1bb4a1a09c35d57688d4b0a23a0e1c45db16d871b127b8b8", "range": [0, 57]}]}, "score": null, "embedding": [0.0027797152288258076, -0.07774749398231506, -0.007312193978577852, 0.0003916922432836145, -0.014196355827152729, -0.0032943023834377527, 0.017757853493094444, -0.02380000613629818, -0.04227037355303764, -0.021688630804419518, 0.031737908720970154, -0.06565327942371368, 0.016907159239053726, 0.031003031879663467, 0.0032466414850205183, -0.04939807206392288, 0.03780875727534294, 0.010515809990465641, -0.06496106833219528, 0.01582856848835945, 0.04047277569770813, 0.004245920572429895, -0.017453061416745186, 0.04113112762570381, 0.0018861677963286638, 0.01419705431908369, -0.01415210496634245, 0.011640552431344986, 0.009033417329192162, -0.0640137568116188, 0.021456671878695488, 0.015353238210082054, 0.01762721687555313, 0.006931763142347336, 2.0635209239117103e-06, 0.01179527211934328, -0.003632207168266177, 0.012104295194149017, 0.016967324540019035, -0.009129871614277363, -0.030659256502985954, 0.018955374136567116, 0.027323076501488686, 0.06005687639117241, -0.009469879791140556, -0.05541480705142021, 0.0281272754073143, 0.03756478801369667, 0.031241893768310547, -0.009349062107503414, -0.006012423895299435, -0.01843554526567459, 0.0489712730050087, -0.03978283330798149, -0.03695164620876312, -0.00891271885484457, -0.00031648701406084, -0.04239523038268089, 0.05013586953282356, 0.04044032841920853, -0.01021343469619751, 0.04141954705119133, 0.02796679735