4867057800293, -0.016408948227763176, 0.005516011733561754, -0.03122854419052601, -0.01899551972746849, 0.06633003801107407, -0.011486722156405449, -0.02308030240237713, -0.07130240648984909, 0.09463860839605331, 0.00971013680100441, -0.004018120467662811, 0.0006040993030183017, -0.06860823929309845, 0.04605349898338318, -0.015351700596511364, 0.0533510260283947, 0.062008991837501526, -0.04973243176937103, -0.02511296607553959, 0.009605836123228073, 0.04527324438095093, 0.020181110128760338, 0.0010843215277418494, 0.01185387372970581, -0.04720960929989815, -0.004297744482755661, -0.02049875445663929, 0.05634688958525658, -0.033226512372493744, -0.01772899553179741, -0.01304203923791647, -2.406807107036002e-05, -0.004851233214139938, -0.03181128576397896, -0.01843162067234516, 0.000911436858586967, 2.1590178467745737e-34, 0.010480768047273159, 0.015135162509977818, 0.006367241032421589, -0.06425697356462479, 0.02334136888384819, -0.009900025092065334, 0.013787810690701008, -7.793271652190015e-05, 0.03855043649673462, -0.0006610791315324605, -0.01360263954848051], "sparse_embedding": null}, {"id": "74410f067b0891281afd81247268782ab270f2f1cfe3ef4b9cd132ca8868e80f", "content": "This chunk is part of the case study highlighting the vocational pathways available for students at Springfields School. It discusses the Phoenix Project SEARCH internship, which aims to provide immersive workplace experiences for autistic young people, enhancing their career skills and facilitating their transition to full-time employment after school.The aim of the supported internship is to get 8 to 12 young people fully immersed in the workplace, with the aim of full-time paid employment at the end of their 12-month programme. Career exploration and job skills acquisition occurs within 3 internship rotations, followed by personalised job-\nsearch assistance into employment and ongoing in-work support, as needed.\fGood Autism Practice Guide \u2013 Case Studies\n48 Doc ref: GAP report - case studies_I-S\nUnderstanding the individual with autism\nP1 \u2013 Understanding the strengths, interests and challenges of the autistic child and young person\nThe school carries out systematic Instruction which involves breaking tasks down into very small steps. Staff have become experts in breaking tasks down into steps that the pupils can manage.\nThe school uses the Zones of Regulation approach developed by Leah Kuypers (2011). ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 47, "split_id": 203, "split_idx_start": 105094, "_split_overlap": [{"doc_id": "dffe1d4197677eed92165f00b5e40e6d7c8f672dd8272244f5cc315aecc33ecf", "range": [789, 971]}, {"doc_id": "4bd901e256ed30d36aacee5053ee7f0f9151b80be0c37b1202283c7de64ca25f", "range": [0, 83]}]}, "score": null, "embedding": [0.028379617258906364, -0.05050482228398323, -0.025052901357412338, -0.04973727837204933, 0.0011100206756964326, 0.022691287100315094, 0.030042698606848717, -0.035637736320495605, -0.016792194917798042, 0.015176011249423027, 0.052114252001047134, -0.0014005368575453758, -0.0027823050040751696, 0.0014269696548581123, -0.015305237844586372, -0.039517197757959366, 0.021620916202664375, 0.00833194237202406, -0.08584020286798477, 0.011244482360780239, -0.029277779161930084, 0.024831466376781464, -0.013122922740876675, 0.06162425875663757, -0.006000669207423925, -0.05066893994808197, 0.04606098681688309, 0.012090221047401428, 0.04439500346779823, -0.005799467209726572, 0.0342971570789814, -0.0358092300593853, 0.006236008368432522, 0.016031809151172638, 2.4512939944543177e-06, 0.06611736863851547, 0.008897006511688232, -0.011285773478448391, -0.026334764435887337, -0.045635659247636795, -0.068905770778656, 0.008737170137465, 0.019295979291200638, 0.08181903511285782, -0.018015580251812935, -0.01811