04, -0.011572964489459991, -8.67616618052125e-05, 0.022357024252414703, -0.0085394736379385, -0.023084620013833046, 0.023576123639941216, 0.004291677847504616, -0.05491611734032631, 0.0380169041454792, 0.019106509163975716, 0.025252938270568848, 0.011663434095680714, -0.042020171880722046, 0.0032761895563453436, -0.020841382443904877, -0.020291876047849655, 0.0361449159681797, -0.06826275587081909, 0.014760186895728111, -0.07537204772233963, 0.08584506064653397, 0.0073277512565255165, 0.024585185572504997, -0.01937161572277546, -0.014690158888697624, 0.012541851960122585, -0.015237098559737206, 0.010064140893518925, 0.02103997766971588, -0.022891199216246605, -0.05383456498384476, 0.04481087252497673, 0.014109811745584011, 0.04398222267627716, 0.040463637560606, -0.01864943467080593, -0.014624192379415035, 0.004352936986833811, -0.02412578836083412, 0.07020039856433868, -0.019433917477726936, -0.013744165189564228, -0.019498487934470177, 0.0159786194562912, -0.0006019336287863553, -0.055439386516809464, -0.014116726815700531, 0.008380933664739132, 1.729363182112008e-34, 0.009841695427894592, -0.016843102872371674, 0.0316140279173851, -0.047366637736558914, 0.033393848687410355, 0.017405567690730095, -0.029539640992879868, 0.009715046733617783, -0.004663129337131977, 0.0012680537765845656, -0.014240921474993229], "sparse_embedding": null}, {"id": "293c89069d960cf25f8977db5bdd93461d6e727b213127705ec71d3c653a955f", "content": "This chunk is part of a case study discussing the practices of Autism Education Trust schools, specifically focusing on the professional development of staff through workshops led by speech and language therapists, as well as the structured induction programs for new staff to ensure effective support for autistic students.Good Autism Practice Guide \u2013 Case Studies\n31 Doc ref: GAP report - case studies_I-S\nSpeech and language therapists also deliver parent workshops and staff training. Each therapist is linked to a class and liaises with the teacher, provide group work and give some 1:1 support.\nNew staff have a 2\u20133-month induction programme which they attend on a weekly basis. Part of a sample programme is given.\nEnabling environments\nP5 \u2013 Leadership and management that promotes and embeds good autism practice\nThere is an intensive induction programme in place to bring new staff up to speed with the school\u2019s ways of working. ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 31, "split_id": 127, "split_idx_start": 63654, "_split_overlap": [{"doc_id": "cc0fb6a096eac8bea1ea85d5324b2961cceda5a73bc87a421aeb876919561ba8", "range": [409, 574]}, {"doc_id": "c699cb9b9ee279781064fddd136d78db08f32f42a137ab5a304b44a2d5476a04", "range": [0, 216]}]}, "score": null, "embedding": [0.04644262418150902, -0.08424448221921921, -0.013434701599180698, 0.03076571598649025, 0.006686079781502485, 0.020790068432688713, -0.0028180177323520184, -0.03689489886164665, -0.024190332740545273, 0.012399331666529179, 0.017545927315950394, -0.026348311454057693, 0.03207388147711754, 0.0008063201094046235, -0.000717824324965477, -0.08001989126205444, 0.00676910812035203, 0.030844636261463165, -0.06724147498607635, 0.01681094616651535, 0.03533259779214859, 0.03818158060312271, -0.004950948990881443, 0.017590463161468506, 0.024551354348659515, -0.008961677551269531, -0.0002194838016293943, 0.010974480770528316, 0.04786324501037598, -0.030535729601979256, 0.015852315351366997, -0.007893047295510769, -0.0012066150084137917, 0.006773710250854492, 2.2390693175111664e-06, 0.05704855918884277, 0.031710464507341385, -0.027758857235312462, -0.011390957050025463, -0.016667434945702553, -0.07236877083778381, -0.004668323788791895, 0.014669066295027733, 0.06642968952655792, -0.006035231985151768, -0.013530327938497066, 0