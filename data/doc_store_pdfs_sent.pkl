 null, "meta": {"file_path": "EEF_Social_and_Emotional_Learning.pdf", "url": "https://drive.google.com/file/d/1ux2ZVY-H62jpu0xzPvuWIaW6mMGtPxRN", "source_id": "e8d637c88ad0e99d399f844be26e40bf15211fc84f01bf87ff947205064caf09", "page_number": 14, "split_id": 45, "split_idx_start": 32902, "_split_overlap": [{"doc_id": "7bcb54726987022874e16c5085bb0444f3b30393a1b14520902630494e921a78", "range": [592, 688]}, {"doc_id": "22f04e5030370282a5b48911d6d5a114eaa36803848c4b10346373d5805f8d51", "range": [0, 37]}]}, "score": null, "embedding": [0.04302408918738365, -0.12323404103517532, -0.006488760467618704, 0.005487828049808741, 0.008189426735043526, 0.039841391146183014, 0.0635700598359108, -0.039769526571035385, 0.04762214049696922, 0.005592804402112961, -0.012111905962228775, -0.004439026117324829, 0.018537919968366623, -0.031965065747499466, 0.004810993559658527, -0.110968217253685, -0.006396647542715073, 0.04744231328368187, -0.010951686650514603, 0.017838651314377785, 0.002021890366449952, -0.01215567346662283, -0.038697969168424606, -0.0015103548066690564, -0.03032081574201584, -0.03264753520488739, 0.019728537648916245, 0.025007177144289017, -0.006157152354717255, -0.07398192584514618, 0.040369998663663864, -0.001960203517228365, 0.010330521501600742, -0.08766419440507889, 2.056958692264743e-06, -0.018219204619526863, 0.0013690512860193849, -0.04323418438434601, 0.033999036997556686, 0.02042856253683567, 0.03397112712264061, -0.036423210054636, 0.01840963028371334, 0.033348020166158676, 0.03207888826727867, -0.002471479121595621, 0.027067629620432854, 0.09383021295070648, 0.06129707768559456, 0.0181859340518713, 0.010656296275556087, 0.06242761015892029, -0.031044188886880875, -0.02101374976336956, 0.057053614407777786, 0.002294478239491582, -0.001975082792341709, -0.014957208186388016, 0.056904032826423645, -0.048502106219530106, -0.023517724126577377, -0.006555021274834871, -0.03641057386994362, -0.0442509688436985, -0.012867048382759094, -0.05935503542423248, -0.0026