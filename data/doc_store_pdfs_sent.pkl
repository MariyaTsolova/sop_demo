6647716164589, -0.014351236633956432, -0.00741061195731163, 0.00012996344594284892, -0.0006862825830467045, 0.03866569325327873, 0.01297441404312849, 0.003263727528974414, -0.008832431398332119, -0.029654528945684433, -0.03648153692483902, 0.004855284001678228, 0.04236343130469322, -0.01035249512642622, 0.07659215480089188, 0.027231503278017044, 0.01181001402437687, 0.002718986477702856, -0.010953892022371292, 0.019413914531469345, -0.009660356678068638, 0.04963986575603485, -0.01203500758856535, 0.09228868782520294, 0.00024524712353013456, -0.025407591834664345, -0.02345747873187065, -0.013853393495082855, 0.03284357115626335, 0.019757889211177826, 0.020093422383069992, 0.06946016103029251, -0.04299352690577507, 0.016247505322098732, -0.00306113064289093, 0.031591176986694336, 0.036631420254707336, 0.004837772808969021, -0.016373997554183006, -0.06975124776363373, -0.021537717431783676, -0.010049393400549889, 0.0746595561504364, -0.02002488262951374, -0.0050478847697377205, 0.01911875046789646, -0.01757381297647953, 0.040472809225320816, -0.017187509685754776, -0.0541519857943058, -0.027606897056102753, 2.0528424674802526e-34, -0.015175695531070232, -0.048718295991420746, 0.022210653871297836, -0.051773086190223694, -0.004691579844802618, -0.023386145010590553, 0.038253579288721085, -0.005306714214384556, 0.009978242218494415, 0.03099704533815384, -0.046534519642591476], "sparse_embedding": null}, {"id": "8edcfe0f860b6498597aaf29ebcb6b1c66b34c22f810539beca3ed82d6234429", "content": "This chunk is part of the section discussing the importance of effective implementation of interventions for pupils with Special Educational Needs and Disabilities (SEND). It emphasizes the necessity of proper training and monitoring for staff involved in these interventions, followed by a practical case study from Millfield Secondary School that illustrates successful staff allocation to support students with the greatest learning needs.Once an approach has been identified, it is important to take the time to train the staff involved, monitor the delivery of the approach, and consider how to sustain it over time. More information about effective implementation can be found in the EEF\u2019s guidance report: Putting Evidence To Work: A School\u2019s Guide To Implementation.\f31Special Educational Needs in Mainstream Schools\nMillfield secondary school arrange timetables so that the head of the English department can always work with the groups with the greatest learning needs in English. This means the pupils who need the most support get the most intensive input (as these groups are smaller) from the most senior and experienced member of staff delivering high quality teaching. 39\nBox 10: Case study\u2014how does Millfield Secondary School allocate staff? ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 32, "split_id": 118, "split_idx_start": 74197, "_split_overlap": [{"doc_id": "dcf883d6a2d87a54aa8c3d2b1ea09012dd6ddf7c33586e7ae98e3e668a42ab9b", "range": [332, 512]}, {"doc_id": "7b435d0249c83f469c77f70f984aa2ce92a1c80ec146593a304d5b3519a1e5e1", "range": [0, 74]}]}, "score": null, "embedding": [0.034835781902074814, -0.10282436013221741, -0.010615217499434948, 0.012258362025022507, -0.018475160002708435, 0.039222363382577896, 0.01937825046479702, -0.041479725390672684, -0.007403734605759382, -0.027659283950924873, 0.0884862020611763, 0.016850899904966354, 0.026861252263188362, 0.001224193605594337, 0.020022673532366753, -0.10525447130203247, 0.0037089067045599222, 0.024129346013069153, -0.0784866213798523, 0.023860007524490356, 0.011900190263986588, 0.012576200067996979, -0.033619292080402374, -0.007729098200798035, -0.0034379821736365557, -0.02418430522084236, 0.009391400963068008, 0.03285880759