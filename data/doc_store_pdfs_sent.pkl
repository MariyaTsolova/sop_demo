0.06330675631761551, -0.008173031732439995, 0.017009129747748375, -0.015171089209616184, -0.00954904593527317, 0.013408320024609566, -0.014150246046483517, -0.06922788172960281, 0.06363093852996826, -0.007350658532232046, -0.042443688958883286, 0.006507677026093006, -0.004061553627252579, 0.0321829728782177, -0.03457321971654892, -0.012378735467791557, 0.03511689603328705, -0.006278594955801964, 0.035076871514320374, -0.041859567165374756, -0.0326225683093071, -0.03390016779303551, 1.8993408131846127e-34, -0.008672649972140789, -0.03637676686048508, -0.023150628432631493, -0.049388524144887924, 0.019126521423459053, -0.0185540784150362, 0.007102660369127989, 0.0267005767673254, 0.05176759511232376, 0.020784739404916763, -0.014024008065462112], "sparse_embedding": null}, {"id": "7cc5e37d9da7933092eebd31722cc1c16dba8935fe1cf56010c7b06810d52f61", "content": "This chunk is part of the section discussing strategies to enhance children's social awareness within the context of social and emotional learning (SEL). It illustrates practical activities that help children identify and manage their emotions, emphasizing the importance of understanding perspective and empathy as foundational skills for their emotional development.For example, children might watch a balloon blown up until it bursts, or learn about volcanic eruptions, then discuss how they might notice angry feelings building up inside themselves, and make a class poster of steps they can take to avoid an \u2018anger explosion\u2019.\f13Improving social and emotional learning in primary schools\nC. Strategies to enhance children\u2019s social awareness\nWhat do we mean by social awareness?\nSocial awareness refers to the ability to understand the perspective of others and empathise. In the early years of life, children are naturally more egocentric and more inclined to think about themselves and their own needs. Understanding the perspectives of others and developing a sense of empathy are considered fundamental building blocks for the positive development and mental health of children. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Social_and_Emotional_Learning.pdf", "url": "https://drive.google.com/file/d/1ux2ZVY-H62jpu0xzPvuWIaW6mMGtPxRN", "source_id": "e8d637c88ad0e99d399f844be26e40bf15211fc84f01bf87ff947205064caf09", "page_number": 14, "split_id": 48, "split_idx_start": 34254, "_split_overlap": [{"doc_id": "e12ace194b3a0fe35c78e2ad8100c076ed91d54397ef7f7cbcda92b8b8b39180", "range": [396, 660]}, {"doc_id": "be66728b1408331cd1dc1538c71ed25bdd819136bee47cea56d5887189bc3ea9", "range": [0, 178]}]}, "score": null, "embedding": [0.010793580673635006, -0.061403416097164154, -0.002890057396143675, 0.023598063737154007, 0.023276278749108315, 0.05505439266562462, 0.007551671005785465, -0.046007223427295685, 0.04592618718743324, -0.004686805419623852, -0.00880750734359026, -0.0043729376047849655, -0.027152007445693016, -0.01876307837665081, 0.005573537666350603, -0.09561372548341751, 0.008115491829812527, 0.022572563961148262, 0.025162355974316597, 0.03258372098207474, -0.00455841701477766, -0.0006674781325273216, 0.022151654586195946, -0.030665146186947823, -0.03187907487154007, -0.04686296358704567, -0.007996133528649807, 0.009134645573794842, 0.051462821662425995, -0.04911411553621292, 0.029713405296206474, 0.011345292441546917, 0.012403610162436962, -0.010826985351741314, 2.284995616719243e-06, -0.03128422424197197, -0.003724650014191866, -0.0328364372253418, 0.00371298985555768, 0.008537767454981804, 0.07382898032665253, -0.05928537994623184, 0.043080806732177734, 0.005424434784799814, -0.014118735678493977, -0.011491594836115837, 0.011084938421845436, 0.054634567350149155, 0.028572358191013336, -0.033202216029167175, 0.012212288565933704, 0.012952557764947414, -0.07769540697336197, -0.029758404940366745, 0.05469081550836563, 0.011327539570629597, 0.018522171303629875, 0.009162336587905884, 0.014199408702552319, -0.034821972250938416, -0.04223126173019409, 0.027