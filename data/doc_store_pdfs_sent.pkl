076867104, 0.0013504067901521921, 0.041699912399053574, -0.02455938793718815, 0.03183132782578468, -0.039733901619911194, 0.0057383649982512, 0.04530138149857521, -0.06011151522397995, 0.022482585161924362, -0.013186498545110226, 0.07599923759698868, -0.03279715031385422, -0.05743468552827835, 0.014734739437699318, -0.06819874793291092, 0.053074728697538376, 0.0382743701338768, 0.05792098864912987, 0.010514428839087486, -0.027393443509936333, -0.002482303185388446, 0.004601455759257078, 0.04773615673184395, 0.02752671204507351, -0.03459480404853821, 0.00048232165863737464, -0.06170232966542244, 0.04026852920651436, -0.05099200829863548, 0.04192464426159859, -0.03742842748761177, -0.011836416088044643, 0.01302275899797678, 0.017838040366768837, 0.027363816276192665, -0.03130633756518364, -0.034303780645132065, 0.02156137488782406, 2.3162411345520163e-34, 0.006510467268526554, -0.004576780367642641, 0.006826419848948717, -0.08820348232984543, 0.023246390745043755, 0.004392716567963362, -0.04826341196894646, -0.006963044870644808, -0.00519091309979558, -0.03032851032912731, -0.0007755488622933626], "sparse_embedding": null}, {"id": "50fd669d2669dc7776001d9078376019e5f93753d1e6ec55284961e46ced48ae", "content": "This chunk discusses how schools can document their adherence to Standard Eleven of Principle Six in the AET Schools Standards Framework, which focuses on creating a calm, inclusive learning environment for autistic pupils. It emphasizes the importance of collaborating with parents, carers, and the students themselves to assess and enhance their wellbeing and sense of belonging.We document evidence of working on this standard through case studies, one page profiles, and the goals we co-produce with parents/carers and children (where possible), and by documenting our reasonable adjustments and the impact of those.\nEvidence to show how we meet this standard:\nWhat has been the impact of implementing this standard?\nOn staff:\nOn parents/carers:\nOn autistic pupils:\fSchools Standards Framework36 Enabling Environments\nPrinciple Six: An ethos and environment that fosters social inclusion for autistic pupils.\nStandard Eleven: Our enabling approaches foster a calm low-arousal learning environment and we promote a sense of wellbeing, security, and belonging for all our pupils.\nROOM FOR IMPROVEMENT\nDEVELOPING WE DO THIS REALLY WELL\nExamples of how we can do this:\nWe identify, monitor, build, and maintain the mental and emotional wellbeing of autistic pupils and involve pupils in communicating how they view their ideal school.\n", "dataframe": null, "blob": null, "meta": {"file_path": "aet-schools-standards-framework.pdf", "url": "https://drive.google.com/file/d/166LzAs4UUYY2nmfvEFE7NUcJyEIfBoc3", "source_id": "fd3b04f3804d8efbea64fc291fd78f2aefe37cddffb9972efcc9615a49cfdf8c", "page_number": 35, "split_id": 71, "split_idx_start": 38519, "_split_overlap": [{"doc_id": "59eb7eb53d5596b5fa1cfaf3bcf0ea6b2c8e293ddafcc822cda07b2a25de1cac", "range": [845, 1085]}, {"doc_id": "195e92acd55df8fd75763eb75d27ce4305f96eeaefb1fa411796b6096ffa9aac", "range": [0, 253]}]}, "score": null, "embedding": [0.009603154845535755, -0.07905226200819016, -0.015075373463332653, 0.008674561977386475, 0.016173815354704857, -0.005670960061252117, 0.017685245722532272, -0.05288388580083847, -0.0343811921775341, 0.002452253829687834, 0.03431146591901779, -0.048055488616228104, 0.02433367259800434, 0.00190119375474751, -0.00776993902400136, -0.05831850692629814, 0.012237375602126122, 0.04060620069503784, -0.049658991396427155, 0.023850854486227036, -0.000433634064393118, 0.02507897838950157, -0.004849035292863846, 0.014451136812567711, 0.0013664655853062868, 0.00021284515969455242, 0.014498235657811165, 0.04040398448705673, 0.049192171543836594, -0.032985132187604904, 0.027794143185019493, 0.003314512548968196, 0.003803346073254943, -0.013224909082055092, 2.309352339580073e-06, 0.028436902910470963, 0.015198568813502789, -0.02176244929432869, 0.0132882669568061