3, -0.025373248383402824, 0.0258210226893425, -0.013672842644155025, -0.07073342800140381, -0.003918742761015892, 0.006970042362809181, 0.05376702919602394, 0.036125969141721725, -0.004543359857052565, 0.001065542222931981, -0.03709885850548744, 0.02011486515402794, -0.040600452572107315, 0.08298435807228088, 0.03190648928284645, -0.018427148461341858, 0.0165652334690094, 0.015651864930987358, -0.005718084052205086, -0.029783125966787338, -0.05118487775325775, 0.02070336416363716, 2.2579643949888186e-34, -0.003250407287850976, -0.006311835255473852, 0.03346986696124077, -0.061710555106401443, 0.010740602388978004, 0.0010176567593589425, 0.013769520446658134, 0.005669462960213423, -0.04473733529448509, -0.002236433094367385, -0.01550874300301075], "sparse_embedding": null}, {"id": "2cf64b6d73ab71ac7ddfb9c73e8eb1ed9a43c4d6ad928bcd182f6f7625289961", "content": "This chunk is part of the section discussing how to document evidence and ensure effective practice in supporting autistic learners, particularly under the theme of \"Positive and effective relationships.\" It emphasizes the importance of collaboration with external professionals and the systematic collection of evidence to demonstrate how standards are being met in educational settings.We document evidence of working on this standard through assessment results, the production of resources, case studies, learner profiles, and the goals we co-\ncreate with autistic learners and parents/carers (where appropriate/possible), and by documenting our reasonable adjustments and the impact of those.\nEvidence to show how we meet this standard:\fPost-16 Standards Framework\n24 Positive and effective relationships\nWe develop links with professionals across services and contexts according to the needs of autistic learners. This includes occupational therapy, speech and language therapy, Children and Adolescent Mental Health Services (CAMHS) and adult mental health services, for example.\nColleges should ensure they have access to external specialist services and expertise. These can include, for example, educational psychologists, Child and Adolescent Mental Health Services (CAMHS), specialist teachers and support services, supported employment services and therapists. ", "dataframe": null, "blob": null, "meta": {"file_path": "Post-16-Standards-Framework_T-HUB-Sc-Mt (1).pdf", "url": "https://drive.google.com/file/d/1J2sZ87itIDhKcF_wmZN2TcBeZRLjlMJP", "source_id": "8c4c774884107306cf77966fe0ff24690d0139f6223da0babe2c1bcd4b2a95b5", "page_number": 24, "split_id": 54, "split_idx_start": 30899, "_split_overlap": [{"doc_id": "2fe18c1f452d06611b3ec332a23bc7acebdc57ce2280db919d69d47118068d1a", "range": [751, 1060]}, {"doc_id": "358a79ce525bc3604c7210a05c1c3ece36a182c62703af4262edcf8186438bd6", "range": [0, 200]}]}, "score": null, "embedding": [0.03289617598056793, -0.06693121790885925, -0.014735117554664612, -0.004786865320056677, 0.001305422862060368, 0.033967599272727966, 0.03038015216588974, -0.03817809373140335, -0.041677456349134445, -0.0013066247338429093, 0.014857820235192776, -0.06653346866369247, 0.03584564849734306, -0.006501318421214819, -0.0020202468149363995, -0.04586035758256912, 0.018709298223257065, 0.03353980928659439, -0.01611810177564621, 0.016309194266796112, -0.007856154814362526, 0.03495907783508301, -0.04594501480460167, 0.023752547800540924, 0.018215693533420563, -0.021478837355971336, 0.03754844889044762, 0.014584336429834366, 0.009130201302468777, -0.053549762815237045, 0.011015013791620731, -0.00836109183728695, -0.00980012584477663, -0.021043168380856514, 2.4553178263886366e-06, 0.03339647129178047, 0.012069757096469402, -0.013965069316327572, 0.003470839001238346, -0.028719700872898102, -0.07387004792690277, 0.005141034722328186, 0.026083799079060555, 0.0721215009689331, 0.0007110888254828751, -0.021673083305358887, 0.011788721196353436, 0.037058912217617035, -0.01979241706430912, -0.011735135689377785, -0.010572590865194798, 0.040902722626924515, 0.0376988798379