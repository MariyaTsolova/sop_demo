ing": null}, {"id": "1544b30d2fb34b7c148e34b92e2bf90e85fd549166491b474d661e673e86efb3", "content": "This chunk is part of the AET Post-16 Standards Framework, specifically under Principle Eight, which emphasizes adapting the curriculum, teaching, and learning to promote success for autistic learners. It highlights the importance of developing person-centred learner profiles and utilizing assistive technology to foster independence and facilitate personalized learning experiences.C14. I am involved in or contribute to the development and implementation of person-centred learner profiles in partnership with autistic learners, parents/carers, and other staff. These include details of how staff can support the autistic learner. C16. I use assistive technology to enable autistic learners to take control of their learning journey and to gain independence.\f", "dataframe": null, "blob": null, "meta": {"file_path": "Post-16-Standards-Framework_T-HUB-Sc-Mt (1).pdf", "url": "https://drive.google.com/file/d/1J2sZ87itIDhKcF_wmZN2TcBeZRLjlMJP", "source_id": "8c4c774884107306cf77966fe0ff24690d0139f6223da0babe2c1bcd4b2a95b5", "page_number": 12, "split_id": 36, "split_idx_start": 17826, "_split_overlap": [{"doc_id": "0e3ae78767c41770efebe12cadff540534d57afa5a7aec78caea6518b1bd7f02", "range": [355, 360]}, {"doc_id": "89fcd27cd199a66283f03372f6404c3b33d6959ce67e49514ddfa0e3f3ff5ad8", "range": [0, 123]}]}, "score": null, "embedding": [0.03681803122162819, -0.11172391474246979, -0.03746430203318596, -0.008242522366344929, -0.029525484889745712, 0.021100716665387154, 0.05992993339896202, -0.05719594657421112, -0.026654008775949478, -0.0003071750688832253, 0.021828606724739075, -0.07043076306581497, 0.01859906129539013, -0.02042388543486595, 0.02122339978814125, -0.08095671236515045, 0.030744170770049095, 0.03407200425863266, -0.033717911690473557, 0.032486483454704285, 0.013490402139723301, 0.020921725779771805, -0.05592535808682442, 0.03478866070508957, 0.01784057542681694, -0.03214269