 been set up. ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 40, "split_id": 170, "split_idx_start": 87268, "_split_overlap": [{"doc_id": "0c072871daa0c90317e2c5e8db871d071f55ebf014e0ff420de17e530ddccb21", "range": [368, 531]}, {"doc_id": "875451bd6277825d3c734b0cd2616cc056b3e6b5bd71f1117ca999a1f9056f18", "range": [0, 35]}]}, "score": null, "embedding": [0.03034459613263607, -0.07563743740320206, -0.03480023518204689, 0.03788670897483826, 0.023729845881462097, 0.01499678660184145, 0.054860927164554596, -0.055674802511930466, -0.05712404474616051, 0.01259462721645832, 0.0031697379890829325, -0.04493074491620064, 0.02790272980928421, 0.02017059363424778, 0.005351082421839237, -0.06276888400316238, 0.011196497827768326, 0.008961359038949013, -0.016676314175128937, -0.004464676138013601, 0.021226588636636734, 0.02976137399673462, -0.023384708911180496, 0.031173577532172203, 0.06123265624046326, -0.0072359503246843815, 0.019178608432412148, -0.020032264292240143, 0.031792085617780685, -0.011414796113967896, 0.026432842016220093, 0.033297985792160034, -0.025972023606300354, 0.006397836375981569, 2.3822160528652603e-06, 0.04852160066366196, 0.041453804820775986, -0.03582482412457466, -0.022072523832321167, -0.0061917114071547985, -0.062030985951423645, 0.02030651830136776, 0.013590347021818161, 0.06699476391077042, -0.015276818536221981, -0.02117868699133396, 0.027557402849197388, 0.018983982503414154, 0.04175620153546333, -0.036123208701610565, 0.0017338967882096767, 0.044058382511138916, 0.002452605403959751, -0.017728881910443306, 0.031809210777282715, -0.023671839386224747, -0.025953087955713272, -0.05727149173617363, 0.08348510414361954, 0.023971015587449074, -0.012197691015899181, 0.054739899933338165, -0.012599107809364796, -0.05206718668341637, 0.0362