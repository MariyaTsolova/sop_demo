ground includes the word \u2018chase\u2019). ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 28, "split_id": 112, "split_idx_start": 57378, "_split_overlap": [{"doc_id": "95c337e2f5ed4eaf5a5001ec4ed6666d7fdc7544b9c1758c16a5dff0de25086e", "range": [699, 813]}, {"doc_id": "bbd927b6f95d216d3a4093fe4890e2b45f4b62991bd4ce151a18858ecbfca4dd", "range": [0, 56]}]}, "score": null, "embedding": [0.018280690535902977, -0.09581061452627182, -0.02447889745235443, 0.0180378295481205, -0.02288997359573841, 0.0067141554318368435, 0.024094093590974808, -0.059671465307474136, -0.048106104135513306, 0.015206278301775455, 0.029130224138498306, -0.0407106913626194, 0.020809341222047806, 0.027164172381162643, -0.024581534788012505, -0.03966056928038597, 0.02317032404243946, -0.0054373592138290405, -0.03202534466981888, -0.006031479220837355, 0.021902447566390038, 0.026107342913746834, -0.027556002140045166, 0.03920993208885193, -0.006511334329843521, -0.03431262820959091, 0.007524541579186916, -0.01790890283882618, 0.04017344117164612, -0.012521030381321907, 0.0033087206538766623, 0.07301869988441467, 0.005805881693959236, 0.03718922659754753, 2.2587789771932876e-06, 0.020970573648810387, 0.013701830059289932, -0.06587284058332443, -0.030568955466151237, 0.012360422872006893, -0.05284060910344124, 0.04875999316573143, 0.039503175765275955, 0.04585741087794304, -0.04270285367965698, 0.02229996584355831, 0.02605300210416317, 0.01413822267204523, 0.026530766859650612, -0.07641971856355667, 0.003148120827972889, 0.018138699233531952, 0.00363039318472147, -0.02052699588239193, -0.01447339914739132, -0.0366370715200901, 0.00012098074512323365, -0.031032942235469818, 0.0695486068725586, 0.0720072090625763, -0.048583388328552246, 0.044029299169778824, -0.00271879811771214, -0.083109