2344393655657768, -0.056074514985084534, -0.030892029404640198, 0.02789461985230446, 0.04729704558849335, -0.0024330103769898415, 0.045459069311618805, -0.019561970606446266, -0.03927955776453018, -0.001433472498320043, -0.01879126951098442, 0.07351592183113098, 0.03147435933351517, -0.06791053712368011, 0.007023474667221308, -0.002500611823052168, -0.032190073281526566, -0.03569241985678673, 0.023510226979851723, 0.013199103996157646, 2.1973970485627002e-34, 0.03206145763397217, -0.03040485829114914, 0.04031979292631149, -0.08014871180057526, 0.031678467988967896, -0.035294920206069946, -0.06546127796173096, -0.004442596808075905, 0.013107549399137497, -0.022862058132886887, -0.002695760689675808], "sparse_embedding": null}, {"id": "c3af0e2dcd2f0b16a029ab78ea4031c3893119ed9b24d5d5a3bc18aa2f24cdf7", "content": "This chunk is part of Case Study H, which focuses on the early inclusion of a nursery child named John, who is on the autism spectrum. It highlights the gradual transition process implemented by his nursery teacher to promote John's comfort and engagement in the classroom, utilizing strategies like a learning journal and familiarization with classroom equipment.This time was gradually extended and after 11 months, he was able to stay at the nursery without his mother.\nThe nursery teacher worked slowly to increase expectations and remove barriers to John\u2019s learning. Initially, he did not want to wear a waterproof and wellington boots when outside. The teacher sent these home to familiarise him with these and now he will wear them at school for a short period.\nThe nursery teacher uses a learning journal to share information with his mother, as well as a Marvellous Me app ( www.marvellousme.com )\nAs a result of this careful planning and the transition activities, John is starting to initiate activities and take adults to where he wants to go. ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 67, "split_id": 287, "split_idx_start": 148938, "_split_overlap": [{"doc_id": "291bf0f52d2a0500a1c4746e727f5ae522480c0c0dee27bc46749f11e48e8240", "range": [350, 459]}, {"doc_id": "3a2646cd8d542e9d3cd627f18290b4be6c4be3b61156a085596f41d9975bb515", "range": [0, 287]}]}, "score": null, "embedding": [0.017744645476341248, -0.039431486278772354, -0.032264344394207, -0.004134580492973328, -0.009964214637875557, 0.028599394485354424, 0.021612025797367096, -0.06997097283601761, -0.04412847012281418, 0.0022437158040702343, 0.06540537625551224, -0.03316227346658707, 0.06126600503921509, 0.013977077789604664, -0.02716456539928913, -0.06820201128721237, 0.005262277089059353, 0.016891801729798317, -0.07350777089595795, 0.0370471365749836, -0.011655115522444248, 0.02776111476123333, -0.0024972257670015097, 0.009341543540358543, 0.033112458884716034, -0.0315360501408577, 0.0024428965989500284, 0.021161159500479698, 0.014664832502603531, -0.05785267800092697, 0.045829303562641144, 0.030774367973208427, 0.029148373752832413, -0.00580995250493288, 2.5621463919378584e-06, 0.025901665911078453, 0.029273781925439835, -0.030277250334620476, -0.012889144010841846, -0.057191599160432816, -0.02826940268278122, -0.016902988776564598, 0.031126292422413826, 0.045224789530038834, -0.014155157841742039, -0.039221473038196564, 0.008475151844322681, 0.041124410927295685, -0.022530345246195793, -0.010254543274641037, -0.0018133708508685231, 0.012064963579177856, 0.007676452863961458, 0.007794049568474293, 0.07105459272861481, -0.02673390321433544, -0.003908864688128233, -0.04736068844795227, 0.12075448036193848, -0.03552170470356941, -0.047357745468616486, 0.021474750712513924, -0.00020936346845701337, -0.03718498349189758, 0.053213637322187424, -0.017973022535443306, 0.06980730593204498, -0.07060835510492325, 0.005773726385086775, 0.032468788325786