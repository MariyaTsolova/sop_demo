86, -0.03419770672917366, 0.02414882369339466, -0.04756796360015869, 0.10154374688863754, -0.004430925007909536, -0.004924508277326822, -0.005900918506085873, -0.05983740836381912, 0.02881566435098648, 0.008960830979049206, 0.043888311833143234, 0.011068308725953102, -0.031432121992111206, -0.013382603414356709, 0.00711858319118619, 0.03638260439038277, 0.024589186534285545, -0.03788403794169426, -0.0009922175668179989, -0.03747430071234703, 0.016482742503285408, -0.045984018594026566, 0.0613616518676281, -0.04798799008131027, -0.028743447735905647, -0.004718605428934097, 0.01154414750635624, -0.008472965098917484, -0.05038996413350105, -0.008192876353859901, 0.006975771393626928, 1.6164944874745818e-34, 0.0185454823076725, 0.000936209165956825, 0.004413317423313856, -0.08007890731096268, 0.03871718794107437, -0.009926161728799343, -0.028381824493408203, -0.006309100892394781, 0.006431899033486843, -0.01097508892416954, -0.020596209913492203], "sparse_embedding": null}, {"id": "2ee6eabb25980a1ee42f56d9b0c51897cdf93f2b7306ff2057985d0351f55216", "content": "This chunk is situated within the \"Enabling Environments\" section under Principle Five: Leadership and management that promotes and embeds good autism practice. It emphasizes the importance of building effective relationships between staff, autistic pupils, and parents/carers, while highlighting strategies to enhance social inclusion and reduce school exclusions, referencing relevant statutory frameworks.Our staff build effective relationships by actively listening to and observing pupils, and by communicating regularly and positively with parents/carers.\nROOM FOR IMPROVEMENT\nDEVELOPING WE DO THIS REALLY WELL\nSchool systems and structures are proactively adjusted to promote social inclusion and to reduce school exclusions.\nROOM FOR IMPROVEMENT\nDEVELOPING WE DO THIS REALLY WELL\nOur school implements approaches to develop the mutual understanding, communication, and support between autistic pupils, their peers, and staff. For example, we set up buddy systems and peer mentoring schemes. ROOM FOR IMPROVEMENT\nDEVELOPING WE DO THIS REALLY WELL\nLinks to statutory frameworks\nThe All-Party Parliamentary Group on Autism (APPGA, 2017) report highlights that a lack of accountability is an important factor in the rise of school exclusions for autistic pupils.\n", "dataframe": null, "blob": null, "meta": {"file_path": "aet-schools-standards-framework.pdf", "url": "https://drive.google.com/file/d/166LzAs4UUYY2nmfvEFE7NUcJyEIfBoc3", "source_id": "fd3b04f3804d8efbea64fc291fd78f2aefe37cddffb9972efcc9615a49cfdf8c", "page_number": 34, "split_id": 69, "split_idx_start": 37083, "_split_overlap": [{"doc_id": "a171e6f3c5a6a576870e80cd6277abb8eae0eed6a6bc1d19602a58f37b59ae2b", "range": [646, 800]}, {"doc_id": "59eb7eb53d5596b5fa1cfaf3bcf0ea6b2c8e293ddafcc822cda07b2a25de1cac", "range": [0, 268]}]}, "score": null, "embedding": [0.06861494481563568, -0.07968668639659882, -0.018041642382740974, 0.023234540596604347, 0.01905539259314537, 0.0450090728700161, 0.02838323637843132, -0.057445261627435684, -0.04462267458438873, 0.002545342780649662, 0.018285630270838737, -0.05654953792691231, 0.03498537093400955, -0.010784383863210678, 0.026758626103401184, -0.053877927362918854, 0.050847604870796204, 0.0433155857026577, -0.05361458659172058, 0.01818583719432354, -0.01378918718546629, 0.019510162994265556, -0.01204287726432085, 0.026981264352798462, 0.015435842797160149, -0.015577832236886024, 0.01693103462457657, 0.0235199686139822, 0.014195782132446766, -0.026704618707299232, 0.03358267992734909, -0.02384118363261223, -0.019985562190413475, -0.03508453816175461, 2.2898634597368073e-06, 0.01613813452422619, 0.02737824060022831, -0.016463568434119225, 0.006273818202316761, 0.004348380956798792, -0.06030628830194473, -0.0076649910770356655, 0.01929922215640545, 0.07097560167312622, -0.011106223799288273, -0.037401821464300156, 0.000943932041991502, 0.03634729981422424, 0.009421608410775661, -0.0085181