0.02041585184633732, 0.04532218351960182, 0.0030316468328237534, 0.06654546409845352, -1.3853905329597183e-05, -0.0037138916086405516, -0.020073510706424713, 0.01195488404482603, 0.0429144948720932, -0.012954169884324074, 0.04337047040462494, -0.012553034350275993, 0.0971907377243042, 0.018103132024407387, -0.012713834643363953, 0.00710091320797801, -0.018233725801110268, 0.03706156834959984, -0.011027385480701923, 0.03350071236491203, 0.07277733832597733, -0.023602113127708435, 0.004846281837671995, 0.021976081654429436, 0.03861586004495621, 0.02064947597682476, -0.008355747908353806, -0.010242822580039501, -0.06477786600589752, -0.0034006836358457804, -0.02164243347942829, 0.018277382478117943, -0.03440454602241516, -0.04504086822271347, 0.02326773665845394, 0.001164273708127439, 0.03597744554281235, -0.017135750502347946, -0.02811926230788231, -0.03941790387034416, 1.9268887069671253e-34, -0.011492963880300522, -0.008734095841646194, 0.011501551605761051, -0.04569298028945923, 0.004010668024420738, -0.030056685209274292, 0.008105025626718998, 0.011236624792218208, 0.020282136276364326, 0.03880394250154495, -0.034764308482408524], "sparse_embedding": null}, {"id": "54c24f9f782ce22d9dd3bf2bc7b3d2ac1070ea3f6b85cf9c367a934d0a487d58", "content": "This chunk is part of the section discussing effective deployment of teaching assistants (TAs) in supporting students with special educational needs and disabilities (SEND). It highlights a case study from Shirley Manor Primary School, illustrating a successful reform in TA practices that enhances pupil learning and addresses parental concerns regarding support.Box 14 presents a case study describing an alternative approach.\nHeather Lacey, headteacher of Shirley Manor, a single-entry primary school in Bradford, undertook a whole-\nschool project to reform the deployment and practice of teaching assistants. Drawing on the EEF\u2019s Making Best Use of Teaching Assistants Guidance Report, TAs were trained and supported to use techniques to help pupils scaffold their own learning. Teachers were supported to rethink how they deployed TAs in classrooms so that they could spend more time teaching pupils with SEND and getting to know their needs. Moving to the new model of support was a challenge for some parents of children with SEND who were concerned that their child would not receive the individualised support they were used to. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 37, "split_id": 132, "split_idx_start": 83663, "_split_overlap": [{"doc_id": "1cfe234818ce2497a65149ba5911f5ef781a7e9e6b1cb9049784347fa5867f35", "range": [701, 766]}, {"doc_id": "53530e006be6253bda240590f74f5f0555667fb3bf83990b6899f4839d646bbf", "range": [0, 190]}]}, "score": null, "embedding": [0.02491207979619503, -0.10511557012796402, -0.025118762627243996, 0.012545525096356869, -0.0031991570722311735, 0.014098236337304115, 0.027924127876758575, -0.07104528695344925, -0.02642049267888069, -0.0010219990508630872, 0.0697786957025528, 0.0008164035971276462, 0.029346931725740433, -0.020689312368631363, 0.005132655147463083, -0.11864358931779861, -0.01479427795857191, 0.03042660653591156, -0.049567241221666336, 0.03438831865787506, 0.007347781676799059, 0.017036592587828636, -0.003052258398383856, -0.002869244199246168, -0.012262732721865177, -0.034645628184080124, -0.00041162018897011876, 0.00863810908049345, 0.043809324502944946, 0.010024608112871647, 0.032224107533693314, 0.024045823141932487, 0.007003445643931627, -0.021118510514497757, 2.3884192614787025e-06, 0.08249387890100479, 0.01606820896267891, -0.03393355384469032, -0.041167885065078735, 0.007518060505390167, -0.09143101423978806, 0.03675040975213051, 0.02383539080619812, 0.04420077055692673, -0.014013438