e curriculum. ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 52, "split_id": 226, "split_idx_start": 115510, "_split_overlap": [{"doc_id": "87653c5262ed80289a18be80545d5f2b1f1deb9e38cbb4dd790100f496765032", "range": [417, 549]}, {"doc_id": "d8b35d8e21a7367a16b3b9e19505338444fb95aed9e8a1d133dd08006b262cbb", "range": [0, 165]}]}, "score": null, "embedding": [0.024821816012263298, -0.11319472640752792, -0.03962104022502899, 0.02940584160387516, -0.014266464859247208, 0.053553707897663116, 0.024139393121004105, -0.010547928512096405, -0.014008858241140842, -0.002638638485223055, 0.009657023474574089, 0.00987574178725481, 0.02425812929868698, 0.005749640520662069, 0.006280296947807074, -0.08601851761341095, -0.017103472724556923, 0.05071190372109413, -0.06055300682783127, 0.046140771359205246, -0.030389990657567978, 0.019744422286748886, -0.03475666791200638, 0.031509995460510254, 0.04391780495643616, -0.039581503719091415, 0.023321786895394325, -0.01831241138279438, 0.023276418447494507, -0.030344326049089432, 0.0626790001988411, -0.020575614646077156, -0.015288827940821648, -0.08432139456272125, 2.0346208202681737e-06, 0.06912784278392792, -0.018371595069766045, -0.020657168701291084, 0.027138827368617058, 0.016221189871430397, 0.026005208492279053, 0.005979158449918032, 0.006939289625734091, 0.0539274737238884, -0.022239873185753822, 0.013401241973042488, 0.011050322093069553, -0.004516392480581999, -0.05171697214245796, -0.021335994824767113, 0.004202475771307945, -0.023031819611787796, -0.05203310027718544, 0.007546242326498032, 0.01607380248606205, -0.005102562718093395, -0.0007460698834620416, -0.11582019925117493, 0.09012698382139206, 0.009260604158043861, -0.004999238532036543, 0.004133560694754124, 0.013776997104287148, -0.046945538371801376, 0.02