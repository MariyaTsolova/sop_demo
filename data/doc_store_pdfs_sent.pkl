, "sparse_embedding": null}, {"id": "121b52b22d1f081976d4ca491373dbcd0c12bfacfcd51b2005b9fa4efe965d91", "content": "This chunk outlines Principles Three to Seven of the AET Schools Standards, focusing on key areas for enhancing inclusive practices for autistic pupils. These principles emphasize collaboration with parents and professionals, workforce development, leadership quality, social inclusion, and targeted support for measuring progress in educational settings.Principle Three: Collaboration with parents/carers and other professionals and services.\nPrinciple Four: Workforce development related to good autism practice.\nPrinciple Five: Leadership and management that promotes and embeds good autism practice.\nPrinciple Six: An ethos and environment that fosters social inclusion for autistic pupils.\nPrinciple Seven: Targeted support and measuring the progress of autistic pupils.\n", "dataframe": null, "blob": null, "meta": {"file_path": "aet-schools-standards-framework.pdf", "url": "https://drive.google.com/file/d/166LzAs4UUYY2nmfvEFE7NUcJyEIfBoc3", "source_id": "fd3b04f3804d8efbea64fc291fd78f2aefe37cddffb9972efcc9615a49cfdf8c", "page_number": 4, "split_id": 9, "split_idx_start": 4399, "_split_overlap": [{"doc_id": "0eb2158e7dba9ba028ded87f1a0861706b206d86190a102109b7088196b08e3f", "range": [444, 533]}, {"doc_id": "cd2207f1067d211f5a1bdd715bce9a8a47f45a9c60c32e6ca4d79a9284b95226", "range": [0, 81]}]}, "score": null, "embedding": [0.020392442122101784, -0.06787126511335373, -0.02736092358827591, 0.013462882488965988, 0.024782327935099602, 0.011005824431777, -0.006959071382880211, -0.046211883425712585, -0.06800121814012527, 0.010786985047161579, 0.01710793375968933, -0.04032411426305771, 0.02188475988805294, 0.008017455227673054, -0.007957706227898598, -0.024459000676870346, 0.012640075758099556, 0.04442688822746277, -0.040239933878183365, 0.01729375123977661, 0.004041820298880339, 0.030353441834449768, -0.004986318293958902, 0.04105527326464653, 0.03545647859573