ilm set. ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 56, "split_id": 249, "split_idx_start": 124641, "_split_overlap": [{"doc_id": "f456e854979a61611b2e2bd9fcae88bfde86ebab9281c780f93c9210b50c2f84", "range": [580, 678]}, {"doc_id": "04c7f50539769e854e47fd39dabf9b11faed7863eb96a755db7a838f289664f9", "range": [0, 70]}]}, "score": null, "embedding": [0.00031311300699599087, -0.05028282850980759, -0.029372012242674828, -0.00544800003990531, -0.010800117626786232, 0.014721982181072235, 0.031795743852853775, -0.037183038890361786, -0.06263172626495361, 0.03456531837582588, 0.02283511497080326, 0.019911274313926697, 0.01869872771203518, 0.030778175219893456, -0.025075599551200867, -0.019144857302308083, 0.0015441235154867172, 0.011608848348259926, -0.07368998974561691, 0.013856734149158001, -0.0468551367521286, 0.024934330955147743, -0.02740507945418358, 0.05681172385811806, -0.017359251156449318, -0.04986879974603653, 0.01806958205997944, 0.02985973469913006, 0.01017461996525526, -0.01991579681634903, 0.002079854952171445, 0.018921488896012306, -0.006423904560506344, 0.01884494163095951, 2.402598056505667e-06, 0.05427611991763115, 0.03023931384086609, -0.05394820496439934, 0.01926860772073269, -0.017448898404836655, -0.0430300347507, 0.04865894094109535, -0.011919978074729443, 0.05367771536111832, -0.017146490514278412, -0.0005843521212227643, -0.004552570171654224, -0.013404450379312038, 0.001175146782770753, -0.04345262795686722, -0.007098861038684845, -0.01253275666385889, -0.004878512118011713, -0.03603515401482582, 0.018580559641122818, 0.05811162292957306, -0.006472335662692785, -0.048841625452041626, 0.10605645179748535, -0.014450516551733017, -0.018064431846141815, 0.03725123405456543, 0.006715232972055674, -0.04584212228655815, 0.0518816299736499