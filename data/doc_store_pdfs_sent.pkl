dent is studying for GCSEs, they still have the opportunity to follow some of the vocational pathway activities tailored to their interests.\n", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 62, "split_id": 269, "split_idx_start": 138099, "_split_overlap": [{"doc_id": "87a77ebcef8130a93a342e933dc77e42259cf780b0e6bd420054fa6337846832", "range": [540, 674]}, {"doc_id": "bb1869543b5596fcaf0bd30d5235fd5dbb4c7cda688b5cacbfe6fd1154a4ed91", "range": [0, 151]}]}, "score": null, "embedding": [0.000730674946680665, -0.03075064718723297, 0.0021544420160353184, -0.04878142103552818, -0.031484901905059814, 0.024730056524276733, 0.03767622262239456, 9.110519022215158e-05, 0.006530878134071827, 0.0005333096487447619, 0.06795446574687958, 0.037752095609903336, 0.017336005344986916, -0.049575287848711014, -0.019172057509422302, -0.02317565679550171, -0.01661505363881588, -0.0019051411654800177, -0.0701565369963646, 0.002344515174627304, -0.023100510239601135, 0.014166337437927723, -0.03525172919034958, 0.03375336900353432, -0.09282512962818146, -0.07595247030258179, 0.033593229949474335, 0.02502158284187317, 0.03394442796707153, 0.04178724065423012, 0.038469720631837845, 0.01803920604288578, -0.033926695585250854, -0.030962100252509117, 2.046977442660136e-06, 0.037120431661605835, 0.022891685366630554, -0.004161801189184189, -0.024575818330049515, -0.02978089265525341, -0.06967267394065857, 0.0637536495923996, -0.02510901913046837, 0.025497939437627792, 0.010654936544597149, 0.02208050899207592, 0.013131246902048588, -0.04397759959101677, -0.0009933916153386235, -0.023380016908049583, -0.025855841115117073, -0.06644555926322937, -0.08159618824720383, -0.030823903158307076, 0.051380373537540436, 0.03717956691980362, 0.001100052846595645, -0.0590461827814579, 0.01182672753