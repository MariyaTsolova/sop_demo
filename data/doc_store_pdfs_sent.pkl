4606200456619, 0.08766447752714157, -0.010646597482264042, 0.044270288199186325, 0.007005013525485992, -0.04457372426986694, 0.03480657935142517, -0.02096007764339447, 0.05413813143968582, 0.02880849316716194, -0.01763128489255905, -0.017445413395762444, 0.01940677873790264, 0.04657850041985512, 0.009655863046646118, 0.009397412650287151, 0.031687356531620026, -0.03427767753601074, 0.0248715877532959, -0.049508802592754364, 0.02605951391160488, -0.05060134455561638, -0.02570396289229393, -0.00390683813020587, 0.012932767160236835, -0.007699734531342983, 0.0004383519117254764, -0.021978287026286125, 0.0059503791853785515, 1.7212503195870408e-34, 0.030822673812508583, 0.03415888547897339, 0.02677004039287567, -0.06708364933729172, 0.051056869328022, -0.007948747836053371, -0.013907352462410927, -0.0179974976927042, 0.004673096351325512, 0.02287662774324417, -0.015325465239584446], "sparse_embedding": null}, {"id": "5e6553c9f3fca57763bef3f8a95eea9d86a7201db80e8c7f9ae6dcb1ac91b48c", "content": "This chunk is part of Case Study E, which focuses on Priestnall Secondary School's inclusive practices for autistic students. It highlights a discussion with students, particularly Max and a group of girls, reflecting on their positive experiences and strong staff understanding of autism, as well as the school's supportive environment.This is awesome.\u201d\nMax ended the discussion by saying, \u201c I hope this meeting goes well and Priestnall is a really great school and should always be respected and well trusted.\u201d\nMeeting with some of the autistic girls at Priestnall school\nA discussion was held with six girls who attended the school they were in Year 7 (n=3), Year 9 (n=2) and Year 11 (n=1).\nThe girls said that the staff really understand autism at Priestnall School and one girl said that it made her want to take up a career working with children with SEN when she left school. They said staff would set up social groups around a particular interest ( e.g. Lego)\fGood Autism Practice Guide \u2013 Case Studies\n39 Doc ref: GAP report - case studies_I-S\nand that they could go to the library at lunchtime if they wished. Four of the girls felt it was easier to do homework at school as there were fewer distractions. ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 38, "split_id": 160, "split_idx_start": 81292, "_split_overlap": [{"doc_id": "530045639e9b0ff1543b71906184f5d825edf659034b2a8f9d9fd1633b0058d1", "range": [368, 725]}, {"doc_id": "f61b859d27a899e509ed8784a7b56fc965853c27ebb9a36a00331f1bbf1860f3", "range": [0, 96]}]}, "score": null, "embedding": [0.03983951732516289, -0.03657516837120056, -0.021586941555142403, 0.02196693792939186, 0.026287691667675972, 0.04081762954592705, 0.0633397325873375, -0.06564608961343765, -0.052178721874952316, 0.0004660515987779945, 0.02854483760893345, -0.02864636480808258, 0.020009726285934448, -0.0236617811024189, -0.00920545682311058, -0.023667141795158386, 0.0278206467628479, 0.029902908951044083, -0.06656672060489655, -0.005624876357614994, -0.02050570584833622, 0.03104802779853344, -0.0015324020059779286, 0.03176369518041611, 0.0632079690694809, -0.04666750133037567, 0.02475517988204956, 0.016785668209195137, 0.022239651530981064, -0.010112568736076355, 0.05270833894610405, -0.0047650886699557304, -0.028355104848742485, -0.00813381653279066, 2.5094607281062054e-06, 0.030825696885585785, 0.038894928991794586, -0.00893082469701767, -0.02654823660850525, -0.0016131286974996328, -0.09393703937530518, 0.020493946969509125, 0.006370011251419783, 0.04929138347506523, -0.012206681072711945, -0.013620292767882347, 0.011439709924161434, 0.01256838720291853, -0.025438973680138588, -0.04014817997813225, -0.008510853163897991, 0.02365388162434101, -0.028059527277946472, -0.01963978074491024, 0