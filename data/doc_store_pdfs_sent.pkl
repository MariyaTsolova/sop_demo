06029725075, -0.06148350611329079], "sparse_embedding": null}, {"id": "666394dd92d3407b3acd8de25b2a7e68c2a06bafa51b89ed741580e9e4b9ee47", "content": "This chunk is part of the section detailing the graduated approach to supporting pupils with Special Educational Needs and Disability (SEND). It follows an example of Sam, a student receiving targeted reading intervention, highlighting the importance of one-to-one strategies and parental communication during discussions to assess his progress.Sam is now engaged with reading at school and at home but still struggles to comprehend accurately. The school will continue this intervention but also consider some one-to-one comprehension strategies including using visual prompts.\nBox 5: The graduated approach\u2014an example\f17Special Educational Needs in Mainstream Schools\nParents Evening\nShe\u2019s fine with us usually.\nShe seems to be quiet in class with the others. Have you noticed anything? ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 18, "split_id": 62, "split_idx_start": 43093, "_split_overlap": [{"doc_id": "84933817a841a57444419494ea5d7a5489eef4b3a6f4075d42acf4e20a473a2b", "range": [200, 300]}, {"doc_id": "b70f28cd0df4ce424fdf44a9413be4d18675079d5e97cb0179494e832a55f4b7", "range": [0, 27]}]}, "score": null, "embedding": [0.030589429661631584, -0.10451307892799377, -0.013917439617216587, 0.015080160461366177, -0.008444314822554588, 0.04436125606298447, 0.06618224084377289, -0.015290763229131699, -0.01304986048489809, 0.02872980199754238, 0.06445608288049698, -0.03659878298640251, 0.054835349321365356, -0.003887502709403634, -0.03518211841583252, -0.04123816266655922, 0.010662606917321682, 0.02805965766310692, -0.05169212073087692, 0.012439805082976818, -0.0142