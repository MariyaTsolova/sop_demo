, 0.038785696029663086, 0.02015586569905281, -0.002539823530241847, 0.0008507215534336865, -0.050330355763435364, 0.010321508161723614, -0.03663071244955063, 0.016371818259358406, -0.07743851095438004, -0.05106577277183533, 0.02185148186981678, -0.008045107126235962, 0.04306653514504433, 0.007643158547580242, 0.014708061702549458, -0.03592895716428757, 1.8437165123391982e-34, 0.014705159701406956, 0.029683414846658707, 0.01633492298424244, -0.04184982553124428, 0.03728245571255684, -0.013142465613782406, 0.0031797837000340223, -0.00015524638001807034, 0.02262314409017563, 0.042274996638298035, -0.025609176605939865], "sparse_embedding": null}, {"id": "094938df9bdc50766f61d956a28a7200fd84abf7b804643ce1606b4110d1d171", "content": "This chunk appears in the section discussing the importance of inclusive practices in education, specifically highlighting the positive effects of inclusion on all pupils, including those without Special Educational Needs and Disabilities (SEND). It emphasizes the need for thoughtful classroom arrangements, such as seating, to ensure effective teaching for all students, particularly pupils with SEND.One recent meta-\nanalysis explored the impact of inclusion on pupils without SEND and concluded that such an inclusion policy resulted in a weak but positive impact on their academic outcomes. 1\nAt North Ormesby Primary Academy the key focus has been on creating environments that meet the needs of all pupils, but which are likely to be especially important for pupils with SEND. The school has paid careful consideration to seating. Considerations for seating include: \u2022 Make sure the pupil can hear instructions clearly, without interference; \u2022 If hearing is better in one ear than the other, sit them with that ear towards the teacher; \u2022 Ensure pupils can see your face\u2014even when you move position; \u2022 Check pupils have a clear view of the board, worksheets, and visual aids; and \u2022 Ensure lighting is adequate and minimizing glare and reflections.\nBox 3: Seating plans\f12\nEducation Endowment Foundation Include all pupils in the best teaching you can offer\nPupils with SEND can be in a mainstream school but still not be included in high quality teaching (see Box 4). ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 13, "split_id": 42, "split_idx_start": 28072, "_split_overlap": [{"doc_id": "871b81a9589ba60c0ad671c85138d39a3417945d456c537ceea64e22871a0804", "range": [859, 1052]}, {"doc_id": "a83104ee132ac0f3899d24b54c3c8288c2ca8ce75d1650703d450cc11fbfdbfc", "range": [0, 220]}]}, "score": null, "embedding": [0.017281031236052513, -0.097504623234272, -0.022312061861157417, 0.037139151245355606, -0.006254664156585932, 0.03678186610341072, 0.07732506841421127, -0.03478109836578369, -0.004254544619470835, 0.00036659566103480756, 0.043882817029953, -0.04048958048224449, 0.05761668458580971, -0.021905943751335144, 0.022265614941716194, -0.06745844334363937, 0.0282971803098917, 0.009880089201033115, -0.061609167605638504, 0.028372012078762054, -0.05932249873876572, -0.013616259209811687, -0.038928162306547165, -0.011348470114171505, 0.005752088502049446, -0.0413627065718174, -0.005550088826566935, 0.01656518131494522, 0.0029277594294399023, 0.021870199590921402, 0.06154856085777283, 0.02950155735015869, -0.017848854884505272, -0.04469342902302742, 1.916152541525662e-06, 0.03541155904531479, 0.00649961968883872, -0.014494643546640873, 0.0011132564395666122, -0.0028153506573289633, -0.04991073161363602, 0.0053805019706487656, -0.007021800149232149, 0.027770692482590675, 0.0159115232527256, 0.05634903907775879, -0.009156239219009876, -0.030747445300221443, -0.03504304215312004, -0.03779372572898865, -0.0019296047976240516, 0.0070914593525230885,