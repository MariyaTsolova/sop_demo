015258186031132936, 0.03612631931900978, 0.025323711335659027, -0.033388543874025345, 0.03226984664797783, -0.03365837037563324, 0.024802938103675842, -0.02400742471218109, 0.07995343953371048, -0.005011732690036297, -0.04295828565955162, 0.01441588718444109, -0.0033547792118042707, -0.007525170687586069, 0.0034085894003510475, -0.02587158977985382, 0.006691962946206331, 1.997689053141388e-34, 0.014629132114350796, 0.039552491158246994, 0.02353428117930889, -0.09916028380393982, -0.005552442744374275, -0.015783824026584625, -0.024151455610990524, 0.017566535621881485, 0.023358061909675598, -0.00872925017029047, -0.05399476736783981], "sparse_embedding": null}, {"id": "f4f68d8df4379d677aadb6895f99634b1be59ec0785c97cb3cca7882ad691131", "content": "This chunk is part of Case Study G, which discusses Springfields School, a community special school that offers vocational pathways for students with autism and other challenges. It outlines the various pathway choices available to students in Key Stage 4, emphasizing personalized support for transitioning to further education and employment.All pupils make a choice in Year 8 about which pathway they will follow and then spend ten hours a week doing this. The aim of personalised pathways is to provide bespoke support to enable autistic young people to access further education and training beyond school age, ultimately enabling them to transition to life and work as part of their local community. The current pathway choices are:\n\u2022 Engineering and transport\n\u2022 Hospitality and catering\n\u2022 Outside learning\n\u2022 Business and enterprise\n\u2022 Sports and leisure\n\u2022 Hair and beauty.\fGood Autism Practice Guide \u2013 Case Studies\n62 Doc ref: GAP report - case studies_I-S\nHow personalised pathways projects work for Post-16 students at Springfields\nPartnerships were established with local businesses and relevant agencies with the shared aim of improving transition to Further Education or work placements. Parents of those involved were provided with information about the project and confirmed their willingness for their son or daughter to take part.\n", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 61, "split_id": 266, "split_idx_start": 136208, "_split_overlap": [{"doc_id": "c86fd30d72fd2b926c4eaaec00b5b041c4bc4fff3157921d647f0531356b5aec", "range": [518, 634]}, {"doc_id": "e5c542c431395069591b39fc138f8e2b9d8cceaffa9a4eda3997adbf6ade1511", "range": [0, 147]}]}, "score": null, "embedding": [0.01453245896846056, -0.04278586432337761, -0.017573123797774315, -0.028327465057373047, -0.003457712009549141, 0.01250888966023922, 0.04589210823178291, -0.041558876633644104, -0.023912889882922173, 0.006200901698321104, 0.06583397835493088, 0.0037945995572954416, 0.0015419465489685535, 0.0037813899107277393, -0.02177552878856659, -0.027713311836123466, 0.009110747836530209, -0.007633845321834087, -0.08341521769762039, 0.00266722752712667, -0.027461016550660133, 0.03556134179234505, 0.0014081276021897793, 0.05509922653436661, 0.002789438236504793, -0.043100837618112564, 0.037432003766298294, 0.02319152280688286, 0.05863165855407715, -0.03050921857357025, 0.027156170457601547, 0.015702515840530396, -0.021285049617290497, 0.004949423484504223, 2.3894299374660477e-06, 0.04995906725525856, 0.013258861377835274, -0.01052029523998499, -0.05921591445803642, -0.03084801696240902, -0.06765154004096985, 0.0328778475522995, 0.02338227443397045, 0.0715317353606224, -0.0043531483970582485, -0.022780537605285645, 0.01481687743216753, -0.0029956598300486803, -0.004728525411337614, -0.03956367075443268, -0.021379254758358, -0.03230162709951401, -0.02342505007982254, -0.051157400012016296, -0.001890696701593697, -0.025850525125861168, 0.013171630911529064, -0.08958672732114792, 0.04577