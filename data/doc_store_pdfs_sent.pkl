2840042, 0.002204306423664093, 0.054161250591278076, 0.03580499440431595, -0.0734412670135498, -0.09844788163900375, 0.04638240858912468, 0.003000832162797451, -0.002088105073198676, 0.018348433077335358, 0.02994675189256668, 0.02974109724164009, -0.0134364552795887, 0.017651906237006187, -0.023816440254449844, -0.03543931990861893, -0.008270550519227982, 0.007101611699908972, -0.0013355804840102792, -0.0409398227930069, 0.0018298913491889834, 0.013086027465760708, 0.00715841818600893, -0.0011336770839989185, -0.05464375764131546, 0.05818415805697441, -0.002808967139571905, 0.0659276694059372, -0.0383496955037117, -0.00010875875886995345, -0.017668044194579124, -0.028226319700479507, 0.014644126407802105, -0.012234040535986423, 0.008262545801699162, 0.03859046846628189, -0.026279373094439507, -0.016778158023953438, 0.02045123465359211, 0.01701902598142624, -0.004396915435791016, 0.025087589398026466, 0.00026173729565925896, -0.020033448934555054, 0.00254241400398314, 0.009720428846776485, 0.06587217003107071, -0.008952104486525059, -0.028763122856616974, -0.03125052899122238, 0.0201785396784544, 0.015011721290647984, -0.06902216374874115, 0.014383709989488125, -0.028116339817643166, 2.121088868506362e-34, 0.011752895079553127, -0.041231635957956314, 0.022389747202396393, -0.07282616943120956, 0.024891361594200134, 0.026278141885995865, 0.025985412299633026, 0.004333674907684326, 0.0104057090356946, 0.05394643917679787, -0.060638755559921265], "sparse_embedding": null}, {"id": "48d6919610764dc2251e240923aaed9e432d7c76f2475a47988548b7d8bbd3da", "content": "This chunk is located within the section discussing the effectiveness of proactive classroom management strategies, specifically highlighting a study that demonstrates the impact of positive interactions and greetings on student behaviour. It emphasizes the importance of fostering positive relationships with students to enhance their engagement and reduce disruptions in the classroom.Several interventions focusing on positive approaches to behaviour in classrooms promote this idea, but this research was the first experimental study to explore the feasibility and effectiveness of the approach. Over the two-month study, pupils increased their on-task behaviour by an average of 12 minutes per hour (or an hour per day), while pupils in similar comparison classes did not change their behaviour. This study implies that teachers with disruptive classes could benefit from increasing their positive interactions with pupils.\nBox 6: Positive greetings at the door and the 5:1 ratio\f26\nEducation Endowment Foundation Working with parents to gain consistency\nParticularly where behaviour is an issue for a child, involving other stakeholders\u2014in particular their parents\u2014\ncan strengthen the impact of any intervention put in place. The EEF\u2019s guidance report, \u2018Working with parents to support children\u2019s learning\u2019 is a good place to begin for guidance on involving parents in tailored strategies.\n", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Improving_behaviour_in_schools_Report.pdf", "url": "https://drive.google.com/file/d/18VgDE6jXP5eN_4w_IPbsUVu8tW-V4ep2", "source_id": "7a1d3f44ce494b71f1d9e0fe5b7517c578d4c867369077d76a9ccd359cf1603d", "page_number": 27, "split_id": 61, "split_idx_start": 52803, "_split_overlap": [{"doc_id": "b21f7b7a38e6d54cd795985b25e605d7f4cd162a909aa5f64c68a9b19a9d56a0", "range": [678, 891]}, {"doc_id": "7cd2cf03dee5a7e4335e8bd694093388692009911ca7bd9fcde34d7f272f2b18", "range": [0, 164]}]}, "score": null, "embedding": [0.07351177930831909, -0.09883014857769012, -0.014899143949151039, 0.03916678577661514, -0.000927575514651835, 0.050732534378767014, 0.03730170428752899, -0.028696350753307343, -0.033577218651771545, 0.015828801319003105, 0.02114902064204216, -0.03664073720574379, 0.013248251751065254, -0.006500196643173695, 0.014773144386708736, -0.06949106603860855, 0.026241613551974297, 0.024238837882876396, -0.067393705248