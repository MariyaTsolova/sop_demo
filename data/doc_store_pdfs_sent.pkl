1, 0.006704275030642748, -0.0055920700542628765, 0.0927593857049942, -0.02098185569047928, -0.0013419821625575423, 0.007827754132449627, -0.016494499519467354, 0.014805727638304234, 0.0007762467721477151, 0.05935708060860634, 0.07471079379320145, -0.010388031601905823, 0.007931998930871487, 0.02370249293744564, 0.0263059139251709, 0.016982292756438255, -0.008683038875460625, -0.004861265420913696, -0.059085067361593246, 0.008494910784065723, -0.04576673358678818, 0.037897419184446335, -0.020236864686012268, -0.02567359432578087, 0.02748090587556362, -0.009996500797569752, 0.02210271544754505, -0.00242009200155735, -0.0362948440015316, -0.019100645557045937, 2.305470667562607e-34, 0.0017370879650115967, 0.0216116514056921, 0.00700590293854475, -0.08253294974565506, -0.004456541035324335, -0.042700693011283875, 0.014516409486532211, 0.00509059801697731, 0.013707260601222515, 0.018159594386816025, -0.04789576679468155], "sparse_embedding": null}, {"id": "8da06adf7b8fc138c366466f9c958d27209a7fc324fa7e485b21364bb4b69401", "content": "This chunk is from the section discussing the development of recommendations in the guidance report on supporting pupils with Special Educational Needs and Disability (SEND) in mainstream schools. It highlights the importance of utilizing established teaching strategies, such as scaffolding and explicit instruction, to create an inclusive learning environment for all students.To develop the recommendations in this report, we reviewed the best available international research and consulted with teachers and other experts.\nThe overriding message from the report is a positive one. It is tempting to talk about the challenge of SEND as a specific and distinct issue. Yet, far from creating new programmes, the evidence tells us that teachers should instead prioritise familiar but powerful strategies, like scaffolding and explicit instruction, to support their pupils with SEND. This means understanding the needs of individual pupils and weaving specific approaches into everyday, high-\nquality classroom teaching\u2014being inclusive by design not as an afterthought. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 4, "split_id": 5, "split_idx_start": 3288, "_split_overlap": [{"doc_id": "fb62d24703e6e7e0e014ddc8f8eeb699c4aa51f8c4b54aa5d38faf8b9347ee4a", "range": [488, 636]}, {"doc_id": "01573e5cada17a9894236b46aa1788af18580233ef9219f5ac6a4d96d059c3de", "range": [0, 186]}]}, "score": null, "embedding": [0.041485875844955444, -0.14625489711761475, -0.0010493609588593245, -0.01100639346987009, 0.0029226113110780716, 0.04177572578191757, 0.01656467281281948, -0.03298947215080261, -0.03699243813753128, -0.006032098550349474, 0.049082040786743164, -0.014005454257130623, 0.03882520645856857, 0.013898322358727455, 0.02403702400624752, -0.09988894313573837, 0.03980095684528351, 0.02084461972117424, -0.06355643272399902, 0.012099084444344044, -0.04765060544013977, -0.002886090660467744, 0.0010040178894996643, 0.010226787067949772, 0.019580839201807976, -0.059016257524490356, -0.019997546449303627, 0.021033579483628273, -0.000365571555448696, -0.0019526866963133216, 0.06081072986125946, 0.02309291623532772, 5.813764073536731e-05, -0.05597711354494095, 2.3154864265961805e-06, 0.056052666157484055, -0.01036051195114851, -0.01424264907836914, 0.016541393473744392, -0.011029565706849098, -0.04370922967791557, 0.04138876870274544, 0.008414344862103462, 0.05562165379524231, -0.022292908281087875, 0.039827246218919754, -0.005693424958735704, 0.013585207983851433, -0.010866479016840458, -0.04344453662633896, 0.007014100905507803, -0.004625137895345688, -0.026701973751187325, -0.022809771820902824, 0.03440194949507713, 0.006161237135529518, -0.0042297993786633015, -0.05358461663