782754898, -0.006247414276003838, 0.07370630651712418, -0.019351523369550705, 0.0011154242092743516, -0.004777140915393829, -0.041164424270391464, 0.013560733757913113, 0.0018381653353571892, 0.05664907395839691, 0.06926548480987549, 0.001820045174099505, -0.006851431913673878, 0.007434335071593523, 0.053359296172857285, 0.021712711080908775, -0.03304180130362511, 0.01633072830736637, -0.07797574251890182, 0.027347270399332047, -0.031447865068912506, 0.04305664449930191, -0.03590592369437218, -0.038202520459890366, 0.021681027486920357, -0.008616686798632145, 0.033364057540893555, 3.2351967092836276e-05, -0.03753288835287094, -0.03340679034590721, 1.80836478247629e-34, 0.0012601027265191078, 0.023104753345251083, -0.006212417036294937, -0.09264150261878967, -0.008910411037504673, -0.04089725762605667, 0.01902063563466072, 0.005580354947596788, 0.016831958666443825, 0.014328762888908386, -0.0434488020837307], "sparse_embedding": null}, {"id": "97bf4db6bc3578d94c5229db6a786246274a1fdf8d63997477748d2a5cc4f304", "content": "This chunk is part of the recommendation focused on building a holistic understanding of pupils' learning needs, emphasizing the importance of using the graduated approach of 'assess, plan, do, review' for effective assessment and tailored support. It discusses the role of regular assessment, collaboration with parents, and teacher empowerment in enhancing educational practices for pupils with Special Educational Needs and Disabilities (SEND).\u2022 Schools should aim to understand individual pupil\u2019s learning needs using the graduated approach of the \u2018assess, plan, do, review\u2019 approach. \u2022 Assessment should be regular and purposeful rather than a one-off event, and should seek input from parents and carers as well as the pupil themselves and specialist professionals. \u2022 Teachers need to feel empowered and trusted to use the information they collect to make a decision about the next steps for teaching that child. Page 16 Page 12\nBuild an ongoing, holistic understanding of your pupils and their needs Create a positive and supportive environment for all pupils without exception\n21\nSections are colour coded for ease of reference\f9Special Educational Needs in Mainstream Schools\n\u2022 Effective deployment of teaching assistants (TAs) is critical. School leaders should pay careful attention to the roles of TAs and ensure they have a positive impact on pupils with SEND.\n", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 10, "split_id": 30, "split_idx_start": 20233, "_split_overlap": [{"doc_id": "fc95460340cac9beaa61946b067bd06cc70e6cca85f0068ee25556f368380768", "range": [920, 1062]}, {"doc_id": "7ce7b02f52135d5e3a24f5ccf0223b59cba5e0110ae75f4004eb528543e184c0", "range": [0, 124]}]}, "score": null, "embedding": [0.003196259029209614, -0.11114036291837692, -0.02256547287106514, 0.003242186037823558, -0.009027077816426754, 0.012392844073474407, 0.005193027202039957, -0.06932342052459717, 0.006180379539728165, 0.0026938815135508776, 0.026121068745851517, -0.03958042338490486, 0.036814793944358826, -0.00781693123281002, -0.012894950807094574, -0.1070631891489029, -0.001605816651135683, 0.013660944998264313, -0.06237798184156418, 0.031662508845329285, -0.012560179457068443, 0.008784545585513115, -0.014578448608517647, -0.012141802348196507, -0.009201401844620705, -0.03867362067103386, 0.00270475703291595, 0.01735343411564827, 0.05410119518637657, 0.002814111765474081, 0.026858560740947723, 0.05477204546332359, -0.005998064763844013, -0.004858098924160004, 2.4947255496954313e-06, 0.05149887502193451, -0.0015635062009096146, -0.044318947941064835, -0.01459053996950388, -0.0020424332469701767, -0.07306544482707977, -0.015314544551074505, 0.049646358