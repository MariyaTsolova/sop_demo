0.035050053149461746, 0.003723818575963378, 0.046025440096855164, -0.01903633214533329, -0.08784817904233932, 0.010674809105694294, 0.022242413833737373, 0.030621785670518875, 0.020883461460471153, -0.012753233313560486, 0.006287955678999424, -0.03491755574941635, 0.0086445277556777, -0.03812190145254135, 0.09545320272445679, -0.0011863569961860776, -0.013530854135751724, 0.0055728754960000515, 0.01429098192602396, -0.013112991116940975, -0.041887108236551285, -0.08199983090162277, 0.009308423846960068, 2.0521002070825556e-34, 0.013569467701017857, -0.030384300276637077, 0.047531608492136, -0.0729544535279274, 0.013942181132733822, 0.0074622915126383305, 0.0075304582715034485, -0.0022921233903616667, -0.030816594138741493, -0.03420360013842583, -0.030641281977295876], "sparse_embedding": null}, {"id": "db6cd478a9a3277c73401ebdfca0cb3edafde27d0c6a8adbfdd0dfb81996703f", "content": "This chunk is situated within the \"Learning and Development\" section of the AET Post-16 Standards Framework, specifically addressing how institutions document their adherence to educational standards for autistic learners. It highlights the methods used to track progress and co-create educational resources in alignment with providing a meaningful and relevant curriculum that meets learners' diverse needs.We document evidence of working on this standard through assessment results, the production of resources, case studies, learner profiles, and the goals we co-\ncreate with autistic learners and parents/carers (where appropriate/possible), and by documenting our reasonable adjustments and the impact of those.\nEvidence to show how we meet this standard:\fPost-16 Standards Framework\n42 Learning and development\nWe provide a meaningful and relevant curriculum/study programme that addresses the aspirations of autistic young people and accounts for different styles of learning and \u2018spiky\u2019 profiles of ability. This encompasses aspects of their social and emotional wellbeing. All learners aged 16 to 19 (and, where they will have an EHC plan, up to the age of 25) should follow a coherent study programme which provides stretch and progression and enables them to achieve the best possible outcomes in adult life. Schools and colleges are expected to design study programmes which enable learners to progress to a higher level of study than their prior attainment, take rigorous, substantial qualifications, study English and maths, participate in meaningful work experience and non-qualification activity (SEND Code of Practice, 2015:130).\n", "dataframe": null, "blob": null, "meta": {"file_path": "Post-16-Standards-Framework_T-HUB-Sc-Mt (1).pdf", "url": "https://drive.google.com/file/d/1J2sZ87itIDhKcF_wmZN2TcBeZRLjlMJP", "source_id": "8c4c774884107306cf77966fe0ff24690d0139f6223da0babe2c1bcd4b2a95b5", "page_number": 42, "split_id": 82, "split_idx_start": 51305, "_split_overlap": [{"doc_id": "c38c1ed972bd748edfa17b56dc7c601332f09a37f0a93e4ab9772d8a7aec5f44", "range": [423, 732]}, {"doc_id": "c68fc0695c8bb9bc8927c08fc948ab79030a42d71076d6f5402837676a42c3e2", "range": [0, 327]}]}, "score": null, "embedding": [0.01385529711842537, -0.10219989717006683, -0.009255209937691689, -0.0028499052859842777, 0.011183515191078186, 0.05235961079597473, 0.033405277878046036, -0.03113594278693199, -0.01831468753516674, 0.007107466924935579, 0.06243348866701126, -0.056735146790742874, 0.0009435011888854206, -0.00030873887590132654, -0.0026757020968943834, -0.03519555553793907, 0.03240823745727539, 0.018308520317077637, -0.03413161635398865, 0.014223537407815456, -0.02377813123166561, 0.0070147402584552765, -0.040586892515420914, 0.038739435374736786, 0.02410772070288658, -0.028151636943221092, 0.022027233615517616, 0.014290056191384792, 0.015771409496665, -0.036199018359184265, 0.02534651756286621, 0.008148182183504105, -0.0122984629124403, -0.026018278673291206, 2.240741878267727e-06, -0.00555154774338007, 0.005738516803830862, -0.01634170301258564, -0.02144435979425907, -