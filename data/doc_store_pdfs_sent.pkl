2796111404895782, -0.06057869270443916, -0.01255130860954523, 0.051812052726745605, 0.041166242212057114, 0.011853170581161976, 0.040832020342350006, -0.02820611745119095, 0.010483874939382076, -0.0298061091452837, 0.004570544231683016, 0.018618043512105942, -0.06742601096630096, 0.05363340675830841, -0.04830636829137802, 0.1142130121588707, -0.010012004524469376, -0.007974626496434212, -0.0011592396767809987, -0.036965638399124146, 0.014823194593191147, -0.00839102454483509, 0.028600646182894707, 0.008825313299894333, -0.050106924027204514, -0.013950871303677559, 0.008571372367441654, 0.020404601469635963, 0.02284219302237034, -0.012574838474392891, -0.014295105822384357, -0.030101602897047997, 0.008002008311450481, -0.060964953154325485, 0.07138153165578842, -0.00741998665034771, -0.012648367322981358, -0.01361029502004385, 0.026865867897868156, -0.007295831106603146, -0.06197888031601906, -0.05932635813951492, 0.023649057373404503, 1.942857292627817e-34, -0.006182657554745674, 0.005233620293438435, 0.0009661472868174314, -0.06459583342075348, 0.012094385921955109, 0.0012576680164784193, -0.03372007980942726, -0.011348496191203594, 0.004766127560287714, -0.0054200454615056515, -0.005580272525548935], "sparse_embedding": null}, {"id": "1652f888466aebf176808b7fd4658c252ec37a8ab185e25b3c68693ef6c68c11", "content": "This chunk is part of the section detailing how to assess and document the impact of Good Autism Practice standards on autistic learners, their families, and staff. It emphasizes the importance of evidence collection through various means such as assessment results and case studies, ensuring an inclusive and supportive learning environment for autistic individuals.On autistic learners:\nOn parents/carers:\nOn staff:\nHow do we document evidence of working on this standard? We document evidence of working on this standard through assessment results, the production of resources, case studies, learner profiles, and the goals we co-\ncreate with autistic learners and parents/carers (where appropriate/possible), and by documenting our reasonable adjustments and the impact of those.\nEvidence to show how we meet this standard:\fPost-16 Standards Framework\n33 Enabling environments\nWe create an inclusive learning environment through promoting positive attitudes and behaviours toward autistic learners. Our staff build effective relationships by actively listening, talking to and observing autistic learners, and by communicating regularly and positively with parents/carers and relevant professionals.\nBeing supported towards greater independence and employability can be life transforming for children and young people with SEN. ", "dataframe": null, "blob": null, "meta": {"file_path": "Post-16-Standards-Framework_T-HUB-Sc-Mt (1).pdf", "url": "https://drive.google.com/file/d/1J2sZ87itIDhKcF_wmZN2TcBeZRLjlMJP", "source_id": "8c4c774884107306cf77966fe0ff24690d0139f6223da0babe2c1bcd4b2a95b5", "page_number": 33, "split_id": 67, "split_idx_start": 41258, "_split_overlap": [{"doc_id": "6d544d177a62cae5c475647ee42da5c2410a018fec9adb977dfc8f31b7dd81ab", "range": [786, 894]}, {"doc_id": "225771e35521fa2e322ef1ffac95aa383c5c9813ac5815b0ea29ce65eeeae4d4", "range": [0, 128]}]}, "score": null, "embedding": [0.022697998210787773, -0.08455520868301392, -0.021273216232657433, 0.005450703669339418, -0.011065877042710781, 0.03022732585668564, 0.029850373044610023, -0.03373651206493378, -0.05964638292789459, -0.00305697089061141, 0.06295007467269897, -0.04492789879441261, 0.0425727404654026, 0.0010773941176012158, 0.01153712347149849, -0.05397988110780716, 0.033702220767736435, 0.033775780349969864, -0.018759462982416153, 0.018935956060886383, 0.014783897437155247, 0.016913197934627533, -0.025511540472507477, 0.04193184897303581, 0.0025470000691711903, -0.018272126093506813, 0.01840178109705448, 0.007724161259829998, 0.005484073888510466, -0.06369522213935852, 0.020778240635991096, -0.02718595787882805, -0.001818460295908153, -0.0115457074716687