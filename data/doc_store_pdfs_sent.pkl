 to that child learning: they may be quieter, but not necessarily engaging with the content of the lesson. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Improving_behaviour_in_schools_Report.pdf", "url": "https://drive.google.com/file/d/18VgDE6jXP5eN_4w_IPbsUVu8tW-V4ep2", "source_id": "7a1d3f44ce494b71f1d9e0fe5b7517c578d4c867369077d76a9ccd359cf1603d", "page_number": 17, "split_id": 31, "split_idx_start": 28295, "_split_overlap": [{"doc_id": "76b9faa8684ca6aa94009271c6e45d20d7de7e18fe679c21df625c5f6ede2ead", "range": [533, 648]}, {"doc_id": "57d4dcc6ede5cb37a0e94351871de35170988894fff3c17b84224c50056d2761", "range": [0, 256]}]}, "score": null, "embedding": [0.046245500445365906, -0.04806653410196304, 0.005909394007176161, 0.026947185397148132, -0.008030315861105919, 0.010934715159237385, 0.04424650967121124, -0.016945460811257362, -0.029754633083939552, 0.00919282529503107, 0.026078086346387863, -0.03200704976916313, 0.0339939221739769, -0.060539212077856064, 0.020138652995228767, -0.06965534389019012, -0.004265671595931053, 0.04586373642086983, -0.03534017875790596, 0.043733127415180206, 0.007210960611701012, -0.006138839293271303, -0.007753973826766014, -0.01964464783668518, -0.056261613965034485, -0.022588878870010376, -0.002360704354941845, 0.004034518729895353, 0.014310275204479694, -0.03390072286128998, 0.08941467106342316, 0.017322057858109474, 0.0088441027328372, -0.06977149844169617, 2.0686236439360073e-06, 0.013153506442904472, -0.008477960713207722, -0.025895746424794197, 0.016873445361852646, 0.02382792718708515, -0.04463692381978035, 0.0012242351658642292, 0.014336278662085533, 0.04408855363726616, -0.014893007464706898, 0.05855345353484154, 0.003003878751769662, 0.040071725845336914, 0.041594866663217545, -0.004186845384538174, 0.002107666339725256, 0.0006774626672267914, -0.012101379223167896, -0.009770616888999939, 0.04421772435307503, -0.04090278223156929, 0.010907312855124474, 0.022853810340166092, -0.03017651103436947, 0.0012414071