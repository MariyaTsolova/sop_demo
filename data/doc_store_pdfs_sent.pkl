7, 0.014575107954442501, 0.03728703036904335, -0.04766177386045456, -0.007997521199285984, -0.031465303152799606, -0.038783736526966095, 0.028089776635169983, -0.0008272400591522455, 0.012348223477602005, -0.0036807386204600334, -0.02107224613428116, -0.054659321904182434, 0.03835869953036308, -0.0038655558601021767, 0.01946103945374489, 3.746713264263235e-05, 0.007311986759305, -0.007146215531975031, -0.03756380081176758, 0.029982268810272217, 0.08468683063983917, 0.013814913108944893, -0.054568927735090256, -0.007257545832544565, 0.03983946517109871, -0.019901033490896225, -0.07423495501279831, 0.016048304736614227, 0.013415897265076637, 1.4528060955619869e-34, 0.006504387594759464, -0.03666597232222557, 0.027568019926548004, -0.09933260828256607, 0.004858412779867649, 0.007875198498368263, 0.018151015043258667, -0.013723648153245449, -0.008869536221027374, 0.03284253180027008, -0.028039565309882164], "sparse_embedding": null}, {"id": "179a7b2d52f141f83bc46ce07631c02d655d1d6b0c1f144d900c7036deae048b", "content": "This chunk is part of the section discussing the importance of involving parents in the behaviour management process in schools, emphasizing the need for consistent communication regarding a child's behaviour. It is situated within the Appendix II: Behaviour Implementation Model, which outlines key ingredients for effective behaviour policy implementation, including relevant policies and leadership effectiveness.Parents:Give feedback to parents about their child\u2019s behaviour\u2014let them know about the good days as well as the bad ones.\f\fAPPENDIX II BEHAVIOUR IMPLEMENTATION MODEL\nActive ingredient one\nRelevant policy:\n\u2022 The behaviour policy makes sense to staff and pupils. It is used consistently in both culture-setting and corrective behaviour conversations.\n\u2022 Roles of different staff (class-based, leadership, pastoral team and others) are clearly defined and understood.\nActive ingredient two\nEffective leadership:\n\u2022 Leaders s