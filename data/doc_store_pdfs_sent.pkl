35377693, -0.023737557232379913, 0.026451099663972855, -0.024275464937090874, 0.04705244302749634, -0.021205637603998184, 0.004512378480285406, -0.041602298617362976, -0.0016219388926401734, 0.05151953548192978, 0.0024671698920428753, 0.03793294355273247, 0.04359782487154007, 0.025948114693164825, -0.010896648280322552, 0.06625773757696152, -0.03624656796455383, -0.03010440431535244, 0.0022407264914363623, -0.012880193069577217, 0.010837403126060963, -0.01069355197250843, -0.016375096514821053, -0.03108021430671215, -0.007940107025206089, -0.003876044414937496, -0.02403951808810234, 0.03714076429605484, 0.047774285078048706, 0.09727165102958679, -0.02410946972668171, 0.0189780592918396, -0.04269472509622574, -0.035918354988098145, 0.015743622556328773, -0.04407338425517082, 0.007811687886714935, 0.06980255991220474, -0.037352174520492554, 0.004663847852498293, 0.01707209274172783, 0.05219581350684166, -0.02297898940742016, 0.02777686156332493, 0.007344096899032593, -0.09574621170759201, 0.05754215642809868, 0.011903340928256512, 0.03394731879234314, -0.043974000960588455, 0.02099785953760147, 0.00744648789986968, -0.00855056568980217, -0.0002010035968851298, -0.06692930310964584, -0.0385434590280056, -0.0282698143273592, 1.7625098269177925e-34, 0.013969765976071358, -0.04144711419939995, -0.023888684809207916, -0.057943195104599, 0.011470895260572433, -0.021669913083314896, -0.019469646736979485, 0.01664484292268753, -0.0029357511084526777, 0.013084628619253635, 0.008841974660754204], "sparse_embedding": null}, {"id": "94e6ba43eaa1501d4654736183a91a216928c71b74839f5749603d77092dbfa8", "content": "This chunk is situated in the section discussing current practices in primary schools regarding Social and Emotional Learning (SEL). It highlights the prevalence of the SEAL program, training inadequacies, and schools' needs for ongoing support and resources to enhance their SEL delivery effectively.\u2022 The most commonly used approach among schools was SEAL (Social and Emotional Aspects of Learning), which was developed as part of the Primary National Strategies. 104 schools said they used SEAL resources, and a further 74 that they had used them previously.\n\u2022 Many schools reported having had some training related to SEL, but in most cases this appears to have been a one-off workshop, rather than ongoing support.\n\u2022 When asked what would help them deliver SEL more effectively, schools identified training as the greatest need. This was followed by the desire for a curriculum and resources on SEL including \u2018links to the core curriculum\u2019 and resources \u2018that don\u2019t require huge time commitments\u2019.\n", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Social_and_Emotional_Learning.pdf", "url": "https://drive.google.com/file/d/1ux2ZVY-H62jpu0xzPvuWIaW6mMGtPxRN", "source_id": "e8d637c88ad0e99d399f844be26e40bf15211fc84f01bf87ff947205064caf09", "page_number": 9, "split_id": 26, "split_idx_start": 21383, "_split_overlap": [{"doc_id": "3f1a43375189501603b8245320a543bd9bdf26ca8b9c6d73975589bca38275e8", "range": [651, 816]}, {"doc_id": "df586f86c88ec8f7697841bdebbd15f7f21bee59cbe59b57f5b668cbcf2f7fe1", "range": [0, 169]}]}, "score": null, "embedding": [0.04983636736869812, -0.04168764874339104, -0.005064779426902533, 0.0001299944706261158, -0.008692869916558266, 0.054840609431266785, 0.020266659557819366, -0.052265480160713196, 0.028404196724295616, -0.0004853045102208853, 0.011800052598118782, 0.009241735562682152, 0.023318562656641006, 0.00012503819016274065, 0.011249769479036331, -0.10224192589521408, 0.0047886911779642105, 0.059334076941013336, -0.007755985017865896, 0.014866005629301071, 0.00628161383792758, 0.01829131320118904, 0.005127009004354477, -0.023167965933680534, -0.0056310296058654785, -0.021222135052084923, -0.04883662238717079, 0.020389098674058914, 0.01953940838575363, -0.0455242395401001, 0.047322120517492294, 0.015022734180092812, -0.014092052355408669, -0.061583079397678375, 2.496