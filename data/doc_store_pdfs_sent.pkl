065, -0.04150129109621048, 0.005439897533506155, 0.036812957376241684, -0.00533584738150239, -0.0469607412815094, -0.023612167686223984, 2.4258936353196194e-34, -0.017925648018717766, 0.05054455250501633, 0.009658698923885822, -0.060097310692071915, -0.05527465045452118, -0.048768095672130585, -0.002004769863560796, 0.02504849061369896, 0.030191780999302864, -0.006306659430265427, -0.07032984495162964], "sparse_embedding": null}, {"id": "6467510760df00490822d10d22237a441fdabea61322bd47e1a4c18ac6232f29", "content": "This chunk is situated in the section discussing the graduated approach to understanding and supporting pupils with Special Educational Needs and Disabilities (SEND). It provides a practical example of the \"Do\" phase of the \"Assess, Plan, Do, Review\" framework, detailing specific interventions for a pupil named Sam, along with mechanisms for assessing the effectiveness of these supports.Do\u2014implement the planned support.\nSam will:\n\u2022 be able to leave class one minute before his peers to enable him to get to the next class and avoid the noisy rush;\n\u2022 use the personalised learning area as his safe space during social time; structured break-time activities will help build positive peer relationships modelled by key worker adults;\n\u2022 take part in group reading interventions, timetabled in registration time, twice per week to use reciprocal reading strategies of \u2018question, clarify, summarise, and predict\u2019; and \u2022 improve his spoken vocabulary to describe his emotions\u2014with teacher and TA support\u2014to be more specific rather than simply saying \u2018I\u2019m bored\u2019; direct vocabulary instruction and work on social stories will enable emotional expression.\nReview\u2014did the support work? Any information gathered in response to the testing of a hypothesis is useful: a successful response to support helps identify a strategy that works while a non-response helps to refine our understanding of a pupils\u2019 needs and inform a new hypothesis. Outcome 1: met. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 18, "split_id": 60, "split_idx_start": 41851, "_split_overlap": [{"doc_id": "3c7db29c64fa7b24cca25c3a70769d815dd746767cfe6864a59f8f9b6ba3a1b0", "range": [205, 239]}, {"doc_id": "84933817a841a57444419494ea5d7a5489eef4b3a6f4075d42acf4e20a473a2b", "range": [0, 16]}]}, "score": null, "embedding": [0.018980232998728752, -0.10219249129295349, -0.007703850045800209, -0.003972888924181461, -0.04084758460521698, 0.054073769599199295, 0.04484731703996658, -0.012710160575807095, -0.02232571505010128, 0.003348435740917921, 0.08453471213579178, -0.050604186952114105, 0.030247820541262627, 0.00574951246380806, 0.0003303797566331923, -0.09080420434474945, 0.04273204877972603, 0.03253711760044098, -0.03857613354921341, 0.005833755247294903, -0.034838929772377014, 0.0017640278674662113, -0.0369117334485054, -0.00015693438763264567, 0.0389549694955349, -0.03200158476829529, -0.021248480305075645, 0.042129743844270706, 0.004838938359171152, -0.048685379326343536, 0.058125510811805725, 0.04078894853591919, -0.02125655673444271, -0.04404159262776375, 2.111515641445294e-06, 0.004523817449808121, 0.012308713048696518, 0.0019183220574632287, -0.003897477872669697, -0.00515452167019248, 0.021883970126509666, 0.027444111183285713, 0.015545212663710117, 0.03285123035311699, 0.00757478317245841, -0.006663188338279724, 0.01108974777162075, 0.008257230743765831, -0.023506687954068184, 0.004124192520976067, 0.0013603577390313148, -0.04407830908894539, -0.04190411791205406, -0.040779080241918564, 0.07198284566402435, 0.026281552389264107, 0.0061960527673363686, -0.010777155868709087, 0.0647067278623581, 0.02430134266614914, 0.004760221112519503, 0.017