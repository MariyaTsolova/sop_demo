6792, -0.03432106226682663, 0.03404543176293373, -0.021700603887438774, 0.036572109907865524, 0.001582663506269455, 0.016941864043474197, -0.021687977015972137, -0.06133095547556877, -0.000668743159621954, -0.003561881836503744, 0.04202516749501228, 0.10401224344968796, 0.0015801353147253394, 0.03134575113654137, 0.026027536019682884, 0.047670841217041016, 0.00655726483091712, -0.009127557277679443, -0.007876457646489143, -0.04432212933897972, -0.013995466753840446, -0.02146749012172222, 0.07727442681789398, 0.01230149157345295, -0.04080253466963768, 0.014853266067802906, -0.00571067351847887, 0.035108376294374466, -0.019269971176981926, -0.0331217385828495, -0.017901746556162834, 2.3461969550437914e-34, -0.027836959809064865, -0.008246262557804585, 0.017189553007483482, -0.0833754688501358, -0.02409568428993225, -0.051535025238990784, 0.03411369398236275, 0.0316307507455349, 0.045701973140239716, 0.006552740000188351, -0.06463899463415146], "sparse_embedding": null}, {"id": "3a0e9fa621a41718a15c383ab71021da3695bf83591c57e3d90b0ad7262a1ff9", "content": "This chunk is part of a section discussing the importance of high-quality teaching and structured interventions for pupils with Special Educational Needs and Disabilities (SEND). It emphasizes the need for teachers to evaluate the effectiveness of their approaches and adapt them as necessary while introducing a tiered approach to support interventions in schools.If an approach does not appear to be working for a pupil, teachers need to consider what is not working and how it could be changed.\f28\nEducation Endowment Foundation 4\nComplement high quality teaching with carefully selected small-group and one-to-one interventions High quality teaching should reduce the need for extra support for all pupils. Nevertheless, it is likely that some pupils will require additional support in the form of high quality, structured interventions to make progress. This chapter suggests that schools adopt a tiered approach to support and carefully consider when targeted interventions might be appropriate and when they may want to seek additional specialist support. Tiers of support\nSmall-group and one-to-one interventions provide the opportunity to apply effective teaching strategies with a more intense focus on a smaller number of learning goals. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 29, "split_id": 104, "split_idx_start": 67171, "_split_overlap": [{"doc_id": "ce2f87ce8c54463be2d865c00ad07bec8cbcafed3cd3d98764ef560959bb6a95", "range": [477, 610]}, {"doc_id": "df5330796b1ee524f541f247cd3d6532eddcb36d5895cf0c3de883385bdc5984", "range": [0, 186]}]}, "score": null, "embedding": [0.035588569939136505, -0.09100256115198135, -0.011809364892542362, -0.014827256090939045, 0.003724359441548586, 0.00801803544163704, 0.04003109782934189, -0.05119571462273598, -0.01643206551671028, 0.011387280188500881, 0.057014115154743195, -0.03304329141974449, 0.009769640862941742, 0.015147481113672256, 0.01915629766881466, -0.1730344444513321, 0.013889367692172527, 0.015970125794410706, -0.026951849460601807, 0.02066870406270027, -0.007011969108134508, 0.009713951498270035, -0.015406008809804916, -0.007166268303990364, 0.004189465660601854, -0.031131666153669357, 0.025339538231492043, 0.03046642430126667, 0.04298953711986542, -0.028766348958015442, 0.05409415066242218, 0.06112097203731537, 0.019211016595363617, -0.02735041081905365, 2.478605665601208e-06, 0.04478142783045769, 0.02304891310632229, -0.027859164401888847, -0.03697102889418602, -0.014128919690847397, -0.08059719949960709, -0.05881509557366371, 0.009113510139286518, 0.043723154813051224, 0.02372146025300026, 0.05358533188700676, 0.005501477979123592, -0.013633034192025661, 0.051377296447753906