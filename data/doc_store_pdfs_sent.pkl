396461964, 0.01035387720912695, 0.03454866260290146, 0.03206077590584755, -0.030076894909143448, 0.004967065528035164, -0.03987426683306694, 0.020685946568846703, -0.056850969791412354, 0.0695851668715477, -0.02654067426919937, -0.02520027384161949, 0.005136555060744286, 0.015497139655053616, -0.04100760072469711, -0.05101867765188217, -0.04997086152434349, 0.008529828861355782, 2.099482501736531e-34, -0.00025821966119110584, 0.012384852394461632, 0.0156362596899271, -0.07555070519447327, 0.024791184812784195, -0.006985394284129143, -0.05447135865688324, 0.006812231615185738, 0.005521837156265974, -0.044573478400707245, -0.017774159088730812], "sparse_embedding": null}, {"id": "64dc792296ffe36b1148f0c76de96bb6cf01917e9a0cb98eece1873e8a20d6e5", "content": "This chunk is situated within the section addressing Standard Two under Principle One, which focuses on understanding the strengths, interests, and needs of each autistic pupil. It emphasizes the importance of recognizing co-occurring conditions and behaviors, collaborating with parents and professionals, and implementing strategies to support autistic pupils' emotional wellbeing and learning.We are committed to understanding the causes and functions of behaviour.\nROOM FOR IMPROVEMENT\nDEVELOPING WE DO THIS REALLY WELL\nExamples of how we can do this:\nStaff are informed about co-occurring conditions and differences, including potential disturbed and erratic sleeping, eating, and toileting. Staff are aware of how each individual pupil\u2019s co-occurring condition or physical/mental health needs might affect learning and/or behaviour and how this may differ across settings.\nROOM FOR IMPROVEMENT\nDEVELOPING WE DO THIS REALLY WELL\nStaff work closely with parents/carers, other professionals, and the pupil to identify and understand the reasons for and the functions of behaviour, with a particular focus on understanding behaviours that signify distress.\nROOM FOR IMPROVEMENT\nDEVELOPING WE DO THIS REALLY WELL\nStaff implement individual strategies to reduce anxiety and enhance the wellbeing of children. ", "dataframe": null, "blob": null, "meta": {"file_path": "aet-schools-standards-framework.pdf", "url": "https://drive.google.com/file/d/166LzAs4UUYY2nmfvEFE7NUcJyEIfBoc3", "source_id": "fd3b04f3804d8efbea64fc291fd78f2aefe37cddffb9972efcc9615a49cfdf8c", "page_number": 16, "split_id": 45, "split_idx_start": 19637, "_split_overlap": [{"doc_id": "04ef1b3e47c878411f5ee24453b2d6df440e5b5b1ef1ead9277ea68f4d3fd70a", "range": [700, 773]}, {"doc_id": "f3677220e13ac41cb3527ea397abe9500def109e61edf0405eaca400497197f2", "range": [0, 150]}]}, "score": null, "embedding": [0.05050989240407944, -0.10915938019752502, -0.0021973031107336283, -0.001723174238577485, -0.0006868341588415205, 0.0523654967546463, 0.03451148048043251, -0.026963621377944946, -0.07300379872322083, -0.028479790315032005, 0.03672298043966293, -0.09316674619913101, 0.03677236661314964, -0.016443613916635513, 0.02507716789841652, -0.06540852040052414, 0.038429051637649536, 0.025492491200566292, -0.023327820003032684, 0.02069057524204254, -0.010148633271455765, 0.006829403340816498, -0.031178774312138557, 0.026526877656579018, 0.03812435641884804, -0.021837659180164337, 0.011076390743255615, 0.01339765451848507, -0.008196272887289524, -0.0566665455698967, 0.04176521301269531, -0.0012372806668281555, 0.012041386216878891, -0.03073950484395027, 2.2355902729032096e-06, 0.005596404429525137, 0.032031506299972534, -0.0030052983202040195, 0.007446566130965948, 0.011090533807873726, -0.05998946726322174, -0.016208985820412636, 0.04382936283946037, 0.04955630004405975, -0.0011820195941254497, -0.041582077741622925, 0.01990312524139881, 0.08492979407310486, 0.022705189883708954, 0.004284749738872051, -0.008581233210861683, 0.002527787582948804, -0.007864146493375301, -0.049337174743413925, 0.0073420205153524876, -0.036109186708927155, 0.02702406607568264, -0.08455570787191391, 0.04093564301729202, 0.007866372354328632, -0.011715325526