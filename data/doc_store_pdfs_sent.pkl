.008730047382414341, 0.0808066874742508, -0.015779778361320496, 0.024093812331557274, 0.0003382988797966391, -0.00048524184967391193, 0.01690462976694107, 0.00394715229049325, 0.032588206231594086, 0.06023085117340088, -0.035108473151922226, 0.007342688739299774, 0.033405303955078125, 0.042045898735523224, 0.00855531170964241, 0.022568197920918465, -0.001618725131265819, -0.053919292986392975, 0.008499618619680405, -0.019623447209596634, 0.07058284431695938, -0.016728553920984268, -0.06342485547065735, -0.0024904224555939436, 0.0028313337825238705, 0.01025376282632351, 0.011238301172852516, -0.0635172426700592, -0.026089055463671684, 1.977905391381553e-34, -0.010371782816946507, 0.008895291946828365, 0.0030125535558909178, -0.07436168938875198, -0.02330460585653782, -0.04029974341392517, -0.01875767670571804, 0.03964485600590706, 0.02846093848347664, 0.0059508089907467365, -0.042043522000312805], "sparse_embedding": null}, {"id": "771a233e34964e8b25c0ffba1d8e339001282af53f5c59d797042d74066ede2f", "content": "This chunk appears in the section discussing the importance of understanding pupils' learning needs, specifically addressing the role of diagnostic labels in shaping educational approaches for students with Special Educational Needs and Disabilities (SEND). It emphasizes the need for schools to adopt a holistic view of learning needs and the involvement of various stakeholders in the assessment process.Discussion questions:\nHow might the diagnostic labels of some pupils alter approaches to teaching?\nHow should schools build a holistic picture of learning needs for pupils with SEND? Who should be consulted when assessing learning needs, within the school and beyond?\f15Special Educational Needs in Mainstream Schools\nDiagnostic labels have benefits, especially for certain conditions such as hearing or visual impairment. A diagnosis can provide a general indication of what a pupil\u2019s educational needs are likely to be and support a young person to understand why they might experience the world differently to their peers. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 16, "split_id": 52, "split_idx_start": 36450, "_split_overlap": [{"doc_id": "ab642ea658a93de0a1e1f8c8ee523c92f304d3833c0b5d3306493d029dd32fb7", "range": [552, 651]}, {"doc_id": "30b22cafb9d7bdb9056300ccd0803d6d8431bffccb6d1b490db6eddb636a424e", "range": [0, 203]}]}, "score": null, "embedding": [0.03468240424990654, -0.0877380520105362, -0.01059570349752903, 0.007571003399789333, 0.011327281594276428, 0.044993892312049866, 0.04327718913555145, -0.026034250855445862, 0.035705190151929855, 0.013612249866127968, 0.028902290388941765, -0.017207056283950806, 0.02354014664888382, -0.008154092356562614, -0.001510114991106093, -0.09513727575540543, 0.011741909198462963, 0.004655034746974707, -0.02213766984641552, 0.031173987314105034, -0.022674372419714928, 0.010185938328504562, -0.03569607064127922, 0.0016532609006389976, -0.025516962632536888, -0.06722889095544815, 0.055691421031951904, -0.013612992130219936, 0.010311439633369446, -0.024857109412550926, 0.03291049227118492, 0.04322994872927666, -0.008335908874869347, -0.05106944218277931, 2.0809243324038107e-06, 0.03922117128968239, 0.011550831608474255, -0.02431544102728367, -0.020895296707749367, -0.005309884436428547, -0.06632424145936966, -0.013214283622801304, 0.035104941576719284, 0.023633603006601334, 0.0032785357907414436, -0.003129836404696107, 0.02484152838587761, -0.0015046544140204787, -0.03732975199818611, -0.039625443518161774, -0.00956156849861145, 0.0028233355842530727, -0.04126660153269768, -0.04412546008825302, 0.1240043193101883, -0.01440128032118082, 0.003431527176871896, -0.05123448744416237, 0.016995353624224663, 0.02000937983393669, -0.0