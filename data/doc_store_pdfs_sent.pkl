, 0.015199107117950916, -0.02448982186615467, -0.03793434426188469, 0.030578017234802246, -0.040797121822834015, 0.060610927641391754, 0.08254087716341019, -0.02563360333442688, 0.0011556895915418863, 0.0036239477340132, 0.031297918409109116, 0.060277875512838364, -0.011332463473081589, 0.012526264414191246, -0.007635647896677256, 0.01609647460281849, -0.014895543456077576, 0.032738495618104935, -0.038499798625707626, -0.025483932346105576, -0.010939831845462322, 0.003247095737606287, -0.017496520653367043, -0.04312816262245178, 0.023686477914452553, -0.009296033531427383, 1.9749108654405813e-34, 0.006070814095437527, 0.02599515952169895, 0.018788767978549004, -0.07413430511951447, 0.016451094299554825, -0.017941594123840332, -0.038265131413936615, -0.014830371364951134, 0.009569992311298847, 0.019999096170067787, -0.01301306951791048], "sparse_embedding": null}, {"id": "e0ff3a481fdb570f2ccfec06b57e390ebf29c0c7af07d3c6404b249f24610c15", "content": "This chunk is from Case Study C: Hinderton Special School, highlighting the implementation of vocational activities for secondary students. It describes how they prepare snacks for primary students while developing their skills in a supportive environment, emphasizing the school's focus on arts and sensory work to enhance social skills among students.The secondary students make snacks for the primary students and have a special uniform they wear to deliver these snacks.\fGood Autism Practice Guide \u2013 Case Studies\n35 Doc ref: GAP report - case studies_I-S\nThe degree of prompting needed gradually reduces as the students develop the skills and video is taken to show this progress.\nThe dance studio provides a multi-purpose space used for sensory work and for developing group social skills. The Arts is a strength of the school and the school is staffed to reflect this, having a dance tutor, a drama tutor and two art tutors. To complement the curriculum, the students visit galleries and work with a visiting artist.\n", "