0735331850592047, -0.03553745150566101, -0.001907992409542203, -0.009118380956351757, -0.00942282471805811, 0.02394258975982666, 0.043162308633327484, 0.03125792741775513, 0.05104726180434227, 0.007154195103794336, -0.010075605474412441, -0.007102486211806536, 0.08152192831039429, -0.055123522877693176, -0.020081501454114914, -0.035950783640146255, 0.011937831528484821, -0.02303733117878437, 0.014479171484708786, 0.04644029960036278, 0.007364608813077211, 0.032522499561309814, 0.016195697709918022, -0.017669256776571274, -0.05822531133890152, 0.03151965141296387, 0.018045460805296898, 0.014851771295070648, -0.04817860946059227, -0.022745098918676376, -0.008676845580339432, -0.04228939861059189, -0.01544057484716177, 0.022175192832946777, -0.05922381207346916, -0.03299594298005104, -0.06229225918650627, 0.11136559396982193, -0.028648624196648598, 0.04169214144349098, -0.01314112450927496, -0.04742516577243805, 0.0223835501819849, -0.04687631130218506, 0.02509838342666626, 0.04095759242773056, -0.010347249917685986, -0.011157077737152576, 0.01684008352458477, 0.056128621101379395, 0.0482049323618412, 0.010343829169869423, 0.0064487457275390625, -0.01835695654153824, 0.004532950930297375, -0.039088185876607895, 0.05968002602458, -0.02001226879656315, -0.02610781602561474, 0.017570851370692253, 0.007780109997838736, -0.031833089888095856, -0.04677285626530647, -0.051467910408973694, 0.01907908171415329, 1.7542167372316153e-34, -0.0008286177762784064, 0.012795902788639069, 0.004971555899828672, -0.06850893795490265, 0.06486087292432785, -0.021967602893710136, -0.04429006576538086, -0.0074764140881598, 0.019030632451176643, -0.0183907188475132, -0.013805057853460312], "sparse_embedding": null}, {"id": "d68f9869f4cbdec72684f96aeb1466962a020bdddb29af2eda94b7693a473f90", "content": "This chunk is part of Case Study A, focusing on Tom, an 8-year-old autistic pupil with significant anxiety at Watermore Primary School. It details strategies implemented to understand and address his sensory needs using the AET Sensory Checklist, including physical activities and sensory sessions aimed at reducing his anxiety and improving his overall wellbeing.This case study illustrates a number of the strategies that were successfully implemented to support Tom and to reduce his anxiety.\nUnderstanding the individual with autism\nP1 \u2013 Understanding the strengths, interests and challenges of the autistic child and young person\nAn assessment of Tom\u2019s sensory needs was completed using the AET Sensory Checklist. Actions were taken to address the issues raised. These included:\n\u2022 giving Tom the opportunity to move as much as possible \u2013 Tom enjoyed climbing, running and swinging\n\u2022 carrying out deep pressure activities such as squeezing activities and deep hugs (with parental permission)\n\u2022 use of weighted items such as neck and lap weights\n\u2022 provision of sensory sessions that included alerting, organising and calming activities\n\u2022 helping to maintain Tom\u2019s focus with fidget toys.\nSome sensory activities are used daily to help calm Tom, ( e.g. ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 3, "split_id": 6, "split_idx_start": 2591, "_split_overlap": [{"doc_id": "766cae29b5faec716c2047d3513f1ac5af4c5cec95af7eb39642a9a8b544f5c2", "range": [331, 463]}, {"doc_id": "8f4df78e0b6b14c055a17a1f0382b3b6cf915d82294e3eefea3d10e030318f5a", "range": [0, 64]}]}, "score": null, "embedding": [0.0030984010081738234, -0.09221553057432175, -0.0164005309343338, 0.030254313722252846, 0.024416133761405945, 0.03551103174686432, 0.0131073584780097, -0.033430758863687515, 0.013780993409454823, -0.002158602001145482, -0.015572326257824898, -0.040810953825712204, -0.0008482791599817574, -0.02275967411696911, -0.024845497682690