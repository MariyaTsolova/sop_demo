9605235159397, 0.03348367661237717, -0.050655215978622437, 0.008008121512830257, -0.03498765826225281, 0.022369084879755974, 0.03608829900622368, -0.06011071801185608, -0.007085978519171476, -0.034336503595113754, 0.05932196229696274, 0.0009370568441227078, 0.016673307865858078, -0.0028023298364132643, -0.029289867728948593, 0.030514094978570938, 0.032280128449201584, 0.060785870999097824, 0.0553566999733448, 0.003964863717556, -0.0207932498306036, 0.010907050222158432, 0.05001824349164963, 0.02300664409995079, -0.0006867399206385016, 0.02876489982008934, -0.034255851060152054, 0.02400258369743824, -0.008642131462693214, 0.023483099415898323, -0.0609540194272995, -0.01809547282755375, 0.008905524387955666, 0.03733855485916138, 0.008213203400373459, -0.03697822242975235, -0.0029983073472976685, 0.02222500368952751, 1.8381758472672462e-34, 0.01581639051437378, 0.029683155938982964, 0.034705255180597305, -0.06464201211929321, 0.0411081500351429, 0.00011120855197077617, -0.03176983445882797, -0.026965830475091934, 0.026464363560080528, 0.011011243797838688, -0.0288042314350605], "sparse_embedding": null}, {"id": "223c63de378b6ffcb531b01002f66b74a40ce780b8c526e0cb87b1ce30728d17", "content": "This chunk is part of Case Study E, which focuses on Priestnall Secondary School's inclusive practices for autistic students. It specifically describes Max, a Year 10 student, detailing his strong relationship with his form tutor, his social interactions, interests in Pok\u00e9mon and gaming, and the safe spaces available for him during lunchtime.He has had the same form tutor all the way through secondary school and they have an excellent relationship. He is a member of a social club where he plays on computers with others. His special interest is especially Pok\u00e9mon, his favourite character being Pikachu. Max also enjoys watching YouTubers playing gaming videos and wants to create games in the future as a career.\nAt lunchtime, Max sometimes goes to a quiet room (N2) designated for students who need a safe space or he goes to the library or the IT suite. ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 38, "split_id": 157, "split_idx_start": 80169, "_split_overlap": [{"doc_id": "e69b1683a0de7f0bef88cf940dbfbc686e4b282b7f26fb9764f29a3ed05492e2", "range": [394, 503]}, {"doc_id": "0daecce0cead01db9c35ea80d803ebc1649a48de1ebd84227113bdddf73a236a", "range": [0, 143]}]}, "score": null, "embedding": [0.04700809344649315, -0.04401402547955513, -0.030209464952349663, 0.04878740757703781, 0.03219393268227577, 0.017681749537587166, 0.0349951833486557, -0.03023075871169567, -0.05869080126285553, 0.011659560725092888, 0.00956563651561737, -0.03765677288174629, 0.011885616928339005, 0.02170582488179207, -0.008938583545386791, -0.07037515938282013, 0.012230209074914455, 0.015717580914497375, -0.03842061012983322, 0.027847925201058388, -0.026413828134536743, 0.002081404672935605, -0.00433397525921464, 0.08055726438760757, 0.033948566764593124, -0.06871804594993591, 0.027996668592095375, 0.009061925113201141, 0.01726965233683586, -0.01438513770699501, 0.06685402244329453, -0.02918546460568905, -0.030230000615119934, 0.021276794373989105, 2.328850996491383e-06, 0.0375005267560482, 0.045245423913002014, -0.006969836074858904, 0.031961239874362946, -0.006667289417237043, -0.07697529345750809, 0.031167227774858475, 0.017736321315169334, 0.04235502704977989, -0.04311598092317581, 0.0012132058618590236, 0.024216432124376297, 0.003149063093587756, 0.026545144617557526, -0.03001789003610611, -0.007867354899644852, 0.020995115861296654, -0.02855718322098255, -0.04401455074548721, 0.07686839997768402, -0.028864825144410133, -0.004902299959212542, -0.05958273634314537, 0.08317068219184875, 0.018890531733632088, -0.006789497099816799, 0.004465102218091488