udies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 12, "split_id": 48, "split_idx_start": 22513, "_split_overlap": [{"doc_id": "2386b94e57459a03d1b36d1b6400319455e102200d97e9c2c734655575c205e3", "range": [471, 528]}, {"doc_id": "737a8e642647d7fbc774ab13e54ef068bac1207e8366ff054757a7461e79542f", "range": [0, 98]}]}, "score": null, "embedding": [0.05510972812771797, -0.09320018440485, -0.010689709335565567, 0.02335241809487343, -0.037593189626932144, 0.05454564839601517, 0.03666743263602257, 0.00010042893700301647, -0.03448387607932091, -0.015658557415008545, 0.01201999094337225, -0.06725974380970001, 0.0433318056166172, -0.004903040360659361, 0.015008145943284035, -0.06818778067827225, 0.02498549409210682, 0.05689074471592903, -0.025531865656375885, 0.029448991641402245, -0.00913578923791647, 0.05044974386692047, -0.025571627542376518, 0.053492650389671326, -0.03973289206624031, -0.02483384497463703, 0.030839111655950546, 0.04343803972005844, -0.023709207773208618, -0.04586539790034294, 0.058371029794216156, -0.005846991669386625, 0.017343217507004738, -0.04955427721142769, 2.3258564851857955e-06, 0.01461455412209034, 0.0006384930456988513, -0.0014714716235175729, -0.007575614843517542, -0.027083009481430054, 0.023586757481098175, -0.007207151036709547, -0.010521022602915764, 0.006936074234545231, 0.010487108491361141, -0.02312556840479374, 0.01694706827402115, 0.09703197330236435, -0.006811455823481083, 0.007255036849528551, -0.004386001732200384, 0.018479831516742706, -0.04401911050081253, -0.029440756887197495, 0.0366179384291172, -0.02834906615316868, 0.012901581823825836, -0.03739040717482567, 0.06062304228544235, -0.07135223597288132, -0.04895337298512459, 0.006936851888895035, -0.020579058676958084, -0.06073544919490814, -0.048304233700037, -0.02452191710472107, -0.04460889473557472, -0.07916726917028427, 0.029901159927248955