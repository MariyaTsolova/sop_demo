nd interact with different environments in different ways. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 8, "split_id": 23, "split_idx_start": 15982, "_split_overlap": [{"doc_id": "26aba9a7a0de6bd5ea109b5298230b5687c1a9ea7504d66d6bca14a0c9da5c7a", "range": [996, 1038]}, {"doc_id": "fb1acccd3ecd44b31d22895c6fcc5e045360d796a7f476e2e59cd10358ad8c66", "range": [0, 136]}]}, "score": null, "embedding": [0.00694798631593585, -0.09677894413471222, -0.02036024071276188, 0.01784389279782772, -0.013635384850203991, 0.01607144996523857, 0.09009017050266266, -0.03680751472711563, -0.040488023310899734, -0.0026288614608347416, 0.051732949912548065, -0.04312242567539215, 0.07344476878643036, -0.014648702926933765, 0.001685424940660596, -0.12141658365726471, 0.03003515489399433, 0.0034531010314822197, -0.07453461736440659, 0.027860846370458603, -0.047957949340343475, 0.00100130052305758, -0.038971930742263794, 0.0075890370644629, 0.002465181052684784, -0.00547990296036005, 0.00692957965657115, -0.012426814064383507, 0.006904182955622673, -0.00415801489725709, 0.03983747214078903, 0.04324226826429367, 0.011322224512696266, -0.026949744671583176, 2.137439651050954e-06, -0.003284264588728547, 0.02445385232567787, -0.0076993913389742374, -0.01896321028470993, 0.05171586573123932, -0.022567223757505417, -0.009758135303854942, 0.014558832161128521, 0.007923112250864506, 0.008357293903827667, -0.019773250445723534, -0.00028012756956741214, 0.023512646555900574, -0.02973124198615551, -0.05482175573706627, -0.0031075465958565474, -0.0022198427468538284, -0.032535020262002945, -0.041127391159534454, 0.06749163568019867, -0.019353944808244705, 0.0077847670763731, -0.04465460404753685, 0.015122334472835064, -0.014081821776926517, -0.045651