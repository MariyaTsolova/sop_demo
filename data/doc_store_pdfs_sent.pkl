nd voice is promoted through the language used by all the staff. For example, the TA working with Tom always uses question stems which promote choice, such as:\n\u2022 \u201cWould you \u2026?\u201d\n\u2022 \u201cCan you \u2026?\u201d\n\u2022 \u201cMay we \u2026?\u201d\n\u2022 \u201cWould you like to \u2026?\u201d\n\u2022 \u201cHow do you feel about this? \u201d.\n", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 4, "split_id": 13, "split_idx_start": 5407, "_split_overlap": [{"doc_id": "5b1e169ab01f274729c6c5931234d56da8a4427a0b16271a22248df5bbebafae", "range": [334, 526]}, {"doc_id": "414540591be969063b9d4ac593b9e28dccfdda85fb16ea0b9356ca80306c44c2", "range": [0, 3]}]}, "score": null, "embedding": [0.05698913708329201, -0.04307867959141731, -0.03473275154829025, -0.00360453175380826, -0.013336608186364174, -0.0021418039686977863, 0.03719005733728409, -0.06640458106994629, -0.015418675728142262, 0.03034096769988537, 0.029214447364211082, -0.06391685456037521, -0.009309330023825169, -0.015432896092534065, 0.01188700832426548, -0.08192608505487442, 0.0063433474861085415, -0.014468192122876644, 0.003311763983219862, 0.007513692602515221, 0.014439557678997517, 0.01877748779952526, -0.036366056650877, 0.04798491671681404, 0.012795706279575825, -0.017528781667351723, -0.0071365488693118095, -0.027684448286890984, 0.035906095057725906, -0.01926080323755741, 0.015144054777920246, 0.04057040065526962, -0.0194602832198143, 0.03570672869682312, 2.235497731817304e-06, 0.01640436053276062, 0.047436073422431946, -0.05608021467924118, -0.050989557057619095, -0.022113120183348656, -0.0625063106417656, 0.04617345705628395, 0.014801109209656715, 0.02719995193183422, -0.049748778343200684, 0.029453646391630173, 0.016714714467525482, 0.008986517786979675, 0.001763402600772678