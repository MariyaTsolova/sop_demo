ys.\n", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 19, "split_id": 64, "split_idx_start": 43751, "_split_overlap": [{"doc_id": "b70f28cd0df4ce424fdf44a9413be4d18675079d5e97cb0179494e832a55f4b7", "range": [241, 360]}, {"doc_id": "a6d93e05db4acc1bcf468f406999cbf02f646ce620f8f965336e220bb698bcb2", "range": [0, 48]}]}, "score": null, "embedding": [0.0069058919325470924, -0.03910592570900917, -0.02959377132356167, -0.004848484415560961, -0.015738358721137047, 0.030384836718440056, 0.02204865962266922, -0.025263193994760513, -0.026401789858937263, 0.006771291606128216, 0.08407535403966904, -0.04159272089600563, 0.023845791816711426, 0.04260965436697006, -0.033974431455135345, -0.07472490519285202, 0.007579227443784475, 0.016593124717473984, 0.01963392272591591, 0.0028198501095175743, -0.0010494084563106298, 0.025311702862381935, -0.03702370449900627, -0.002795712323859334, 0.04610252380371094, -0.05215840041637421, 0.031727615743875504, 0.019109196960926056, 0.02493012323975563, -0.030965089797973633, 0.05220066383481026, 0.014311522245407104, -0.01175355352461338, -0.039204228669404984, 2.1606238078675233e-06, 0.012025405652821064, 0.006751323118805885, -0.015447374433279037, -0.0089093167334795, 0.009991851635277271, 0.0020459098741412163, -0.05491615831851959, -0.01971634104847908, 0.02651868388056755, -0.01879587396979332, -0.0019400393357500434, 0.027839384973049164, -0.02437712624669075, -0.008422746323049068, -0.01399613730609417, -0.001522798789665103, 0.0043969727121293545, 0.0012237642658874393, -0.02122570015490055, 0.048385266214609146, -0.02652513049542904, -0.03738248720765114, -0.08762416243553162, 0.04962099716067314, 0.006117233075201511, -0.004529838915914297, 0.06733109056949615, -0.0315421558916568