011848334223031998, -0.03845518082380295, 0.06664954870939255, 0.025229839608073235, 0.0271533764898777, 0.0027370303869247437, 0.0020081852562725544, 0.015406030230224133, -0.00040048101800493896, 0.04442685469985008, 0.10499468445777893, -0.007969701662659645, 0.007020799908787012, 0.006525881122797728, 0.015469780191779137, 0.006666584871709347, -0.004277188330888748, -0.01930505596101284, -0.035812895745038986, -0.02902444452047348, -0.014106249436736107, 0.05984784662723541, -0.026274627074599266, -0.010542498901486397, 0.001685628667473793, -3.1980202038539574e-05, 0.024185050278902054, -0.0241440050303936, -0.036779988557100296, -0.007257087156176567, 2.3674713364950113e-34, -0.004422668367624283, -0.014946634881198406, -0.006491292733699083, -0.024691790342330933, 0.008973577059805393, -0.0390736386179924, 0.008057266473770142, 0.009607888758182526, 0.041510533541440964, 0.021736029535531998, -0.06622479856014252], "sparse_embedding": null}, {"id": "07b211c43b8503a868cab41cbee186b818c84367b9fc40b8b0b2f80746269534", "content": "This chunk is part of the section discussing the effective use of teaching assistants (TAs) within the guidance report on supporting Special Educational Needs and Disability (SEND) in mainstream schools. It highlights the importance of making explicit connections between classroom teaching and interventions, emphasizing the strategic deployment and support necessary for TAs to positively impact pupil achievement.7. Ensure explicit connections are made between learning from everyday classroom teaching and structured interventions. Making Best Use of Teaching Assistants\u2014Recommendations\napple ball\nMAKING BEST USE OF TEACHING ASSISANTS\nGuidance Report\nMaking the best use of teaching assistants is a leadership issue; a lack of proper support and training is not the fault of TAs themselves. In 2015, the EEF published the report Making Best Use of Teaching Assistants. Drawing on a strong research base, this report sets out to demonstrate that TAs can have a positive impact on pupil achievement\u2014but that this only happens when they are strategically deployed, prepared, supported, and resourced. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 38, "split_id": 138, "split_idx_start": 86390, "_split_overlap": [{"doc_id": "e3b915b9f612df207ab062a4a0c68035488297a31862ed4592a3868e41ed86ef", "range": [205, 208]}, {"doc_id": "e21f1d49bb97f195a40fd5bca91ec24a5f5e958b6de4297933977fde83c22101", "range": [0, 229]}]}, "score": null, "embedding": [0.02860250324010849, -0.09171926230192184, -0.033613093197345734, -0.005958651192486286, 0.020565012469887733, -0.00010627665324136615, 0.05948920175433159, -0.06977709382772446, -0.001433152356185019, 0.0001225454907398671, 0.05199521780014038, 0.00239080423489213, 0.015272208489477634, 0.0043894508853554726, 0.03745312988758087, -0.10402628034353256, 0.005788140930235386, 0.014982488937675953, -0.060234129428863525, 0.03244372457265854, -0.011538908816874027, 0.009867176413536072, -0.01986062526702881, 0.017155753448605537, -0.014485257677733898, -0.019205082207918167, 0.012853393331170082, 0.0014716081786900759, 0.054746225476264954, 0.014630944468080997, 0.04061637818813324, 0.027121422812342644, 0.006050267722457647, -0.024884002283215523, 2.4073374333966058e-06, 0.054731547832489014, 0.03211672604084015, -0.029983187094330788, -0.03034660406410694, 0.013429682701826096, -0.08561711013317108, 0.03579111024737358, 0.025689182803034782, 0.052004825323820114, -0.0025993953458964825, 0.03133488819003105, -0.001756155863404274, -0.0590885654091835, 0.030132167041301727, -0.04079067334532738, 0.011209921911358833, -0.010989350266754627, -0.009244224056601524, -0.0436430387198925, 0.032196857035160065, -0.0610923