5468713119626045, -0.03691599890589714, 0.03691106662154198, 0.02661231905221939, 0.04037783667445183, -0.0012143546482548118, -0.05530789867043495, -0.030404621735215187, -0.050163451582193375, 0.019895192235708237, 0.03808826580643654, 0.04582939296960831, 0.0037874928675591946, -0.03624911978840828, 0.0054328045807778835, -0.022621210664510727, -0.00570422550663352, -0.0023085318971425295, -0.021820122376084328, -0.07052812725305557, 2.389293746269554e-34, 0.028631532564759254, -0.0175952035933733, 0.02325163409113884, -0.057268477976322174, -0.058432381600141525, -0.026105189695954323, 0.07665812224149704, 0.0009469368378631771, 0.005957574117928743, 0.042763326317071915, -0.04354728013277054], "sparse_embedding": null}, {"id": "d2a3602922998c0d59fe5fbbc2481b75c4134251aecf172fb7cd0569584f8eea", "content": "This chunk is part of the section discussing explicit instruction as an effective teaching strategy for pupils with special educational needs. It emphasizes the importance of using non-examples to clarify misconceptions and enhance students' understanding, particularly in distinguishing between different concepts or diagrams in subjects like science.This will allow pupils to identify the disqualifying condition with clarity, refine their mental model of what a good particle diagram looks like, and develop the ability to distinguish between different diagrams.\u2019 Adam Boxer, Head of Science, The Totteridge Academy\nBox 8: Using non-examples as part of explicit instruction \u201c \u201c\f25Special Educational Needs in Mainstream Schools\nA misconception is an understanding that leads to a \u2018systematic pattern of errors\u2019. Misconceptions are often formed when knowledge has been applied outside of the context in which it is useful. For example, the idea that \u2018multiplication makes bigger and division makes smaller\u2019 applies to positive, whole numbers that are greater than one. However, when other mathematical concepts appear (for example, numbers less than or equal to one), this idea, extended beyond its useful context, becomes a mis conception. Pupils will often defend their misconceptions, especially if they are based on sound, albeit limited, ideas. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 26, "split_id": 95, "split_idx_start": 61718, "_split_overlap": [{"doc_id": "7f21835ac7aec2a492001d8465becbdf5bca7b8596a0a0da0061755090e430c1", "range": [476, 939]}, {"doc_id": "77f07996162aaeaf2d85ec40b44b95d539c9e28a11ab97404f05d8568ae6316b", "range": [0, 109]}]}, "score": null, "embedding": [0.012607904151082039, -0.07226651906967163, -0.01161767914891243, 0.016853420063853264, -0.007543869316577911, 0.020874561741948128, 0.06143469735980034, -0.04032830893993378, -0.037356674671173096, 0.0014636233681812882, 0.03739446401596069, -0.05541452765464783, 0.04030439257621765, -0.04261152073740959, 0.014965841546654701, -0.10012084990739822, 0.01425134390592575, 0.010160190984606743, -0.029549822211265564, 0.010134133510291576, -0.0036858587991446257, -0.018856165930628777, -0.03925277292728424, -0.02496332675218582, -0.020854691043496132, -0.06163296476006508, 0.021363964304327965, -0.003584523219615221, -0.003077691188082099, -0.046261511743068695, -0.03065008670091629, 0.011300883255898952, 0.03703567013144493, 0.003933234140276909, 2.3253085146279773e-06, -0.018364956602454185, 0.015376603230834007, 0.0010570245794951916, -0.05261721462011337, 0.04125702381134033, -0.056534625589847565, -0.0018556806026026607, 0.006395059637725353, 0.013938267715275288, 0.0177701897919178, 0.03471989929676056, 0.04341786727309227, 0.032733384519815445, -0.012425299733877182, -0.004765619523823261, 0.0044379462487995625, -0.003959221765398979, -0.027656149119138718, -0.00918