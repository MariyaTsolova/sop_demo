29432583, -0.025463372468948364, -0.0025090991985052824, -0.0468602329492569, -0.03400196135044098, 0.03006643056869507, -0.06591874361038208, -0.032307833433151245, -0.022516384720802307, 0.10056135058403015, -0.03221961855888367, 0.014597145840525627, -0.056134212762117386, -0.014292961917817593, 0.046094365417957306, -0.05124113708734512, 0.05102374777197838, -0.018588971346616745, -0.06299750506877899, 0.009119031950831413, 0.03440382704138756, 0.036568399518728256, -0.02526565082371235, -0.008494604378938675, -0.02146335318684578, -0.04329107701778412, -0.010569686070084572, 0.002539781853556633, 0.051619693636894226, -0.026797611266374588, -0.08274218440055847, 0.03516825661063194, 0.007619502022862434, -0.02104884944856167, -0.011105545796453953, -0.03335189074277878, -0.003288936335593462, 2.100160936464398e-34, 0.00924884807318449, -0.03234824910759926, 0.03640497475862503, -0.07738404721021652, 0.05647481605410576, -0.028228113427758217, -0.038050442934036255, 0.0035379210021346807, 0.006637591868638992, -0.011845502071082592, -0.009569713845849037], "sparse_embedding": null}, {"id": "d846081a6caa2340849b6b28800cac506e4f40ed854cc849747da171bb2d65f3", "content": "This chunk is from Case Study H, which focuses on the inclusive practices implemented at St. John the Baptist Church of England Primary School to support a nursery child named John, who is on the autism spectrum. It highlights the nursery teacher's efforts to develop positive relationships with John's family to facilitate his successful transition into the nursery environment.He then played with the boats and once he was familiar with using the bath, she replaced the fabric with water.\nPositive and effective relationships\nP3 \u2013 Collaboration with parents and carers of autistic children and young people\nThe nursery teacher was clear about the \u2018 need to build a relationship with John\u2019s family as the parents are the child\u2019s first teachers\u2019. She established a close relationship inviting his mother into the classroom to support John. She was honest with his mother about her limited knowledge of autism and explained that she was attending autism training to be in a better position to help.\nBefore John started school, the nursery teacher made a home visit at 10 am every Monday morning with resources. ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 67, "split_id": 284, "split_idx_start": 147677, "_split_overlap": [{"doc_id": "466d95adad4cd4cdd8d860fb7dc64ab5416889b01c58c0fbad9383aebd8690de", "range": [394, 506]}, {"doc_id": "5402d23c73d736d6e3ddef91adfbad26058b1e300076052931e95a1a820a5c41", "range": [0, 112]}]}, "score": null, "embedding": [0.035483844578266144, -0.06124031916260719, -0.02603790909051895, 0.02833743952214718, -0.02495822124183178, 0.03231290727853775, 0.006049387156963348, -0.050369203090667725, -0.06613150238990784, 0.00665820948779583, 0.027629928663372993, -0.06779103726148605, 0.08556236326694489, -0.037007223814725876, -0.038714729249477386, -0.06993383169174194, 0.020494479686021805, 0.05987905338406563, -0.06507449597120285, 0.028712701052427292, -0.0057780505158007145, 0.02807573601603508, 0.027132518589496613, 0.0033190171234309673, 0.032570239156484604, -0.007988088764250278, -0.025662478059530258, 0.021875308826565742, 0.00834790337830782, -0.021701158955693245, 0.05062531679868698, -0.00909088272601366, 0.004838974680751562, -0.016714368015527725, 2.3434940885636024e-06, 0.035970088094472885, 0.016066614538431168, -0.01992887444794178, 0.02077067829668522, -0.03217320144176483, -0.03274377062916756, -0.0021786163561046124, 0.017765631899237633, 0.04913860931992531, 0.013705424033105373, 0.005703411530703306, -0.001197626581415534, 0.05544596537947655, -0.0041092634201049805, -0.022724775597453117, 