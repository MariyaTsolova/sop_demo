251875519753, -0.035185396671295166, -0.029358958825469017, 0.0031693391501903534, -0.045703187584877014, -0.008033310994505882, 0.0014647532952949405, -0.058265455067157745, -0.012340834364295006, -0.06857749819755554, 0.08999621123075485, -0.013357975520193577, 0.024317527189850807, -0.02908705361187458, -0.08432070165872574, 0.029079556465148926, -0.057692114263772964, 0.048549845814704895, 0.07949743419885635, -0.019054489210247993, -0.038589999079704285, 0.017951400950551033, 0.04521927237510681, 0.08848115801811218, 0.018062803894281387, -0.007140429690480232, 0.003018042305484414, 0.025637328624725342, -0.03803851455450058, 0.053020041435956955, 0.004370200447738171, -0.033840905874967575, 0.015365359373390675, 0.0033555286936461926, -0.014888119883835316, -0.0606389045715332, -0.011648040264844894, -0.01466335915029049, 2.2481003443464888e-34, -0.002867381554096937, 0.02023923769593239, 0.007229358423501253, -0.03621435910463333, 0.042242631316185, -0.006908237934112549, -0.05628429353237152, -0.0039142584428191185, 0.018751276656985283, -0.0212552510201931, -0.027897803112864494], "sparse_embedding": null}, {"id": "f3c562729343c38b7ce6bc696110040c9f45726c1636243f74a743673a4efb34", "content": "This chunk is part of Case Study A involving Tom, an 8-year-old autistic pupil at Watermore Primary School. It discusses the implementation of sensory calming strategies to alleviate Tom's anxiety, particularly at bedtime, and outlines the workforce development necessary for staff to effectively support autistic children through a calm and consistent approach.the sensory calming strategies were used just before bedtime to reduce his anxiety and enable him to fall asleep more quickly).\nP4 \u2013 Workforce development to support autistic children and young people\nAll staff at the school developed a consistent approach and remain calm and quiet when working with Tom. They use negotiation when introducing activities. Requests are made carefully by making suggestions rather than demands, using language such as, \u201cI wonder if we could \u2026?\u201d, \u201cHow about if we \u2026?\u201d, \u201cI\u2019m looking for someone to help me \u2026\u201d. This is detailed further in the next section.\n", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 5, "split_id": 16, "split_idx_start": 6789, "_split_overlap": [{"doc_id": "de6be2136972b6d3f022daf1afc1d14472ff6795ac0e95134d4df8e0451de09d", "range": [605, 733]}, {"doc_id": "3c592df8787a5c7c50b8ab3de39ad4c0d611ff7afb742a4929aeb02d036b162a", "range": [0, 46]}]}, "score": null, "embedding": [0.06553565710783005, -0.09203081578016281, -0.015473601408302784, -0.006208778824657202, -0.018457863479852676, 0.030256537720561028, 0.05920921638607979, -0.030134210363030434, -0.04669690877199173, -0.00806813221424818, 0.023427743464708328, -0.052960723638534546, -0.0015296470373868942, -0.058624040335416794, -0.008407440967857838, -0.03887990117073059, -0.0016857580048963428, 0.061542559415102005, 0.006682739593088627, 0.0013743145391345024, 0.0063607217743992805, 0.0024511737283319235, -0.02333037555217743, 0.03665997087955475, 0.032005131244659424, -0.03326309099793434, 0.015677640214562416, 0.023783229291439056, 0.03057529777288437, -0.055835120379924774, 0.03653568774461746, 0.008889741264283657, -0.025478122755885124, -0.032226257026195526, 2.3861794034019113e-06, 0.043067384511232376, 0.05198214203119278, -0.0027364548295736313, 0.020282123237848282, -0.04082806035876274, -0.0274224691092968, -0.023788582533597946, 0.014869038946926594, 0.04748447239398956, 0.008707950823009014, -0.022005310282111168, 0.03148850426077843, 0.07345860451459885, 0.0014936330262571573, -0.020484477281570435, -0.00659055495634675, 0.04053586721420288, -0.058597493916749954, -0.010353042744100094, 0.027187876