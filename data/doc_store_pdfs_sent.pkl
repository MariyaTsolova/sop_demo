, 0.004370009060949087, 0.0157206729054451, 0.056461166590452194, 0.03117792122066021, -0.02816479653120041, 0.011774718761444092, 0.01086464710533619, 0.053391192108392715, 0.037725094705820084, -0.030612949281930923, 0.0292596984654665, -0.06610268354415894, 0.019434534013271332, -0.02830924466252327, 0.05525372549891472, -0.016597099602222443, -0.027918197214603424, 0.028225550428032875, -0.01499141938984394, -0.0054476261138916016, -0.003506484441459179, -0.07165373116731644, 0.0017801042413339019, 1.8027561591371811e-34, -0.010070785880088806, 0.04087585210800171, 0.02645489200949669, -0.0464191734790802, -0.011616501025855541, -0.02538585290312767, -0.005278184078633785, 0.019233062863349915, 0.010786428116261959, -0.007028783671557903, -0.03813541308045387], "sparse_embedding": null}, {"id": "31dd0f96640fbbb53a5f241a1656c41a347e549e6e8c39394e40788525285372", "content": "This chunk is part of the AET Post-16 Standards Framework, specifically within Principle Seven: Targeted support and measuring the progress of autistic learners. It discusses the importance of collaborating with autistic learners to create individualized learner profiles and support plans, ensuring they are regularly reviewed to track progress effectively.They enable the autistic learner and staff to monitor progress, and they are reviewed regularly. ROOM FOR IMPROVEMENT\nROOM FOR IMPROVEMENT\nDEVELOPING DEVELOPING WE DO THIS REALLY WELL\nWE DO THIS REALLY WELL\nPrinciple Seven: Targeted support and measuring the progress of autistic learners.\nStandard Fourteen: We work with all autistic learners to complete a person-centred learner profile and specialist learner support plan in partnership with key staff members, and we ensure that these are regularly reviewed to monitor progress.\nROOM FOR IMPROVEMENT\nDEVELOPING WE DO THIS REALLY WELL\nExamples of how we do this: Link to statutory framework\nLearner profiles and specialist learner support plans are initiated promptly, focus on the academic and social, emotional curriculum, and include opportunities for autistic and non-autistic peer collaborations. ROOM FOR IMPROVEMENT\nDEVELOPING WE DO THIS REALLY WELL\fPost-16 Standards Framework\n43 Learning and development\nWhat has been the impact of implementing this standard?\n", "dataframe": null, "blob": null, "meta": {"file_path": "Post-16-Standards-Framework_T-HUB-Sc-Mt (1).pdf", "url": "https://drive.google.com/file/d/1J2sZ87itIDhKcF_wmZN2TcBeZRLjlMJP", "source_id": "8c4c774884107306cf77966fe0ff24690d0139f6223da0babe2c1bcd4b2a95b5", "page_number": 43, "split_id": 84, "split_idx_start": 52741, "_split_overlap": [{"doc_id": "c68fc0695c8bb9bc8927c08fc948ab79030a42d71076d6f5402837676a42c3e2", "range": [524, 621]}, {"doc_id": "809e4bf15fa2f4bd72c97deb5203630f6051c1333bc30129ce1d1a657882ae75", "range": [0, 167]}]}, "score": null, "embedding": [0.026702484115958214, -0.06669433414936066, -0.02448575757443905, -0.016933679580688477, -0.01975519023835659, -0.0024647442623972893, 0.0420946441590786, -0.02920309267938137, -0.06565160304307938, 0.0029609750490635633, 0.05057593062520027, -0.07061417400836945, -0.012984007596969604, 0.023144926875829697, 6.591695273527876e-05, -0.06486154347658157, 0.03373463451862335, 0.02101380005478859, -0.044129081070423126, 0.022822557017207146, 0.020811768248677254, 0.009297092445194721, -0.01450522243976593, 0.034010086208581924, 0.01938811130821705, 0.002144902478903532, 0.016188323497772217, 0.01143589150160551, 0.02363011986017227, -0.05414310470223427, 0.0351468026638031, 0.004145798739045858, 0.011898853816092014, 0.013257858343422413, 1.9308986338728573e-06, 0.01015151385217905, 0.012997687794268131, -0.008030498400330544, -0.009251372888684273, 0.015120886266231537, -0.06924989074468613, -0.02164226584136486, 0.03272014111280441, 0.06100950762629509, -0.01518781203776598, 0.005669691134244204, 0.0036316602490842342, 0.019602160900831223, -0.006636631675064564, -0.02512776106595993, -0.009331563487648964, 0.00723786605522