-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 54, "split_id": 238, "split_idx_start": 119973, "_split_overlap": [{"doc_id": "e81c431660ddd1c3d2b7987ec10ceed39449da6394b8178290d3fb7df4f6879c", "range": [682, 754]}, {"doc_id": "f2cfacf597bdd7f35c1a4c2f398e45b2456245164697c93e2616bb0511f9d059", "range": [0, 139]}]}, "score": null, "embedding": [0.005256074946373701, -0.08004540205001831, -0.026221217587590218, -0.018053049221634865, -0.03158640116453171, 0.025756875053048134, -0.012128512375056744, -0.011319469660520554, -0.044738005846738815, -0.0026211494114249945, 0.076287180185318, 0.004043675027787685, 0.042397018522024155, -0.0023820186033844948, 0.014059679582715034, -0.08664176613092422, 0.0008810604922473431, 0.02116735652089119, -0.07841389626264572, 0.06773506104946136, 0.0192385483533144, 0.00808335654437542, -0.02693942002952099, 0.035525914281606674, -0.05221807584166527, -0.013029061257839203, -0.013336791656911373, -0.03279802203178406, 0.06782287359237671, -0.03889334946870804, 0.013288705609738827, 0.01976807788014412, -0.011493857018649578, -0.00127848656848073, 2.1640732938976726e-06, 0.04093564674258232, -0.01589854247868061, -0.028630390763282776, -0.039140984416007996, 0.04431496188044548, -0.04467964544892311, 0.017732849344611168, 0.012604774907231331, 0.030443241819739342, -0.04946505278348923, -0.0104877520352602, 0.01406505424529314, -0.05419484153389931, 0.013649940490722656, -0.023389799520373344, 0.008410663343966007, -0.008160238154232502, -0.02124752104282379, -0.030500033870339394, -0.014506095089018345, -0.01813114993274212, 0.004087361972779036, -0.02506229281425476, 0.06975635886192322, 0.047391973435878754, -0.06011027842760086, 0.03462181240320206, 0.026108022779226303, -0.053809747099876404, 0.02444417029619217, 0.01589377410709858, 0.007802608888596296, -0.04164467379450798, 0.04510540887713432, 