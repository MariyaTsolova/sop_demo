l, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 41, "split_id": 174, "split_idx_start": 88596, "_split_overlap": [{"doc_id": "240511a639215fec1fc5f0c4b229964a7c4d213aee5dd0607828e1d64d78d705", "range": [314, 419]}, {"doc_id": "39511293e36440f5c2b60723f965aec61c15aa500c8795a24374ce301c832694", "range": [0, 179]}]}, "score": null, "embedding": [0.03222876787185669, -0.07439223676919937, -0.021149879321455956, 0.022444061934947968, 0.01509695965796709, 0.0306683462113142, -0.0012598922476172447, -0.05215863883495331, -0.04269629716873169, 0.0037426294293254614, 0.02897997945547104, -0.04673350974917412, 0.011967763304710388, 0.010829511098563671, -0.002367460634559393, -0.07380720227956772, 0.00017027242574840784, 0.007831771858036518, -0.03315972164273262, -0.0014076572842895985, 0.004956034477800131, 0.03533817455172539, -0.011873946525156498, 0.03241760656237602, 0.052777115255594254, -0.008100982755422592, 0.0018512050155550241, 0.02674393355846405, 0.043929073959589005, -0.026300126686692238, 0.024527747184038162, 0.0003519758756738156, -0.03470911085605621, 0.007876290939748287, 2.354826392547693e-06, 0.05492282286286354, 0.027410907670855522, -0.034441396594047546, -0.016048749908804893, -0.0277257077395916, -0.10372831672430038, 0.046321358531713486, 0.007416380103677511, 0.045435696840286255, -0.003112330101430416, -0.02596946805715561, 0.0005425739800557494, 0.03144869580864906, 0.02593602053821087, -0.024823063984513283, -7.995308260433376e-05, 0.028173215687274933, 0.02381412498652935, -0.028231022879481316, 0.0344415120780468, -0.019919855520129204, 0.0018691206350922585, -0.11774152517318726, 0.05292380601167679, 0.029698707163333893, -0.029649673029780388, 0.0407344214618206, -0.01311010867357254, -0.0713663250207901, 0.008557257242500782, -0.007588158827275038, 0.014664408