0810881853, 0.048877570778131485, 0.010918349027633667, 0.06003148853778839, 0.01205248199403286, 0.005017723888158798, -0.01440507359802723, -0.04971763864159584, 0.017612462863326073, 0.009893704205751419, 0.06297565996646881, 0.026204412803053856, -0.016768574714660645, 0.02119048871099949, 0.005924376193434, 0.04159173741936684, 0.01684819534420967, -0.028814852237701416, 0.0074472264386713505, -0.08247963339090347, 0.019492870196700096, -0.044245220720767975, 0.048586975783109665, -0.04014300927519798, -0.034911178052425385, 0.03152243047952652, -0.011774569749832153, -0.01038636825978756, 0.025184383615851402, -0.01375073753297329, -0.041430775076150894, 1.7421422061967626e-34, 0.024808447808027267, 0.013138015754520893, -0.002358135534450412, -0.10183286666870117, -0.0032181842252612114, -0.042713552713394165, -0.0060262903571128845, -0.001775048323906958, 0.02370142936706543, 0.01763737015426159, -0.03393863886594772], "sparse_embedding": null}, {"id": "9203db6c5ef51fd41767f4ce1e86717a112affe80cbcfa748a601e767014d473", "content": "This chunk is part of the \"Introduction\" section, which discusses the classification of special educational needs (SEND) as outlined in the SEND Code of Practice. It highlights the importance of recognizing that personal characteristics alone do not define a pupil's needs, emphasizing the necessity for a deeper understanding of individual pupils within the broader categories of need.Personal characteristics alone do not determine the presence, type, or complexity of special educational needs.\f7Special Educational Needs in Mainstream Schools 7\nINTRODUCTION\nBeyond simple classification\nThe SEND Code of Practice groups needs into four broad areas to support schools to plan the provision that they offer: \u2022 cognition and learning;\n\u2022 communication and interaction;\n\u2022 social, emotional, and mental health; and\n\u2022 sensory and physical needs. 11 Considering these primary needs is a useful first step, but a more detailed understanding of an individual child is required for action to be beneficial. Teachers should understand the individual characteristics of pupils\u2019 needs, and how these relate to their classroom environment and the content that they are teaching. There is variation within each of the four categories in the Code of Practice. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 8, "split_id": 26, "split_idx_start": 17254, "_split_overlap": [{"doc_id": "8d4e991de23fd091e856c5c39beb051bc19444f7095e6dc50770b21ee16b699e", "range": [541, 653]}, {"doc_id": "602a1e0380992d362271f1a83ea87470cd57c6b1d66f4986fa02d6d377d93fe0", "range": [0, 79]}]}, "score": null, "embedding": [0.023544777184724808, -0.08566119521856308, -0.012307009659707546, 0.01994669809937477, 0.005784061271697283, 0.03271767497062683, 0.04037592560052872, -0.03644653037190437, -0.00015258540224749595, -0.026671305298805237, 0.031869061291217804, -0.06369291990995407, 0.04534482955932617, -0.008595382794737816, 0.0014948920579627156, -0.11895745247602463, 0.005840947385877371, 0.015483276918530464, -0.031165719032287598, 0.037998270243406296, -0.03989560902118683, 0.023868417367339134, -0.03058416023850441, -0.011623453348875046, 0.002852559322491288, -0.048965971916913986, 0.004627335350960493, 0.008443845435976982, 0.027375780045986176, -0.006300631910562515, 0.06746260076761246, 0.06812678277492523, 0.03150039538741112, -0.05633803829550743, 2.3353934466285864e-06, 0.03749651461839676, 0.017729252576828003, -0.015209557488560677, -0.023695817217230797, -0.024336175993084908, -0.07480752468109131, -0.03447897359728813, 0.0525946319103241, 0.034656599164009094, 0.0049796197563409805, 0.017957445234060287, 0.03984072059392929, -0.019665749743580818, 0.