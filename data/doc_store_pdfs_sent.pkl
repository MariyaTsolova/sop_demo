651159100234509, 0.007182403467595577, -0.01189038623124361, 0.0026415472384542227, -0.0006459775613620877, -0.051208700984716415, 0.025998445227742195, -0.009908746927976608, -0.06904713064432144, 0.01709267497062683, 0.0127934655174613, 0.03685135766863823, -0.04846810922026634, -0.022692807018756866, 0.032264210283756256, 0.002674304647371173, 0.041415322571992874, -0.055729299783706665, -0.001845708116889, -0.001692421268671751, 2.0108584928791845e-34, -0.0016350764781236649, -0.0243320744484663, -0.008390307426452637, -0.0450153686106205, 0.03975503519177437, 0.0007850633701309562, -0.004099872894585133, 0.02629513293504715, 0.033875707536935806, 0.020320912823081017, -0.015861056745052338], "sparse_embedding": null}, {"id": "63b82c8888c85cfff0aadcbaec2210e3c12542708ae481cc493b5f842203de8b", "content": "This chunk is located in the section discussing strategies to enhance children's self-awareness as part of explicit SEL teaching. It emphasizes the importance of recognizing and expressing emotions through the use of a 'feelings display' in the classroom, helping children articulate their feelings and understand emotional vocabulary.It is okay to feel angry, for example, but not okay to act in ways that hurt others.\nCreate a \u2018feelings display\u2019 in the classroom (for example, feelings tree with the leaves as different feelings words, emoticon board, feelings wheel, poster or dictionary). The teacher can introduce the vocabulary in the display, and then use the display in many ways on an ongoing basis, for example:\n\u2022 \u2018You feel happy? Is there another word on our feelings tree that you could use?\u2019\n\u2022 \u2018We have learned a new feelings word today\u2013\nWhat does it mean to feel frustrated? Can you think of a time you might feel frustrated?\u2019\nTeachers can also use the display to support emotional expression, for example, by having children place their name or photo on a relevant emotion within the feelings display to indicate how they are feeling when they come into the classroom in the morning, or at the start of the afternoon. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Social_and_Emotional_Learning.pdf", "url": "https://drive.google.com/file/d/1ux2ZVY-H62jpu0xzPvuWIaW6mMGtPxRN", "source_id": "e8d637c88ad0e99d399f844be26e40bf15211fc84f01bf87ff947205064caf09", "page_number": 13, "split_id": 41, "split_idx_start": 29776, "_split_overlap": [{"doc_id": "4e42aa90694f41d9f0ffda841f80124130d7dfdeb7a7de51446580ccaaac55a6", "range": [769, 854]}, {"doc_id": "4d214bd0695cdf2bee2e44467682ef4937eaaa0e40e88d52835f49847075521e", "range": [0, 344]}]}, "score": null, "embedding": [0.0444745197892189, -0.07502081245183945, -0.006561477668583393, 0.042438048869371414, -0.021750491112470627, 0.05792104825377464, 0.038289252668619156, -0.03740258514881134, 0.03787265345454216, -0.002195553155615926, 0.022872816771268845, 0.03306211903691292, 0.010325985960662365, -0.021287936717271805, 0.013820420950651169, -0.10407692939043045, -0.016513241454958916, 0.08071155101060867, 0.027063902467489243, 0.0037129020784050226, 0.007250303402543068, 0.0253998301923275, -0.020250311121344566, 0.009900846518576145, -0.0682566687464714, -0.07531552761793137, -0.0227182786911726, 0.03525043651461601, 0.0003085433563683182, -0.048518676310777664, 0.015993263572454453, -0.0015067229978740215, 0.020540308207273483, -0.07848057895898819, 2.235565943919937e-06, -0.01918644830584526, -0.019876517355442047, -0.01573321595788002, 0.006001446861773729, 0.004536762833595276, 0.10511533170938492, -0.013049797154963017, 0.006180192809551954, 0.003253490198403597, 0.008493317291140556, -0.022481653839349747, 0.03343415632843971, 0.052685778588056564, 0.05057840049266815, 0.017889805138111115, 0.0010793927358463407, 0.00022616441128775477, -0.06412313133478165, -0.004932625684887171, 0.10148580372333527, 0.07897615432739258, 0.02521856315433979, -0.025060463696718216, 0.06314289569854736, -0.0597229078412056, -0.041122