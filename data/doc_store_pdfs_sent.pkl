, 0.07103156298398972, 0.01754377968609333, 0.009483624249696732, -0.018508736044168472, -0.0010850692633539438, 0.03685585781931877, -0.029094496741890907, 0.03387204557657242, -0.0016745373141020536, 0.09930731356143951, 0.022495262324810028, -0.014637432992458344, -0.00585699500516057, -0.020395655184984207, 0.046237435191869736, 0.024757949635386467, 0.020901508629322052, 0.07164926826953888, -0.027969904243946075, 0.011405016295611858, 0.015680361539125443, 0.028713328763842583, 0.042819470167160034, -0.016786962747573853, -0.013028220273554325, -0.06387799978256226, -0.015820050612092018, -0.010779566131532192, 0.05433179810643196, -0.037599317729473114, -0.024884838610887527, 0.011509865522384644, -0.02190917544066906, 0.0059300619177520275, -0.03740762174129486, -0.04879852011799812, -0.005283785983920097, 2.170050963282995e-34, -0.010942264460027218, -0.02836604230105877, 0.007941057905554771, -0.06238657608628273, -0.004548076540231705, -0.025067923590540886, 0.04189891740679741, -0.000180899296537973, 0.02459646947681904, 0.02475624904036522, -0.05153129994869232], "sparse_embedding": null}, {"id": "577c07718ea8bf851f64eaf5782ffba692aa11b75eabb7ee199a992dc6ae0e61", "content": "This chunk is part of the section discussing effective deployment and support for teaching assistants (TAs) within mainstream schools. It highlights the resources available on the Maximising the Impact of Teaching Assistants website, aimed at enhancing TAs' effectiveness in supporting pupils with special educational needs and disabilities (SEND). Rebecca Pentney shares practical insights on implementing scaffolding frameworks to improve TA-pupil interactions.The Maximising the Impact of Teaching Assistants website (http://maximisingtas.co.uk) is a rich source of free resources to support evidence-based TA deployment, including: \u2022 professional standards for TAs;\n\u2022 the Teaching Assistant Deployment Review Guide; and\n\u2022 guidance for leaders and managers in the further education and training sector of effective TA deployment created by the EEF and the Education and Training Foundation. Rebecca Pentney, Research Lead at Littleport Community Primary School, explains how her school has worked to improve TA-\npupil interactions. \u2018We used the scaffolding framework contained in the EEF\u2019s TA guidance to support TAs\u2019 interactions with pupils. This practical framework is designed to help TAs scaffold pupils\u2019 learning and support the development of independence. We made the framework a key feature of our approach to deploying and supporting TAs. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 39, "split_id": 140, "split_idx_start": 87633, "_split_overlap": [{"doc_id": "e21f1d49bb97f195a40fd5bca91ec24a5f5e958b6de4297933977fde83c22101", "range": [785, 1216]}, {"doc_id": "36b3dd17e59b8eabf3d3971f031fd6a0606b70a149e499df298dd3151ee7df5d", "range": [0, 85]}]}, "score": null, "embedding": [0.03872133418917656, -0.11498960852622986, -0.018776247277855873, -0.01492194551974535, 0.016542240977287292, 0.0030482036527246237, 0.035242583602666855, -0.06720016151666641, -0.01817416213452816, 0.004342507570981979, 0.044773101806640625, -0.015299892984330654, 0.03706120327115059, -0.007753715384751558, 0.027236392721533775, -0.1341874748468399, -0.004500226583331823, 0.0062689767219126225, -0.0648459941148758, 0.024700310081243515, 0.015219269320368767, -0.0020028494764119387, -0.024535804986953735, 0.017245592549443245, -0.007764638401567936, -0.031024014577269554, -0.014564390294253826, 0.010398317128419876, 0.0471445769071579, 0.026430930942296982, 0.016796862706542015, 0.02825368568301201, 0.0014752692077308893, -0.014805917628109455, 2.3777383830747567e-06, 0.06350437551736832, 0