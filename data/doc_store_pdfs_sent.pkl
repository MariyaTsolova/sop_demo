r own board to find out what is going to happen next. ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 29, "split_id": 116, "split_idx_start": 59207, "_split_overlap": [{"doc_id": "f39ae499b431d3c709279468f32218b336698fc48cc35de814b60b5f76472cdc", "range": [437, 491]}, {"doc_id": "7c775ba7fa1300c64db702205c681e9e752bae6d837ebe56c73793e387487959", "range": [0, 91]}]}, "score": null, "embedding": [0.019238052889704704, -0.06751177459955215, -0.029337400570511818, 0.01914600096642971, -0.03279931843280792, 0.004908072762191296, 0.06070397049188614, -0.05530333146452904, -0.03394756838679314, 0.007318243850022554, 0.03167475387454033, -0.03336767107248306, -0.013532360084354877, 0.019697321578860283, -0.041488539427518845, -0.0880960077047348, 0.013006922788918018, 0.008399197831749916, -0.04441147670149803, 0.029161280021071434, -0.016616148874163628, 0.013965170830488205, -0.037235815078020096, 0.06825567781925201, -0.016200745478272438, -0.055682338774204254, 0.02290857955813408, -0.006803105119615793, 0.02388148196041584, -0.05091520771384239, -0.004239024594426155, 0.016846641898155212, 0.01344691775739193, 0.03187840059399605, 2.181217041652417e-06, 0.0064752474427223206, 0.030226364731788635, -0.035409603267908096, -0.051581546664237976, -0.03306787833571434, -0.053251538425683975, -0.01509749423712492, 0.030016617849469185, 0.02802121266722679, -0.016241474077105522, 0.025651589035987854, 0.051799189299345016, 0.055989302694797516, -0.028975680470466614, -0.04428809508681297, -0.0114007368683815, 0.07512343674898148, -0.007126104086637497, -0.01980425789952278, 0.03958655148744583, -0.01879604160785675, -0.0036059459671378136, 0.0040559470653533936, 0.07287098467350006, 0.023020654916763306, -0.04101622477173805, 0.034908730536699295, 0.0052827126346