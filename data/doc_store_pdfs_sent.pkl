05, -0.0687960684299469, 0.0005556776886805892, 0.0301612988114357, 0.023354671895503998, 0.02004757709801197, -0.024148069322109222, -0.0031644010450690985, -0.03423689678311348, 0.007127606775611639, -0.03364195302128792, 0.07478009164333344, 0.010557254776358604, -0.02475312165915966, -0.0028772526420652866, 0.010518263094127178, -0.0074371942318975925, -0.03806421533226967, -0.06848874688148499, 0.017812121659517288, 1.996228179986255e-34, 0.0011347379768267274, 0.030637960880994797, 0.01099319662898779, -0.07491283863782883, 0.01343071460723877, 0.005335908383131027, -0.013670460321009159, 0.01170613057911396, 0.0027196218725293875, -0.012199980206787586, -0.01944258064031601], "sparse_embedding": null}, {"id": "20aab161beb5beee1f429109c5bc8b6a1f26aee4969720636248cf652c9e3a39", "content": "This chunk is part of the section discussing the importance of preparing autistic learners for employment within the AET Post-16 Standards Framework. It emphasizes the need for colleges to focus on developing skills valued by employers and tailoring support for learners with Special Educational Needs (SEN) to enhance their employability.The vast majority of young people with SEN are capable of sustainable paid employment with the right preparation and support. All professionals working with them should share that presumption. Colleges that offer courses which are designed to provide pathways to employment should have a clear focus on preparing learners with SEN for work. This includes identifying the skills that employers value, and helping young people to develop them (SEND Code of Practice, 2015:131). Learning Support Staff find out what adjustments to activities, lessons, timetables, assessment, exams and delivery they need to make for autistic learners. ", "dataframe": null, "blob": null, "meta": {"file_path": "Post-16-Standards-Framework_T-HUB-Sc-Mt (1).pdf", "url": "https://drive.google.com/file/d/1J2sZ87itIDhKcF_wmZN2TcBeZRLjlMJP", "source_id": "8c4c774884107306cf77966