culum.\nS14. ", "dataframe": null, "blob": null, "meta": {"file_path": "Post-16-Standards-Framework_T-HUB-Sc-Mt (1).pdf", "url": "https://drive.google.com/file/d/1J2sZ87itIDhKcF_wmZN2TcBeZRLjlMJP", "source_id": "8c4c774884107306cf77966fe0ff24690d0139f6223da0babe2c1bcd4b2a95b5", "page_number": 12, "split_id": 34, "split_idx_start": 17161, "_split_overlap": [{"doc_id": "ab830a94481d665b5bc1abb96f9465acbf85f831561753bde2f67a5611f31bae", "range": [444, 449]}, {"doc_id": "0e3ae78767c41770efebe12cadff540534d57afa5a7aec78caea6518b1bd7f02", "range": [0, 5]}]}, "score": null, "embedding": [0.015310855582356453, -0.05258788540959358, -0.0256623737514019, -0.003069909056648612, -0.00046218844363465905, 0.025456242263317108, 0.01701468974351883, -0.06555507332086563, -0.05526024475693703, 0.031057527288794518, 0.025088338181376457, -0.06701288372278214, -0.01172672025859356, -0.0021647829562425613, -0.015713922679424286, -0.058980025351047516, 0.03195863962173462, 0.03208242729306221, 0.006988055072724819, 0.03274039551615715, -0.007921626791357994, 0.03028101846575737, -0.03383909538388252, 0.03969273343682289, 0.024072637781500816, -0.020404472947120667, 0.032528020441532135, -0.027230558916926384, 0.015650462359189987, -0.0466429740190506, 0.0241696760058403, 0.0005108650075271726, 0.01749497465789318, 0.01668551191687584, 2.375197709625354e-06, 0.003993358928710222, -0.006724522449076176, -0.01974872313439846, 0.0005276998854242265, -0.02393725886940956, -0.031111635267734528, 0.025398969650268555, 0.04602332413196564, 0.08015595376491547, -0.016068635508418083, -0.015044941566884518, 0.007451584562659264, 0.03209872543811798, -2.234512248833198e-05, 0.00391317019239068, -0.0061851805076003075, 0.014921346679329872, 0.032512370496988297, -0.05101040378212929, -0.022528434172272682, -0.00042966569890268147, 1.9892491764039733e-05, -0.06587102264165878, 0.04432563856244087, 0.02404255047440529, -0.02704051323235035, 0.029127417132258415, 0.013761898502707481, -0.0324559025466