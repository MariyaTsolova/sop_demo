dding": null}, {"id": "c38c1ed972bd748edfa17b56dc7c601332f09a37f0a93e4ab9772d8a7aec5f44", "content": "This chunk is situated within the \"Learning and Development\" section of the AET Post-16 Standards Framework. It discusses the importance of using and selecting appropriate accreditation to enhance progression for autistic learners. Additionally, it emphasizes the need for reviewing outcome and destination data to assess the effectiveness of educational programs.The use and choice of accreditation supports progression. We review outcome and destination data to evaluate the effectiveness of study programmes.\nROOM FOR IMPROVEMENT\nDEVELOPING WE DO THIS REALLY WELL\fPost-16 Standards Framework\n41 Learning and development\nWhat has been the impact of implementing this standard?\nOn autistic learners:\nOn parents/carers:\nOn staff:\nHow do we document evidence of working on this standard? We document evidence of working on this standard through assessment results, the production of resources, case studies, learner profiles, and the goals we co-\ncreate with autistic learners and parents/carers (where appropriate/possible), and by documenting our reasonable adjustments and the impact of those.\n", "dataframe": null, "blob": null, "meta": {"file_path": "Post-16-Standards-Framework_T-HUB-Sc-Mt (1).pdf", "url": "https://drive.google.com/file/d/1J2sZ87itIDhKcF_wmZN2TcBeZRLjlMJP", "source_id": "8c4c774884107306cf77966fe0ff24690d0139f6223da0babe2c1bcd4b2a95b5", "page_number": 41, "split_id": 81, "split_idx_start": 50882, "_split_overlap": [{"doc_id": "d183314e2502c1b4f50c01e75296ce54cc4f967a4e3eafe2951f04636130313e", "range": [879, 937]}, {"doc_id": "db6cd478a9a3277c73401ebdfca0cb3edafde27d0c6a8adbfdd0dfb81996703f", "range": [0, 309]}]}, "score": null, "embedding": [0.003715257393196225, -0.07758262008428574, -0.010701981373131275, -0.004094691015779972, 0.014173340052366257, 0.043203845620155334, 0.030899403616786003, -0.03075055591762066, -0.046545062214136124, 0.007216803