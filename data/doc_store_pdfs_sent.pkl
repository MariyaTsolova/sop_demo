73, 0.006880354136228561, 0.020802978426218033, -0.04729357734322548, 0.03278947249054909, -0.0044313641265034676, 0.06423288583755493, -0.05456473305821419, 0.0015086806379258633, 0.030652198940515518, -0.06455069035291672, 0.014966812916100025, -0.02129865624010563, 0.043202050030231476, -0.02011929452419281, 0.010051543824374676, 0.006655883975327015, 0.01737203821539879, 0.020786019042134285, 0.028325628489255905, -0.02231924794614315, 0.044495679438114166, -0.04488053917884827, 0.007560069672763348, -0.05679195001721382, 0.06602109223604202, -0.013348049484193325, -0.020346006378531456, -0.007811723742634058, 0.006338287610560656, -0.016386615112423897, -0.03566768020391464, -0.059166837483644485, 0.0013497060863301158, 2.0284048123638707e-34, 0.0011305371299386024, -0.02150006592273712, 0.030040336772799492, -0.09756503999233246, -0.01956457830965519, 0.00792723335325718, 0.009554527699947357, 0.0009926460916176438, -0.011335541494190693, -0.038429614156484604, -0.009167208336293697], "sparse_embedding": null}, {"id": "b4f6a951e4c6a50a92d765710fa3969f33f6b4455f8ad82c94e57b7b33720ce9", "content": "This chunk is located within the section discussing Principle Seven of the AET Schools Standards Framework, which focuses on targeted support and measuring the progress of autistic pupils. It emphasizes the importance of tailoring support to individual strengths and needs, aligning with the SEND Code of Practice, and outlines methods for documenting and assessing the effectiveness of these practices.The support provided to an individual should always be based on a full understanding of their particular strengths and needs and seek to address them all (SEND Code of Practice, 2014:96).\fSchools Standards Framework42 Learning and Development\nHow do we document evidence of working on this standard? We document evidence of working on this standard through case studies, one page profiles, and the goals we co-produce with parents/carers and children (where possible), and by documenting our reasonable adjustments and the impact of those.\nEvidence to show how we meet this standard:\nWhat has been the impact of implementing this standard?\nOn staff:\nOn parents/carers:\nOn autistic pupils:\fSchools Standards Framework43 Learning and Development\nPrinciple Seven: Targeted support and measuring the progress of autistic pupils.\n", "dataframe": null, "blob": null, "meta": {"file_path": "aet-schools-standards-framework.pdf", "url": "https://drive.google.com/file/d/166LzAs4UUYY2nmfvEFE7NUcJyEIfBoc3", "source_id": "fd3b04f3804d8efbea64fc291fd78f2aefe37cddffb9972efcc9615a49cfdf8c", "page_number": 41, "split_id": 78, "split_idx_start": 44048, "_split_overlap": [{"doc_id": "98d58508d90d707090c4e845d4b24ca984776b695ed1e3719d6847b2ff86ae17", "range": [916, 1104]}, {"doc_id": "d915d4eec896e4107c30d17c7765d286ba86239f5ad898745741970ddc9e76b1", "range": [0, 185]}]}, "score": null, "embedding": [0.026001842692494392, -0.1293812096118927, 0.0003280597447883338, 0.01132905948907137, -0.02715512178838253, 0.04841754958033562, 0.031469184905290604, -0.022842923179268837, -0.07045363634824753, -0.007311462890356779, 0.08165974915027618, -0.050069861114025116, 0.04719826579093933, 0.004830414894968271, 0.030091794207692146, -0.05264885351061821, 0.02638610079884529, 0.03735852241516113, -0.023952316492795944, 0.03191578388214111, -0.005491502117365599, 0.012704935856163502, -0.02849225513637066, 0.037582725286483765, 0.010717730037868023, -0.0241857822984457, 0.020838959142565727, 0.014057330787181854, 0.00104677549097687, -0.05014124885201454, 0.024890290573239326, 6.370574556058273e-05, -0.0065009137615561485, -0.05837399885058403, 2.126587787643075e-06, 0.024858810007572174, 0.006494333501905203, 0.004366185981780291, -0.014126738533377647, 0.02309630811214447, -0.052169814705848694, 0.030016886070370674, 0.0069751678965985775, 0.06680522859096527, 0.0028025638312101364, -0.01623418554663658, 0.013480751775205135, 0.018796978518366814, -0.009967605583369