, 0.043271083384752274, 0.033933375030756, 0.017132936045527458, -0.010492902249097824, -0.06215113773941994, 0.01294358167797327, -0.0213575828820467, 0.05663561820983887, 0.0008261952898465097, -0.0027973551768809557, 0.01906662993133068, -0.009991980157792568, 0.028262052685022354, 0.005429617594927549, -0.0405842587351799, 0.001235403586179018, 1.6792881559163102e-34, 0.003230823203921318, -0.008205892518162727, 0.02582009881734848, -0.046636492013931274, -0.017263153567910194, 0.004612730350345373, 0.024738749489188194, 0.010413995943963528, -0.0012891165679320693, 0.042867597192525864, -0.03224446251988411], "sparse_embedding": null}, {"id": "ceed76feebe4a29c8bff5336f36439db654a92334c181dba7b01e78d2aa78b6c", "content": "This chunk is part of Case Study E, which focuses on Priestnall Secondary School's inclusive practices for autistic students. It highlights the deployment and monitoring of Teaching Assistants (TAs) to meet individual student needs, ensuring that urgent support is provided efficiently while also allowing TAs to engage in professional development and training.Some students have TA support for the whole time. The TAs are deployed according to individual need. If a student that a TA is supporting is absent, then the TA goes go to a Board in the office and Julie will have marked with a red sticker any other students who are in urgent need in that lesson (or with orange and green stickers for less urgent students). A blue sticker is used to show the TA can engage in some online training and a yellow sticker denotes admin time.\nThere are some good autism courses online. ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 41, "split_id": 177, "split_idx_start": 89856, "_split_overlap": [{"doc_id": "b8e5bec0810fdefdad6064a2deb0facf8158eb72889