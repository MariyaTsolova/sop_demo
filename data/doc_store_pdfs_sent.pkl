], "sparse_embedding": null}, {"id": "079ad55efdb193e2b5a5521976794fdbe4306ae6f292592d9f5d9d6dea8ceeb3", "content": "This chunk is part of Recommendation 4 within the guidance report that emphasizes the importance of using a SAFE curriculum\u2014Sequential, Active, Focused, and Explicit\u2014for teaching social and emotional learning (SEL) skills. It discusses the need to establish supportive schoolwide norms, align behavior policies with SEL, and engage parents in the learning process.\u2022 Be explicit: clearly identify the skills that are being taught and why they are important. Page 26\nUse a SAFE curriculum: Sequential, Active, Focused and Explicit\n4\nS\nA\nF\nE\n\u2022 Establish schoolwide norms, expectations and routines that support children\u2019s social and emotional development.\n\u2022 Align your school\u2019s behaviour and anti-bullying policies with SEL.\n\u2022 Seek ideas and support from staff and pupils in how the school environment can be improved.\n\u2022 Actively engage with parents to reinforce skills in the home environment. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Social_and_Emotional_Learning.pdf", "url": "https://drive.google.com/file/d/1ux2ZVY-H62jpu0xzPvuWIaW6mMGtPxRN", "source_id": "e8d637c88ad0e99d399f844be26e40bf15211fc84f01bf87ff947205064caf09", "page_number": 11, "split_id": 33, "split_idx_start": 24814, "_split_overlap": [{"doc_id": "eb97c42666b15a98e408ff45ee0f1490d88f64c760c59519cbd2f4187b2219bc", "range": [305, 398]}, {"doc_id": "54c1a8c6c0ce0ff6363e7e6502591b3f68ba09835f0f0d84a6399c7ef326a949", "range": [0, 76]}]}, "score": null, "embedding": [0.05279289931058884, -0.0947435274720192, 0.006715808995068073, -0.016935501247644424, -0.0049867164343595505, 0.046125512570142746, 0.02888617105782032, -0.04191255941987038, 0.02098817192018032, -0.009771491400897503, 0.008427205495536327, -0.028640666976571083, 0.0060951546765863895, 0.008892996236681938, 0.015486558899283409, -0.06490889936685562, 0.00410305382683