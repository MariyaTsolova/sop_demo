aking them feel, and to understand the feelings of other people involved in the situation. 2. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Social_and_Emotional_Learning.pdf", "url": "https://drive.google.com/file/d/1ux2ZVY-H62jpu0xzPvuWIaW6mMGtPxRN", "source_id": "e8d637c88ad0e99d399f844be26e40bf15211fc84f01bf87ff947205064caf09", "page_number": 18, "split_id": 59, "split_idx_start": 42044, "_split_overlap": [{"doc_id": "8f5b1d571dbc7c8adcc0ee9de32cd895e90d8669a94634363a7a73f9ef83ad63", "range": [721, 842]}, {"doc_id": "698130a2753396340b504378cb4fc3b2141a6fd5b7f8c7ba18b80b30132864f9", "range": [0, 3]}]}, "score": null, "embedding": [0.04332560673356056, -0.07699347287416458, -0.009333319030702114, 0.01947939582169056, -0.005402697715908289, 0.04138140007853508, 0.024950644001364708, -0.046443138271570206, 0.035885896533727646, 0.018771614879369736, 0.014659877866506577, 0.012057515792548656, 0.005992994178086519, 0.008078796789050102, -0.01623542420566082, -0.07491440325975418, -0.0021854760125279427, 0.03497017174959183, 0.06551428884267807, -0.004417483229190111, 0.017856629565358162, -0.01208787877112627, -0.015121795237064362, -0.027036216109991074, -0.01978182978928089, -0.02456608973443508, -0.025444665923714638, 0.014099524356424809, 0.023229306563735008, -0.04525887966156006, 0.05824204906821251, 0.018802771344780922, 0.0021801681723445654, -0.014755279757082462, 2.276875420648139e-06, -0.01458202674984932, -0.02598804235458374, -0.042236506938934326, 0.022921813651919365, -0.026536818593740463, 0.03882334753870964, -0.04115636646747589, 0.033671725541353226, 0.020252320915460587, -0.01304155495017767, 0.01169214490801096, 0.055377501994371414, 0.06738010793924332, 0.06740052998065948, -0.009233400225639343, 0.011898906901478767, 0.01608881540596485, -0.05340487137436867, -0.01770772971212864, 0.05106193199753761, -0.020255161449313164, 0.0016159951919689775, 0.03259774670004845, 0.115272656083107, -0.0576750710606575, -0.03540314361453056,