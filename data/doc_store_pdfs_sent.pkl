001495, -0.009570702910423279, -0.027555687353014946, -0.006032893434166908, 0.008258874528110027, 0.024148432537913322, 0.05229272320866585, 0.0557369664311409, -0.013555002398788929, 0.035188913345336914, 0.00573967769742012, 0.038636136800050735, 0.013857751153409481, -0.010113784112036228, 0.006129843648523092, -0.08039206266403198, 0.015428164042532444, -0.014618603512644768, 0.07023580372333527, -0.06058153510093689, -0.018172768875956535, 0.009647186845541, -0.029463719576597214, 0.02385461889207363, -0.03025280311703682, -0.03860989585518837, -0.00819701049476862, 2.2411628613779737e-34, 5.846449130331166e-05, -0.033981699496507645, -0.013111647218465805, -0.14815935492515564, -0.006872282829135656, -0.035990502685308456, 0.03200786933302879, -0.010207543149590492, -0.001968994503840804, -0.015392856672406197, -0.04478122666478157], "sparse_embedding": null}, {"id": "10b14adab5ad0ac834eb5a27e1b5571d9afc9839354531314a5856837656f5d2", "content": "This chunk is located in the \"Introduction\" section of the guidance report, which emphasizes the collective responsibility of school leaders and teachers in supporting all pupils, including those with Special Educational Needs and Disabilities (SEND). It highlights the importance of the Special Educational Needs Coordinator (SENCo) without undermining the role of classroom teachers.The SENCo has an important role in the development of a school\u2019s approach, but ensuring all pupils achieve\u2014including those with SEND\u2014is everyone\u2019s responsibility. If the SENCo takes sole responsibility, there is a risk of de-\nskilling school leaders and classroom teachers who can subsequently lose confidence in supporting pupils with SEND. We hope that this guidance can empower the classroom teacher by demonstrating that many of the skills required are those they are already developing in their teaching for all pupils. There are additional audiences who might find this guidance useful.\n\u2022 School governors can use the guidance to support and challenge their school leadership on SEND. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 5, "split_id": 12, "split_idx_start": 7423, "_split_overlap": [{"doc_id": "60dd9e37c6d6aaed294a7b0df03650f11bb2080753e2a5f43896801d5aa2c2d3", "range": [495, 658]}, {"doc_id": "ac74a939422b735a7ac09eb7226b580248a2dc3163d6e3e127879c5637b867ae", "range": [0, 98]}]}, "score": null, "embedding": [0.04482923075556755, -0.06713179498910904, -0.01796046644449234, 0.011711051687598228, 0.030628224834799767, 0.043718427419662476, 0.03755585476756096, -0.04597661271691322, 0.016796743497252464, 0.0011480206158012152, 0.04475495219230652, -0.049706485122442245, 0.043642621487379074, -0.01675758697092533, 0.021085523068904877, -0.07330827414989471, -0.008522382006049156, 0.03315937891602516, -0.03439825400710106, 0.024080738425254822, -0.03258086368441582, 0.020280582830309868, -0.01030197273939848, 0.02062205970287323, -0.001697681494988501, -0.04943195730447769, 0.025551093742251396, 0.052828747779130936, 0.013533626683056355, -0.0199651550501585, 0.1009833812713623, 0.015246282331645489, 0.016198832541704178, -0.05584157258272171, 2.337526211704244e-06, 0.043982960283756256, 0.04148999974131584, -0.012990470044314861, 0.009024952538311481, -0.01923978328704834, -0.11442845314741135, -0.0511297807097435, -0.011287516914308071, 0.043739739805459976, 0.00819774903357029, 0.09251224994659424, -0.0013571847230196, -0.03298173099756241, -0.005301508121192455, -0.010275238193571568, -0.011912166140973568, -0.00911277811974287, -0.017292436212301254, -0.028208022937178612, 0.0304364413022995, 0.0066566490568220615, -0.026638342067599297, -0.06575444340705872, -0.037056758999824524, -0.0027532244566828012, -0.00401