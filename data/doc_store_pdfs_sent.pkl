ng": null}, {"id": "329cf85aa9cb829166d82564135df9973af79b144fc47971696c0ca34615e77e", "content": "This chunk is from Case Study A, which focuses on the strategies used at Watermore Primary School to support an autistic pupil named Tom. It highlights adaptations made during transitions and differentiated work tailored to Tom's interests, demonstrating personalized approaches to enhance his engagement and learning in the classroom.During transition times, he goes to his room first and then moves to the next activity.\nTom has differentiated work. The TA might reword the question in English or adapt the Maths questions. His own interests are used to engage him ( e.g. Tom is given the option to write about Minecraft instead of Egypt.)\n", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 7, "split_id": 30, "split_idx_start": 11993, "_split_overlap": [{"doc_id": "74dd621fd4ddc3546eb5a2d0a40adcaf8ed159de91bbd794eb745705b6eab705", "range": [302, 390]}, {"doc_id": "9f9398f2ede1037ff2e3654664c817aaf6a9573dae9a81fb2becd3c2de0d3f3a", "range": [0, 68]}]}, "score": null, "embedding": [0.0440891869366169, -0.07014071196317673, -0.04505639895796776, 0.013466207310557365, -0.0419432669878006, 0.010926020331680775, 0.07689409703016281, -0.06537335366010666, -0.08967798948287964, 0.016535377129912376, 0.03620032221078873, -0.02925671450793743, 0.014784816652536392, 0.010314026847481728, -0.021040555089712143, -0.08131322264671326, 0.023127272725105286, -0.014843382872641087, -0.05574244633316994, 0.02305043861269951, -0.036523763090372086, -0.0058526406064629555, -0.014011090621352196, 0.055075667798519135, 0.06122502312064171, -0.06561043113470078, -0.006891930475831032, 0.018170759081840515, 0.04646548256278038, -0.012611081823706627, 0.062009453773498535, 0.04418851062655