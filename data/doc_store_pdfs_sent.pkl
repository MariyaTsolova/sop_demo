embedding": null}, {"id": "cfb2d31a7d50aed47308a44066fe682b50630ec09a339a711f64516fe72ffea5", "content": "This chunk is part of the guidelines in Section 6 of the AET Post-16 Standards Framework, which outlines the process for using the standards effectively. It emphasizes the importance of creating a structured action plan that highlights necessary improvements, assigns responsibilities, sets time frames, and tracks progress to enhance Good Autism Practice within Post-16 educational settings.Create a Next Steps Action Plan for the standards you are focusing on by documenting your actions for the standards that need improvement. 4. Include specified time frames and nominated team members for implementation of this. 5. Collect data before and after so you can document the progress of implementing the standard.\f", "dataframe": null, "blob": null, "meta": {"file_path": "Post-16-Standards-Framework_T-HUB-Sc-Mt (1).pdf", "url": "https://drive.google.com/file/d/1J2sZ87itIDhKcF_wmZN2TcBeZRLjlMJP", "source_id": "8c4c774884107306cf77966fe0ff24690d0139f6223da0babe2c1bcd4b2a95b5", "page_number": 7, "split_id": 15, "split_idx_start": 9504, "_split_overlap": [{"doc_id": "271ee6bb9bec082c1bb4a1a09c35d57688d4b0a23a0e1c45db16d871b127b8b8", "range": [160, 299]}, {"doc_id": "4ce83be3d72fd770a3610e1f76bcfeddfa08d9c2417a4078de2b01d4d30d28f6", "range": [0, 93]}]}, "score": null, "embedding": [0.023763855919241905, -0.0706912949681282, -0.011183553375303745, -0.0040567838586866856, 0.0038723486941307783, 0.018307236954569817, -0.021479981020092964, -0.014787448570132256, -0.04119246453046799, -0.020073674619197845, 0.06565188616514206, -0.05467292293906212, 0.017499050125479698, 0.03542422503232956, -0.019684206694364548, -0.06132584065198898, 0.029380327090620995, 0.018538331612944603, -0.03259030357003212, 0.008675642311573029, 0.014494480565190315, 0.029304491356015205, -0.02398604527115822, 0.02963542565703392, 0.007777647580951452, -0.003244769526645541, -0.0054748449474573135, 0.0