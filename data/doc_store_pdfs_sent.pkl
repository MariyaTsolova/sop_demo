, -0.011608500964939594, -0.058627936989068985, 0.032385215163230896, -0.0385003387928009, 0.03895892947912216, -0.0026036417111754417, -0.0323277972638607, -0.01964433304965496, 0.006959666032344103, 0.009473484009504318, 0.03537243977189064, -0.04375180974602699, 0.004737331531941891, -0.054767806082963943, 0.00569113390520215, -0.03119845874607563, 0.0560334250330925, -0.024330900982022285, -0.0429353341460228, 0.02902044914662838, 0.0053549581207334995, 0.0029555396176874638, -0.05117029696702957, -0.04363715648651123, -0.007979923859238625, 1.790347117307573e-34, 0.024139994755387306, -0.024667585268616676, 0.038059256970882416, -0.047454703599214554, 0.011574876494705677, -0.007739602122455835, 0.0010685533052310348, -0.009696324355900288, 0.0020478193182498217, 0.0023671055678278208, -0.030392559245228767], "sparse_embedding": null}, {"id": "9f9d89810c079bd89203f6867541306fae8317c53d21ed50c7c6b37b68627562", "content": "This chunk is part of the AET Post-16 Standards Framework, specifically under Principle Six, which focuses on creating an inclusive environment for autistic learners. It discusses the importance of fostering a calm, low-arousal learning environment and includes criteria for assessing the implementation of this standard, highlighting the role of key support personnel for learners.ROOM FOR IMPROVEMENT\nROOM FOR IMPROVEMENT\nDEVELOPING DEVELOPING WE DO THIS REALLY WELL\nWE DO THIS REALLY WELL\nPrinciple Six: An ethos and environment that fosters social inclusion for autistic learners.\nStandard Eleven: Our enabling approaches foster a calm, low-arousal learning environment and we promote a sense of wellbeing, security, and belonging for all our autistic learners.\nROOM FOR IMPROVEMENT\nDEVELOPING WE DO THIS REALLY WELL\nExamples of how we do this: Link to statutory framework\nAutistic learners have an identified key person with whom they can arrange 1:1 meetings.\nROOM FOR IMPROVEMENT\nDEVELOPING WE DO THIS REALLY WELL\fPost-16 Standards Framework\n36 Enabling environments\nWhat has been the impact of implementing this standard?\nOn autistic learners:\nOn parents/carers:\nOn staff:\nHow do we document evidence of working on this standard? ", "dataframe": null, "blob": null, "meta": {"file_path": "Post-16-Standards-Framework_T-HUB-Sc-Mt (1).pdf", "url": "https://drive.google.com/file/d/1J2sZ87itIDhKcF_wmZN2TcBeZRLjlMJP", "source_id": "8c4c774884107306cf77966fe0ff24690d0139f6223da0babe2c1bcd4b2a95b5", "page_number": 36, "split_id": 73, "split_idx_start": 45271, "_split_overlap": [{"doc_id": "138851026035d9e507cb1829855f4bb8283a3c5949844b75027909be14e11bb0", "range": [405, 608]}, {"doc_id": "079db32151f67c60a6c2ba71b33f7eff9c046ba40080848e630767dc785a4de3", "range": [0, 108]}]}, "score": null, "embedding": [0.030445579439401627, -0.1207762137055397, -0.021953674033284187, 0.010408691130578518, 0.015083514153957367, 0.03574521094560623, 0.03702617064118385, -0.03364330530166626, -0.04705014452338219, -0.0008680433966219425, 0.029863106086850166, -0.06238149106502533, 0.017377786338329315, 0.007581667974591255, 0.01215877290815115, -0.07085581868886948, 0.04882612079381943, 0.04623200371861458, -0.030619941651821136, 0.014408867806196213, 0.0014614633983001113, 0.010723749175667763, -0.021038832142949104, 0.02793474681675434, 0.04147293418645859, -0.0041131447069346905, 0.013078308664262295, 0.01842566952109337, 0.017677834257483482, -0.03782971203327179, 0.025787418708205223, -0.008642185479402542, 0.014070970937609673, -0.022822514176368713, 2.162571036024019e-06, 0.0076353661715984344, 0.023305710405111313, -0.020731430500745773, 0.020183170214295387, -0.024656888097524643, -0.053377024829387665, 0.018855005502700806, 0.020138820633292198, 0.07722479850053787, -0.004658515565097332, -0.03657818213105202, 0.01310491282492876, 0.02877413108944893, 0.0057768807746469975, -0.006792860571295023, -0.0071148332208395, 0.0360453724861145, -0.007856317795813084, -0.031841911375522614, 0.008504146710038185, -0.019530743