ne\u2019 stickers from each member of staff. ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 21, "split_id": 89, "split_idx_start": 43017, "_split_overlap": [{"doc_id": "f4ff33c8722d05c313fb8f5a0a5a3af8d9dce98f0422b1c0a6601bc62448af8c", "range": [294, 402]}, {"doc_id": "0d58ba4a0173329f99320d82435e02bd1e29968b40d04d9cf10cc0564740f8a0", "range": [0, 140]}]}, "score": null, "embedding": [0.058707039803266525, -0.0828259140253067, -0.019375620409846306, 0.019404450431466103, -0.03011280670762062, 0.03241942822933197, 0.03658764064311981, -0.020259521901607513, -0.076570525765419, -0.0009265721892006695, 0.038370728492736816, -0.02810286357998848, 0.033614855259656906, 0.006773353088647127, 0.0027203219942748547, -0.06046352535486221, 0.007743935566395521, 0.03132030740380287, 0.007048616651445627, 0.025177523493766785, -0.02950342744588852, 0.03173845633864403, 0.011033087968826294, 0.06335729360580444, -0.032039787620306015, -0.07163641601800919, 0.04727515950798988, 0.01193621288985014, 0.01227500382810831, -0.06823712587356567, 0.029954884201288223, -0.027326375246047974, -0.018202275037765503, -0.0073381951078772545, 2.1183864191698376e-06, 0.01572294719517231, 0.029007071629166603, -0.021017642691731453, -0.012192814610898495, 0.019428284838795662, 0.0012543642660602927, 0.045292604714632034, 0.0024694560561329126, 0.05262405797839165, 0.013136135414242744, 0.0037754527293145657, 0.022704435512423515, 0.04683247208595276, 0.0123599823564291, -0.024944474920630455, -0.010314639657735825, -0.001974111422896385, -0.004666206426918507, -0.035144343972206116, 0.1011231541633606, 0.018075518310070038, -0.0261166300624609, -0.03064812906086445, 0.037135057151317596, -0.02864287979900837, -0.020095931366086006, 0.048375483602285385, -0.014058465138077736, -0.