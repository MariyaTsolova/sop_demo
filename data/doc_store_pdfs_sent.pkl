6, -0.027284830808639526, 0.0012520713498815894, 0.024365630000829697, 0.022120309993624687, -0.00017230608500540257, -0.00947656761854887, 0.01656770519912243, 0.026276620104908943, -0.039337579160928726, -0.0360088124871254, 0.019231464713811874, 0.027252109721302986, 0.00271327025257051, 0.04302855208516121, -0.03172452375292778, 0.030287494882941246, -0.040840115398168564, 0.007323044817894697, 0.030850399285554886, -0.07555199414491653, 0.03709477186203003, -0.021327819675207138, 0.09499705582857132, -0.035027630627155304, -0.014430410228669643, 0.009549443610012531, -0.04998216778039932, 0.006936931516975164, -0.011904028244316578, 0.04130672290921211, -0.010033906437456608, -0.007719145622104406, -0.015516609884798527, 0.01971854642033577, 0.031196216121315956, 0.032817501574754715, -0.053275737911462784, 0.01438501663506031, -0.03147115185856819, 0.044543035328388214, -0.053085438907146454, 0.05633822828531265, -0.02710076980292797, -0.026516875252127647, 0.029204336926341057, 0.004218326415866613, -0.011501586064696312, -0.04800476133823395, -0.03704708442091942, 0.0019439258612692356, 1.8699143095338181e-34, 0.00273883412592113, 0.011228041723370552, 0.027101516723632812, -0.06095194071531296, -0.002044695196673274, -0.015920164063572884, 0.013180125504732132, -0.003673878964036703, -0.006617575418204069, -0.030108487233519554, -0.02253388613462448], "sparse_embedding": null}, {"id": "75a1cc2b1a1aeb198e01c7439ae961d9ceb37bdf8576a8563faab50828d6ffe8", "content": "This chunk is part of the AET Schools Standards Framework, specifically under \"Understanding the Individual\" and focuses on Principle Two, which emphasizes the importance of involving autistic pupils in the educational planning process. It outlines methods for documenting evidence and assessing the impact of their contributions on staff, parents/carers, and autistic pupils.We document evidence of working on this standard through case studies, one page profiles, and the goals we co-produce with parents/carers and children (where possible), and by documenting our reasonable adjustments and the impact of those.\nEvidence to show how we meet this standard:\nWhat has been the impact of implementing this standard?\nOn staff:\nOn parents/carers:\nOn autistic pupils:\fSchools Standards Framework20 Understanding the Individual\nPrinciple Two: Enabling the autistic pupil to contribute to and influence decisions.\nStandard Four: We actively involve autistic pupils as part of the \u2018Assess, Plan, Do, Review\u2019 cycle so that the pupil is at the centre of educational planning.\nROOM FOR IMPROVEMENT\nDEVELOPING WE DO THIS REALLY WELL\nExamples of how we can do this:\nWe take on board the perspective of the autistic pupil across the range of activities in which they engage and we consider the preferences of pupils on how they can best be supported in their day-to-day activities and tasks, as well as their social preferences.\n", "dataframe": null, "blob": null, "meta": {"file_path": "aet-schools-standards-framework.pdf", "url": "https://drive.google.com/file/d/166LzAs4UUYY2nmfvEFE7NUcJyEIfBoc3", "source_id": "fd3b04f3804d8efbea64fc291fd78f2aefe37cddffb9972efcc9615a49cfdf8c", "page_number": 19, "split_id": 50, "split_idx_start": 23090, "_split_overlap": [{"doc_id": "1860c6546af48b1738b261fab387085c070ae9152f1d29780f00545663709699", "range": [768, 1008]}, {"doc_id": "1c5f53958f0ed0dbf31b0b64013c8e42ffab8c30573ca726c115cc06a452d7aa", "range": [0, 349]}]}, "score": null, "embedding": [0.018147649243474007, -0.10057337582111359, -0.018035490065813065, -0.0003093211562372744, 0.00783409271389246, 0.03172772750258446, 0.03553654998540878, -0.05130422115325928, -0.05592808872461319, -0.003855139948427677, 0.03548498824238777, -0.06771453469991684, 0.007836111821234226, -0.015975765883922577, 0.00475369393825531, -0.05772765725851059, 0.029022952541708946, 0.016685938462615013, -0.03659294918179512, 0.017034076154232025, -0.004642611835151911, 0.01363233383744955, -0.01426940