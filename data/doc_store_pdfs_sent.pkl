09, 0.037617143243551254, 0.054673049598932266, -0.030283715575933456, -0.011046205647289753, 0.014651130884885788, 0.03718721494078636, 0.011814004741609097, 0.0006281492533162236, -0.0009431359358131886, -0.03709670156240463, -0.01450919546186924, -0.015978699550032616, 0.05794764682650566, 0.013955339789390564, -0.03925752639770508, 0.02261951006948948, 0.0046631875447928905, 0.027571894228458405, -0.028412068262696266, -0.05625798925757408, -0.026624977588653564, 2.2032233220277036e-34, -0.0045993151143193245, 0.019759809598326683, 0.027635982260107994, -0.11848478019237518, -0.004827435128390789, -0.025156170129776, -0.0020099675748497248, 0.008594449609518051, 0.030060119926929474, 0.021480664610862732, -0.04376993328332901], "sparse_embedding": null}, {"id": "48b0a9b2af0dd67d6bfd24bd9c31d894f580585a10bfbb1eec44a0bbc9945b6c", "content": "This chunk is located in the section discussing targeted interventions for pupils with Special Educational Needs and Disabilities (SEND). It emphasizes the importance of accurately identifying pupils' needs to ensure that support is effective and relevant, highlighting the risks of misallocating interventions that could hinder learning progress.\u2022 Does the pupil really need this intervention? Targeted support has the potential to be detrimental if a pupil has been misallocated to an intervention they do not actually need and, as a result, miss out on whole-class activity. \u2022 Do we have a good understanding of pupils\u2019 needs so that the support is well-targeted? Unless interventions are well-matched to address the barriers that pupils are experiencing in their learning, they are unlikely to be effective. For example, knowing that a pupil\u2019s primary need is a specific learning difficulty in literacy is unlikely to be enough to shape an effective intervention. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 32, "split_id": 114, "split_idx_start": 72580, "_split_overlap": [{"doc_id": "51ac52954e40072a71f1f1c6124e535b32345d0f9ce370e7306ada717fdb0313", "range": [608, 656]}, {"doc_id": "9f4e478f61e52212cf722bfe64ca062bb124168addd818c49d5acf159aed306f", "range": [0, 156]}]}, "score": null, "embedding": [0.06346667557954788, -0.14171674847602844, -0.009931904263794422, 0.008789715357124805, -0.03564191609621048, 0.0538509264588356, 0.02809751220047474, -0.028202159330248833, -0.0227781031280756, 0.0018006697064265609, 0.05765010789036751, -0.038361359387636185, 0.03592579811811447, -0.030966218560934067, 0.0039000241085886955, -0.11568597704172134, 0.023018956184387207, 0.02303626388311386, -0.04875365272164345, 0.029343239963054657, -0.010608131065964699, 0.023438557982444763, -0.03165058046579361, -0.004002072848379612, 0.014870239421725273, -0.059528715908527374, 0.015243378467857838, 0.0312630869448185, 0.0005140500143170357, -0.013475888408720493, 0.06100787967443466, 0.021934909746050835, -0.010085388086736202, -0.09058976918458939, 2.0942584342265036e-06, 0.044997163116931915, 0.001603626413270831, -0.015393467620015144, -0.024699939414858818, -0.007953964173793793, -0.021488677710294724, -0.03707262501120567, 0.024423034861683846, 0.04165887087583542, 0.01923065073788166, 0.05207086354494095, 0.01585516147315502, -0.012523708865046501, 0.0012128353118896484, 0.0023408825509250164, 0.0018582034390419722, 0.026577740907669067, -0.04181145504117012, -0.022859469056129456, 0.07657208293676376, -0.00782113429158926, -0.002413499169051647, -0.07608740776777267, 0.04251439869403839, 0.02033000811934471, 0.009574529714882374, 0.05027312785387039, -0.025990677997469902, -0.021793704479932785, 0.014319834299385548, -0.014938730746507645, -0.03620427846908569, -0.08324669301509857, 0.025189002975821495, -0.023069556802511215, 0.108