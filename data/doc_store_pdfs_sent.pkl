relevant include other staff within schools who are responsible for children\u2019s social and emotional development (for example, PSHE coordinators or inclusion leads), local authorities, multi-academy trusts, governors, parents, programme developers, and educational researchers.\n", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Social_and_Emotional_Learning.pdf", "url": "https://drive.google.com/file/d/1ux2ZVY-H62jpu0xzPvuWIaW6mMGtPxRN", "source_id": "e8d637c88ad0e99d399f844be26e40bf15211fc84f01bf87ff947205064caf09", "page_number": 5, "split_id": 9, "split_idx_start": 7185, "_split_overlap": [{"doc_id": "47b6f137b8fed9db72fe0c71469f274fb9c4e3da824e469e6526c161b4eabc97", "range": [529, 663]}, {"doc_id": "e9e4a8e07fd3080e20012f95bf616b3d2d2e6e93fa495ce533501e3207a2ff59", "range": [0, 321]}]}, "score": null, "embedding": [0.070645272731781, -0.09775353968143463, -0.0025065604131668806, 0.014522192999720573, -0.009463204070925713, 0.0601915679872036, 0.050840575248003006, -0.03340885788202286, 0.010096998885273933, -0.011301887221634388, 0.03724028170108795, -0.03821169212460518, 0.03932394087314606, -0.02724468521773815, 0.0223461352288723, -0.06919621676206589, 0.03351302444934845, 0.0545201301574707, -0.009257716126739979, 0.016786031424999237, -0.004964464344084263, 0.015623621642589569, 0.02062206156551838, 0.010746429674327374, 0.0014469403540715575, -0.0035024054814130068, -0.02811901830136776, 0.028252169489860535, -0.013515304774045944, -0.0473465621471405, 0.058738499879837036, 0.020334983244538307, 0.017869457602500916, -0.07009104639291763, 2.3400934878736734e-06, -0.017334314063191414, -0.017283350229263306, 0.009562165476381779, 0.02829729951918125, -0.010600457899272442, 0.021415751427412033, -0.021991470828652382, 0.020866667851805687, 0.022994736209511757, 0.024692650884389877, 0.008712944574654102, 0.03940914571285248, 0.04478759318590164, 0.011949489824473858, 0.0025685285218060017, 0.01258100289851427, -0.03555171936750412, -0.0444797