33, -0.01818622648715973, -0.05594900622963905, 0.08364445716142654, -0.040373481810092926, 0.036062587052583694, 0.00485016917809844, -0.037329766899347305, 0.033299073576927185, -0.02570061758160591, 0.04516591504216194, 0.04078003019094467, -0.029024405404925346, -0.015300936996936798, 0.015091290697455406, 0.0669451355934143, 0.01795901544392109, -0.01497233472764492, 0.03254616633057594, -0.02946760319173336, 0.015639683231711388, -0.04435766115784645, 0.04774579778313637, -0.027492182329297066, -0.04932132363319397, 0.0003096536675002426, 0.013218984007835388, -0.02515816129744053, -0.007112802006304264, -0.044198017567396164, 0.008589215576648712, 1.7590409706391647e-34, 0.016689980402588844, 0.0437522791326046, 0.019561918452382088, -0.06344608217477798, 0.020125772804021835, -0.006833282765001059, -0.06226641684770584, -0.01045923214405775, 0.025733131915330887, -0.007840846665203571, -0.009977367706596851], "sparse_embedding": null}, {"id": "0eea7ace171849b2e1e5d4e228e82addd464171a9708fc3581d6c113747436e7", "content": "This chunk is part of the case study concerning Priestnall Secondary School, highlighting their inclusive practices for autistic students. It specifically discusses Greg, who facilitates peer awareness sessions about autism and illustrates inclusive teaching methods through engaging activities, alongside a discussion about Dr. Rachael King\u2019s role as the school\u2019s educational psychologist.He will talk to the autistic students in the class beforehand and ask them if they want to be involved in the discussions or not. Greg delivers whole school assemblies about heroes in autism like Steven Wiltshire. He shows them a photo of St Paul\u2019s Cathedral for 5 minutes and then covers the photo and asks them to draw it. He then shows Steven\u2019s picture, drawn from memory in all its amazing detail.\nDiscussion with Dr Rachael King: the School\u2019s Educational Psychologist\nRachael is employed part-time by Priestnall School on a term-time only basis. ", "dataframe": null, "blob": null, "meta": {"file_path": "gap-report-case-studies_i-s.pdf", "url": "https://drive.google.com/file/d/1xo_7Q7LxUFHSLjQLhEE8MuxPnqGFEGEo", "source_id": "8bfe7c3cc9a918e195ac64f0cc2adc98cd589bcc8b9655b9f78b69ba9bfddeb0", "page_number": 42, "split_id": 184, "split_idx_start": 93130, "_split_overlap": [{"doc_id": "f76337fc4cf981370a4f409f1f3d99f4a46a38fc1e1a5ba2bc3bc7c641b90a11", "range": [576, 706]}, {"doc_id": "c20ad5f7cdccca81a8a47e5694351e0b0d0c97bd7a50cab9c42436df26730f4e", "range": [0, 149]}]}, "score": null, "embedding": [0.019290374591946602, -0.02692139707505703, -0.028751417994499207, 0.052655428647994995, 0.0019478003960102797, 0.039967313408851624, 0.019583649933338165, -0.07276932895183563, -0.0790170356631279, 0.02413642592728138, 0.03933907672762871, -0.020089641213417053, 0.02229234389960766, -0.03429928049445152, -0.013812213204801083, -0.08674029260873795, 0.0033532173838466406, 0.03884458914399147, -0.07016870379447937, -0.004540126770734787, -0.01917407289147377, 0.015017431229352951, -0.003198077669367194, 0.015984613448381424, 0.029022036120295525, -0.027019815519452095, -0.010404251515865326, 0.04696260020136833, 0.027134478092193604, -0.013805471360683441, -0.02236095815896988, -0.011152192018926144, -0.021709755063056946, 0.0051280055195093155, 2.2738752250006655e-06, 0.04252107813954353, 0.020255785435438156, -0.049183983355760574, 0.01686505600810051, -0.004616361111402512, -0.06568069756031036, 0.0632648766040802, -0.0187221746891737, 0.02720646746456623, -0.012997196055948734, 0.013183975592255592, 0.006174636539071798, 0.050543755292892456, -0.01568237692117691, -0.031606048345565796, 0.004429174587130547, 0.0036335394252091646, -0.012343163602054119, -0.026097357273101807, 0.08722271025180817, -0.0031684068962931633, 0.0049002873711287975, -0.08435143530368805, 0.027287086471915245, 0.04603816941380501, -0.025463271886110306, 0.07427018135786057, -0.014490827918052673, -0.046146783977746964, 0.03