8, 0.05150144547224045, -0.008999406360089779, -0.02506968565285206, -0.006282779388129711, -0.002442906377837062, 0.012654672376811504, 0.036016155034303665, 0.046146176755428314, 0.01315845362842083, -0.018683703616261482, -0.020027577877044678, -0.021630030125379562, -0.035561781376600266, 0.02970440685749054, 0.06066185608506203, -0.007199751678854227, 0.0701831504702568, -0.005998395383358002, 0.014976698905229568, -0.003965006675571203, -0.009402413852512836, 0.017299288883805275, -0.012403946369886398, 0.023887427523732185, -0.008508607745170593, 0.07558503746986389, 0.013246907852590084, -0.0013259107945486903, -0.006808411795645952, -0.0005586066981777549, 0.022266728803515434, -0.002079931553453207, 0.027890002354979515, 0.09700558334589005, -0.030525654554367065, 0.013104405254125595, 0.028126690536737442, 0.02611687034368515, 0.02339647151529789, 0.0062037138268351555, -0.01791882887482643, -0.05036373808979988, -0.014618237502872944, -0.0151712317019701, 0.05556614324450493, -0.037839047610759735, -0.02445080131292343, 0.014625607058405876, -0.014897658489644527, 0.045157916843891144, -0.0047333319671452045, -0.036415085196495056, -0.009868859313428402, 1.9801542130937218e-34, -0.0027849215548485518, -0.025914523750543594, 0.02069953829050064, -0.058439306914806366, -0.014798871241509914, -0.03764234110713005, 0.052538853138685226, 0.013481922447681427, 0.03614082559943199, 0.027421852573752403, -0.03844158351421356], "sparse_embedding": null}, {"id": "43ffbb59bd111c29bf130f00557c48a144d76187634c9a1dd59a9db6b4fdad33", "content": "This chunk is part of the section discussing effective deployment of teaching assistants (TAs) for supporting pupils with Special Educational Needs and Disabilities (SEND). It highlights the findings of studies on ineffective TA practices, clarifying how improper deployment can lead to insufficient educational support and hinder the intended impact on pupil outcomes.Box 13: What does ineffective teaching assistant deployment look like? 44\f35Special Educational Needs in Mainstream Schools\nAdopting an evidence-based approach Before attempting to implement an evidence-\nbased approach to working with TAs, it is useful to understand the impact of an ineffective approach. A series of studies from 2003 to 2017 investigated the typical deployment of TAs in English schools. A striking finding was that the majority of TAs spent most of their time working in a direct, but informal, instructional role with pupils on a small-group or one-to-one basis (both inside and outside of the classroom). TAs were principally working with pupils with SEND or pupils not making expected levels of progress. ", "dataframe": null, "blob": null, "meta": {"file_path": "EEF_Special_Educational_Needs_in_Mainstream_Schools_Guidance_Report.pdf", "url": "https://drive.google.com/file/d/1JdqrM1riD57oBlBO2rxsYWM-BECtkBOI", "source_id": "74ab0c4b037724e2e6a15bac6c92262e5c8cee040eab7233c78628898f0a7eb6", "page_number": 36, "split_id": 130, "split_idx_start": 82335, "_split_overlap": [{"doc_id": "b14d531f4580f7b3ff5bd88fa2562cc327a9bad4892bcdc8d97e60b6bfb3cc61", "range": [396, 467]}, {"doc_id": "1cfe234818ce2497a65149ba5911f5ef781a7e9e6b1cb9049784347fa5867f35", "range": [0, 101]}]}, "score": null, "embedding": [0.05153118446469307, -0.09663072973489761, -0.011504346504807472, -0.0034668543376028538, 0.013164003379642963, 0.0038966210559010506, 0.05603685602545738, -0.0713140070438385, -0.032119445502758026, 0.001557091367430985, 0.0640915185213089, -0.001125190407037735, 0.03259584307670593, -0.016537418588995934, 0.030245181173086166, -0.10140468180179596, -0.013852900825440884, 0.023181552067399025, -0.06088392063975334, 0.01894933357834816, 0.006111388094723225, 0.006774457171559334, -0.00307375262491405, 0.022780444473028183, -0.00033537918352521956, -0.034250568598508835, 0.004002314992249012, -0.00030488736229017377, 0.0464010126888752, 0.023180615156888962, 0.03894836828112602, 0.012177843600511551, -0.00622923066839575