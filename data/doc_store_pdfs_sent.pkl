, 0.04056667909026146, 0.032084617763757706, -0.02317700907588005, -0.029546046629548073, 0.045778051018714905, -0.029627962037920952, 0.026231443509459496, 0.018333543092012405, 0.001067275064997375, 0.0454273521900177, 0.03551054373383522, -0.02614680491387844, -0.02388771064579487, -0.0019540484063327312, 0.008318415842950344, -0.08561895042657852, -0.038616031408309937, 0.023745335638523102, 0.03402407094836235, -0.03355143591761589, 0.056110989302396774, -0.008318820036947727, 0.028740543872117996, -0.015214828774333, -0.02239854447543621, 0.009814632125198841, -0.06270674616098404, 0.04485461860895157, -0.05242440849542618, 0.05605420097708702, -0.01243632659316063, 0.010724720545113087, 0.017100194469094276, 0.005029912572354078, 0.029565909877419472, -0.0035269535146653652, 0.035397969186306, 0.024191036820411682, -0.021819625049829483, 0.005979373585432768, 0.016339974477887154, 0.01643310859799385, 0.046177975833415985, -0.03947369009256363, -0.0019396587740629911, -0.03486684709787369, -0.0039172181859612465, -0.040417883545160294, 0.06969502568244934, -0.00956886075437069, -0.01013422105461359, 0.002892055781558156, -0.002816218649968505, -0.007225960027426481, -0.05308302491903305, -0.037379417568445206, -0.0006875079125165939, 1.7490605185054547e-34, -0.025247668847441673, 0.008559153415262699, 0.03183380514383316, -0.05123790726065636, -0.0009011667571030557, -0.0014587384648621082, 0.0297520961612463, 0.019967490807175636, -0.011295023374259472, -0.029155030846595764, -0.015360337682068348], "sparse_embedding": null}, {"id": "faeba5eafb5199cb925cc3ad1d9e22b562e106dacc4e4c5c24d873e22c7fc6f1", "content": "This chunk is part of the AET Post-16 Standards Framework, specifically under the theme of \"Understanding the learner.\" It addresses Standard One, which focuses on supporting autistic learners' self-advocacy and utilizing person-centred approaches to acknowledge their unique strengths, needs, and the importance of understanding diverse experiences of autism, including gender considerations.Link to statutory framework\nStandard One: We support the autistic learner to self-advocate and share information that is important to them, and we work with them to identify the right tools to do so.\nWe work in partnership with the autistic learner and their circles of support to identify how they learn most effectively. The voice of the autistic learner is central to this.\nWe use person-centred approaches to gather information on the strengths, and differences of each individual autistic learner in the areas of social understanding and communication; flexibility, information processing, and understanding; and sensory processing and integration.\nWe are aware that autism has traditionally been viewed as a male condition, but that many autistic girls and women are being diagnosed later in life, are misdiagnosed, or their differences are missed. ", "dataframe": null, "blob": null, "meta": {"file_path": "Post-16-Standards-Framework_T-HUB-Sc-Mt (1).pdf", "url": "https://drive.google.com/file/d/1J2sZ87itIDhKcF_wmZN2TcBeZRLjlMJP", "source_id": "8c4c774884107306cf77966fe0ff24690d0139f6223da0babe2c1bcd4b2a95b5", "page_number": 14, "split_id": 38, "split_idx_start": 18835, "_split_overlap": [{"doc_id": "89fcd27cd199a66283f03372f6404c3b33d6959ce67e49514ddfa0e3f3ff5ad8", "range": [754, 954]}, {"doc_id": "a159b3f13c99c6374212d50cd6b70b6b0d36be1e75b93672d3e7ebdfd4ad4d0b", "range": [0, 201]}]}, "score": null, "embedding": [0.028600793331861496, -0.09488361328840256, -0.021353956311941147, 0.023788614198565483, 0.015756992623209953, 0.03586689755320549, 0.0451003834605217, -0.060964927077293396, -0.050244733691215515, -0.013487759977579117, 0.02559692971408367, -0.1040145605802536, 0.02120538428425789, -0.033327408134937286, 0.013990484178066254, -0.04845169186592102, 0.02711079828441143, 0.03670892491936684, 0.006628431845456362, 0.011417440138757229, 0.028523242101073265, 0.03117896057665348, -0.01056242547929287, 0.04540310800075531,