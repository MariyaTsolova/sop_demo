pirations.\nS4. ", "dataframe": null, "blob": null, "meta": {"file_path": "aet-schools-standards-framework.pdf", "url": "https://drive.google.com/file/d/166LzAs4UUYY2nmfvEFE7NUcJyEIfBoc3", "source_id": "fd3b04f3804d8efbea64fc291fd78f2aefe37cddffb9972efcc9615a49cfdf8c", "page_number": 8, "split_id": 19, "split_idx_start": 9545, "_split_overlap": [{"doc_id": "dc5a5d6faeecdb0414ffb3e868ca3864b81fffd7840a170a3573935e0686ef11", "range": [404, 553]}, {"doc_id": "a0b56b8db68714f38adcc5de58564f6643244d4f9ca2d0f57b0a238a53ee2715", "range": [0, 4]}]}, "score": null, "embedding": [0.03989489749073982, -0.08072661608457565, -0.008343381807208061, -0.02845918945968151, 0.013171696104109287, 0.02376118302345276, 0.007062725722789764, -0.045666277408599854, -0.060285747051239014, 0.016589421778917313, 0.03157525137066841, -0.07606128603219986, -0.02211153507232666, -0.011483229696750641, -0.006065626163035631, -0.03882725164294243, 0.020944541320204735, 0.0006879476131871343, -0.009160059504210949, 0.01694987528026104, 0.002999665215611458, 0.019457781687378883, -0.01678679883480072, 0.047999974340200424, 0.02042953297495842, -0.034091606736183167, 0.030320679768919945, 0.006282225716859102, 0.024590494111180305, -0.031904637813568115, 0.04240221902728081, 0.0250668004155159, -0.0030106587801128626, 0.015468469820916653, 2.206229964940576e-06, 0.0037791994400322437, 0.023211192339658737, -0.04237917438149452, -0.04486939311027527, 0.002054076176136732, -0.06972955167293549, 0.026655472815036774, 0.04943659156560898, 0.05840592831373215, -0.04250657930970192, -0.015586965717375278, 0.01350798737257719, 0.03679826483130455, -0.0035780121106654406, -0.016060225665569305, -0.006433721166104078, 0.03237751126289368, 0.021046647801995277, -0.05145750194787979, 0.001243776292540133, -0.02429143898189068, 0.01549475360661745, -0.08449561893939972, 0.01186350453644991, 0.05971287935972214, -0.012127449735999107, 0.007375683169811964, -0.016268474981188774, -0.06465351581573486, 0.012813312